		local cv = ct:FindFirstChild(cu) or ct:FindFirstChild(string.lower(cu)) or (cu == 'SwimIdle' and (ct:FindFirstChild('swimidle') or ct:FindFirstChild('SwimIdle'))) or (cu == 'Swim' and (ct:FindFirstChild('swim') or ct:FindFirstChild('Swim')))
