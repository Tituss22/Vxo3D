	cj.getCatalogWearRemotes = function ()
		if not cj.IS_CATALOG_AVATAR_CREATOR then
			return nil, nil
		end
		if not cj.CATALOG_EVENTS or not cj.CATALOG_EVENTS.Parent then
			cj.CATALOG_EVENTS = cj.ReplicatedStorage:FindFirstChild('Events')
		end
		cj.CATALOG_GUI_REMOTE = cj.CATALOG_EVENTS and cj.CATALOG_EVENTS:FindFirstChild('CatalogGuiRemote')
		cj.SAVED_OUTFITS_REMOTE = cj.CATALOG_EVENTS and cj.CATALOG_EVENTS:FindFirstChild('SavedOutfitsRemote')
		return cj.CATALOG_GUI_REMOTE, cj.SAVED_OUTFITS_REMOTE
	end
	cj.wearAvatarThroughCatalog = function (ct)
		if not cj.IS_CATALOG_AVATAR_CREATOR then
			return false, 'Not in Catalog Avatar Creator.'
		end
		if not ct or type(ct.Properties) ~= 'table' then
			return false, 'Avatar has no saved properties.'
		end
		local cu = cj.getCatalogWearRemotes()
		if not cu then
			return false, 'CatalogGuiRemote was not found.'
		end
		local cv = (tostring(ct.RigType):find('R6') and Enum.HumanoidRigType.R6) or Enum.HumanoidRigType.R15
		local cw = {}
		for cx, cy in pairs(ct.Properties) do
			if cx ~= 'Emotes' and cx ~= 'EquippedEmotes' and cx ~= 'AllAccessories' then
				cw[cx] = cy
			end
		end
		local cx = {Properties = cw, Action = 'CreateAndWearHumanoidDescription', RigType = cv}
		local cy, cz = pcall(function ()
			return cu:InvokeServer(cx)
		end)
		if not cy then
			return false, tostring(cz)
		end
		return true, cz
	end
	cj.saveAvatarToCatalogOutfit = function (ct)
		if not cj.IS_CATALOG_AVATAR_CREATOR then
			return false, 'Not in Catalog Avatar Creator.'
		end
		if not ct or not ct.Properties then
			return false, 'Avatar has no saved properties.'
		end
