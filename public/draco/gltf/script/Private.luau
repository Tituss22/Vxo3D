					end
				end
			end
		end)
		local cy = {WalkAnimation = ct.WalkAnimation or 0, MoodAnimation = ct.MoodAnimation or 0, ClimbAnimation = ct.ClimbAnimation or 0, FallAnimation = ct.FallAnimation or 0, RunAnimation = ct.RunAnimation or 0, SwimAnimation = ct.SwimAnimation or 0, IdleAnimation = ct.IdleAnimation or 0, JumpAnimation = ct.JumpAnimation or 0, Face = ct.Face or 0, Shirt = ct.Shirt or 0, Pants = ct.Pants or 0, GraphicTShirt = ct.GraphicTShirt or 0, RightArmColor = cj.rgbForSave(ct.RightArmColor), TorsoColor = cj.rgbForSave(ct.TorsoColor), RightLegColor = cj.rgbForSave(ct.RightLegColor), LeftLegColor = cj.rgbForSave(ct.LeftLegColor), LeftArmColor = cj.rgbForSave(ct.LeftArmColor), HeadColor = cj.rgbForSave(ct.HeadColor), Head = ct.Head or 0, Torso = ct.Torso or 0, LeftArm = ct.LeftArm or 0, RightArm = ct.RightArm or 0, LeftLeg = ct.LeftLeg or 0, RightLeg = ct.RightLeg or 0, HeadShape = cj.getSavedHeadShape(ct), MakeupItems = cj.getSavedMakeups(ct), ProportionScale = ct.ProportionScale or 0, DepthScale = ct.DepthScale or 1, HeightScale = ct.HeightScale or 1, WidthScale = ct.WidthScale or 1, BodyTypeScale = ct.BodyTypeScale or 0, HeadScale = ct.HeadScale or 1, LayeredAccessories = cj.getSavedLayeredAccessories(ct), AccessoryRefinements = cj.getSavedAccessoryRefinements(ct, cu), StaticFacialAnimation = false}
		for cz, cA in ipairs(cv) do
			cy[cA] = table.concat(cw[cA], ',')
		end
		pcall(function ()
			cy.StaticFacialAnimation = ct.StaticFacialAnimation == true
		end)
		pcall(function ()
			local cz = {}
			for cA, cB in ipairs(ct:GetAccessories(true)) do
				local cC = {AssetId = cB.AssetId, AccessoryType = cB.AccessoryType and cB.AccessoryType.Name or 'Unknown', IsLayered = cB.IsLayered == true}
				if cB.Order ~= nil then
					cC.Order = cB.Order
				end
				if cB.Puffiness ~= nil then
					cC.Puffiness = cB.Puffiness
				end
				cz[#cz + 1] = cC
			end
			cy.AllAccessories = cz
