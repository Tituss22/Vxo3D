				cx = cj.buildPreviewTemplate(cu, cw)
			end
			if cx then
				local cC = nil
				local cD = pcall(function ()
					cC = cx:Clone()
				end)
				if cD and cC then
					cC.Parent = cA
					cC:PivotTo(CFrame.new(0, 0, 0))
					task.wait()
					if cC.Parent == cA and cC:FindFirstChildOfClass('Humanoid') then
						local cE, cF = cC:GetBoundingBox()
						local cG = cE.Position + Vector3.new(0, cF.Y * 0.03, 0)
						local cH = math.max(cF.X, cF.Y, cF.Z) * cj.previewCameraDistanceMultiplier
						cB.FieldOfView = 35
						cB.CFrame = CFrame.lookAt(cG + Vector3.new(0, cF.Y * 0.02, cH), cG)
						return true
					end
					pcall(function ()
						cC:Destroy()
					end)
				end
			end
			pcall(function ()
				cz:Destroy()
			end)
			if cy < 3 then
				task.wait(0.12 * cy)
			end
		end
		return false
	end
	cj.processPreviewQueue = function ()
