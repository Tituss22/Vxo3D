	cj.loadSavedAvatars = function ()
		local ct = cj.ui.selectedAvatar and cj.ui.selectedAvatar.Signature
		local cu = cj.ui.selectedAvatar and cj.ui.selectedAvatar.Name
		table.clear(cj.ui.savedAvatars)
		if type(readfile) ~= 'function' or type(isfile) ~= 'function' then
			cj.Status.Text = '[!] File API unavailable.'
			return false
		end
		local cv = 0
		for cw, cx in ipairs(cj.readAvatarFiles()) do
			cj.ui.savedAvatars[#cj.ui.savedAvatars + 1] = cx
			cv = cv + 1
		end
		local cw = T('legacyAvatars', nil)
		local cx = nil
		if type(cw) == 'table' then
			cx = cw
		else
			local cy, cz = pcall(isfile, cj.FILE_PATH)
			if cy and cz then
				local cA, cB = pcall(function ()
					return cj.HttpService:JSONDecode(readfile(cj.FILE_PATH))
				end)
				if cA and type(cB) == 'table' then
					cx = cB
				end
			end
		end
		if cx then
			local cy = cx
			for cz, cA in ipairs(cy) do
				if type(cA) == 'table' and type(cA.Properties) == 'table' then
					local cB = false
					if cA.Signature then
						for cC, cD in ipairs(cj.ui.savedAvatars) do
							if cD.Signature == cA.Signature then
								cB = true
								break
							end
						end
					end
					if not cB then
						cA.Source = 'legacy'
						cA.FileName = cA.FileName or 'SavedAvatars.json'
						cj.ui.savedAvatars[#cj.ui.savedAvatars + 1] = cA
						cv = cv + 1
					end
				end
			end
			if cw == nil then
				U('legacyAvatars', cx)
			end
		end
		if ct or cu then
			cj.ui.selectedAvatar = nil
			for cy, cz in ipairs(cj.ui.savedAvatars) do
				if (ct and cz.Signature == ct) or (not ct and cu and cz.Name == cu) then
					cj.ui.selectedAvatar = cz
					break
				end
			end
		end
		cj.Status.Text = '[File] ' .. tostring(cv) .. ' avatar(s) loaded.'
		cj.clearDiagnostics()
		return true
	end
