		local function fE(fF)
			fF = ef.min(fF, 0.1)
			ev.t = ev.t + fF
			ev.frame = ev.frame + 1
			local fG = workspace.CurrentCamera
			if fG then
				ev.camPos = fG.CFrame.Position
				ev.look = fG.CFrame.LookVector
				local fH = fG.ViewportSize
				local fI = ef.tan(ef.rad(fG.FieldOfView) * 0.5)
				local fJ = fI * fH.X / ef.max(fH.Y, 1)
				ev.cullCos = ef.cos(ef.min(ef.atan(el(fI * fI + fJ * fJ)) + 0.15, 1.55))
			end
			local fH = ey()
			if not fH then
				return
			end
			ev.focus = fH
			ev.fps = es(ev.fps or 60, 1 / ef.max(fF, 1 / 240), et(fF, 2))
			if not ev.anchor or (ev.anchor - fH).Magnitude > 150 then
				ev.anchor = fH
			end
			ev.anchor = ev.anchor:Lerp(fH, et(fF, 0.35))
			if ev.groundY then
				ev.groundYs = ev.groundYs and es(ev.groundYs, ev.groundY, et(fF, 0.5)) or ev.groundY
			end
			ev.rays = ev.rayBudget[dZ.mq.eff] or 14
			ev.acc = ev.acc + fF
			if ev.acc >= 0.5 then
				ev.acc = 0
				ex()
				local fI = cn:GetSunDirection().Y
				local fJ = ef.deg(ef.asin(ek(fI, -1, 1)))
				ev.night = er((2 - fJ) / 8)
				ev.rain = (dZ and tonumber(dZ.stormK)) or 0
				local fK = dZ and dZ.wind
				if fK and fK.direction then
					ev.windDir = ep(fK.direction.X, 0, fK.direction.Z)
				end
				ev.windStr = (fK and fK.strength or 0.014) * ((fK and fK.enabled) and 1 or 0.7)
				local fL = ez(fH + ep(0, 2, 0), ep(0, -80, 0))
				local fM = fL and fL.Position.Y or (ev.groundY or (fH.Y - 3))
				ev.groundY = ev.groundY and es(ev.groundY, fM, 0.5) or fM
			end
			ev.bn = 0
			for fI, fJ in ipairs(ev.mods) do
				if fJ.on then
					local fK, fL = pcall(fJ.step, fF)
					if not fK and not fJ.warned then
						fJ.warned = true
						warn('[JEYHUB] 3D VFX ' .. fJ.name .. ':', fL)
					end
				end
			end
			do
				local fK, fL = pcall(WLS.tick, fF)
				if not fK and not WLS.warned then
					WLS.warned = true
					warn('[JEYHUB] 3D VFX Wildlife Shadows:', fL)
				end
			end
