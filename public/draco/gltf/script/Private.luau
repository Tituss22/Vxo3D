		local cv = cu and cu:FindFirstChildOfClass('Humanoid')
		if not cu or not cu.Parent or not cv then
			return false, 'Your character is not available.'
		end
		if cv.RigType ~= Enum.HumanoidRigType.R6 then
			return false, 'R15 uses the normal local try-on path.'
		end
		if not ct or not ct.Properties then
			return false, 'The selected avatar has no saved properties.'
		end
		cj.placeholderR6Building = true
		cj.placeholderR6Backup = cj.capturePlaceholderR6Backup(cu)
		if not cj.placeholderR6Backup then
			cj.placeholderR6Building = false
			return false, 'Could not back up your current R6 appearance.'
		end
		local cw = cj.reconstructHumanoidDescription(ct.Properties)
		local cx, cy = pcall(function ()
			return cj.Players:CreateHumanoidModelFromDescriptionAsync(cw, Enum.HumanoidRigType.R6)
		end)
		pcall(function ()
			cw:Destroy()
		end)
		if not cx or not cy or not cy:IsA('Model') then
			cj.restorePlaceholderR6()
			return false, tostring(cy)
		end
		local cz = cy
		local cA, cB = xpcall(function ()
			cj.clearPlaceholderR6Appearance(cu)
			local cA = {Head = cu:FindFirstChild('Head'), Torso = cu:FindFirstChild('Torso'), ['Left Arm'] = cu:FindFirstChild('Left Arm'), ['Right Arm'] = cu:FindFirstChild('Right Arm'), ['Left Leg'] = cu:FindFirstChild('Left Leg'), ['Right Leg'] = cu:FindFirstChild('Right Leg')}
			for cB, cC in ipairs(cz:GetChildren()) do
				if cC:IsA('Accessory') then
					local cD = cC:Clone()
					local cE = cD:FindFirstChild('Handle')
					if cE then
						cE.Anchored = false
						cE.CanCollide = false
						cE.CanTouch = false
						cE.CanQuery = false
						cE.Massless = true
						local cF = cE:FindFirstChildWhichIsA('Attachment')
						local cG = cF and cu:FindFirstChild(cF.Name, true)
						local cH = cG and cG.Parent:IsA('BasePart') and cG.Parent or cA.Head or cA.Torso
						if cG and cG.Parent:IsA('BasePart') then
							cE.CFrame = cG.WorldCFrame * cF.CFrame:Inverse()
						elseif cF and cH then
							cE.CFrame = cH.CFrame * CFrame.new(cF.Position)
						elseif cH then
							cE.CFrame = cH.CFrame
						end
						if cH then
							local cI = Instance.new('WeldConstraint')
							cI.Part0 = cE
							cI.Part1 = cH
							cI.Parent = cE
						end
						for cI, cJ in ipairs(cD:GetDescendants()) do
							if cJ:IsA('BasePart') and cJ ~= cE then
								cJ.CanCollide = false
								cJ.CanTouch = false
								cJ.CanQuery = false
								cJ.Massless = true
								if cH then
									local cK = Instance.new('WeldConstraint')
									cK.Part0 = cJ
									cK.Part1 = cE
									cK.Parent = cJ
								end
							end
						end
						cD.Parent = cu
					else
						cD:Destroy()
					end
				elseif cC:IsA('Shirt') or cC:IsA('Pants') or cC:IsA('ShirtGraphic') or cC:IsA('BodyColors') or cC:IsA('CharacterMesh') then
					cC:Clone().Parent = cu
				end
			end
			for cB, cC in ipairs({'Head', 'Torso', 'Left Arm', 'Right Arm', 'Left Leg', 'Right Leg'}) do
				local cD, cE = cz:FindFirstChild(cC), cu:FindFirstChild(cC)
				if cD and cE and cD:IsA('BasePart') and cE:IsA('BasePart') then
					cE.Color = cD.Color
					cE.Material = cD.Material
				end
			end
			local cB, cC = cz:FindFirstChild('Head'), cu:FindFirstChild('Head')
			if cB and cC then
				for cD, cE in ipairs(cB:GetChildren()) do
					if cE:IsA('SpecialMesh') or cE:IsA('Mesh') or cE:IsA('Decal') then
						cE:Clone().Parent = cC
					end
				end
			end
		end, debug.traceback)
		pcall(function ()
			cz:Destroy()
		end)
		if not cA then
			cj.restorePlaceholderR6()
			return false, tostring(cB)
		end
		cj.placeholderR6Building = false
		cj.placeholderR6Active = true
		return true
	end
