			end
		end
		local function isTag(bb, plr)
			local n1, n2 = string.lower(plr.Name), string.lower(plr.DisplayName)
			for _k, d in ipairs(bb:GetDescendants()) do
				if d:IsA('TextLabel') or d:IsA('TextButton') or d:IsA('TextBox') then
					local t = string.lower(tostring(d.Text))
					if t ~= '' and (string.find(t, n1, 1, true) or string.find(t, n2, 1, true)) then
						return true
					end
				end
			end
			local nm = string.lower(bb.Name)
			return string.find(nm, 'name', 1, true) ~= nil or string.find(nm, 'tag', 1, true) ~= nil or string.find(nm, 'overhead', 1, true) ~= nil
