			for fL = fK + 1, ev.blast do
				fI[fL] = nil
				fJ[fL] = nil
			end
			ev.blast = fK
			if fK > 0 and not pcall(workspace.BulkMoveTo, workspace, fI, fJ, Enum.BulkMoveMode.FireCFrameChanged) then
				for fL = 1, fK do
					local fM = fI[fL]
					if fM and fM.Parent then
						fM.CFrame = fJ[fL]
					end
				end
			end
		end
