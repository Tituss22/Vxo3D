	cj.deleteAvatar = function (ct)
		if not ct then
			return
		end
		if ct.Source == 'legacy' then
			if type(writefile) ~= 'function' then
				cj.showDiagnostics('Cannot delete avatar.', 'The executor does not provide writefile().')
				return
			end
			local cu = {}
			local cv = false
			for cw, cx in ipairs(cj.ui.savedAvatars) do
				if cx == ct then
					cv = true
				else
					cu[#cu + 1] = cx
				end
			end
			if not cv then
				return
			end
			local cw, cx = pcall(function ()
				local cw = {}
				for cx, cy in ipairs(cu) do
					if cy.Source == 'legacy' then
						local cz = {}
						for cA, cB in pairs(cy) do
							if cA ~= 'Source' and cA ~= 'FilePath' and not (cA == 'FileName' and cB == 'SavedAvatars.json') then
								cz[cA] = cB
							end
						end
						cw[#cw + 1] = cz
					end
				end
				U('legacyAvatars', cw)
			end)
			if not cw then
				cj.showDiagnostics('Failed to delete avatar.', tostring(cx))
				return
			end
			cj.ui.savedAvatars = cu
			if cj.ui.selectedAvatar == ct then
				cj.ui.selectedAvatar = nil
			end
			cj.Status.Text = '[OK] Deleted legacy avatar: ' .. tostring(ct.DisplayName or ct.Name or 'avatar')
			cj.StatusDot.BackgroundColor3 = cj.COLORS.Success
			cj.clearDiagnostics()
			cj.populateAvatarList()
			return
		end
		local cu = ct.FilePath
		if not cu and ct.FileName then
			cu = cj.AVATARS_FOLDER .. '/' .. tostring(ct.FileName)
		end
		if not cu or type(delfile) ~= 'function' then
			cj.showDiagnostics('Cannot delete avatar.', 'The executor does not provide delfile().')
			return
		end
		local cv, cw = pcall(function ()
			delfile(cu)
		end)
		if not cv then
			cj.showDiagnostics('Failed to delete avatar.', tostring(cw))
			return
		end
		for cx = #cj.ui.savedAvatars, 1, -1 do
			if cj.ui.savedAvatars[cx] == ct then
				table.remove(cj.ui.savedAvatars, cx)
				break
			end
		end
		if cj.ui.selectedAvatar == ct then
			cj.ui.selectedAvatar = nil
		end
		cj.Status.Text = '[OK] Deleted: ' .. tostring(ct.DisplayName or ct.Name or 'avatar')
