			end
		end
		local eL = 0
		for eM, eN in ipairs(eI) do
			if not ch._nameCache[eN] and eL < 30 then
				eL = eL + 1
				local eO = b6('https://users.roblox.com/v1/users/' .. tostring(eN))
				if eO then
