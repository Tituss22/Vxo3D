		end
		return true, cz, cB
	end
	cj.notifyCatalogAvatarCreator()
	cj.buildSavedAvatarDataFromUsername = function (ct)
		ct = tostring(ct or ''):gsub('^%s+', ''):gsub('%s+$', '')
		ct = ct:gsub('^@', '')
		if ct == '' then
			return nil, 'Enter a Roblox username first.'
		end
		local cu, cv = pcall(function ()
			return cj.Players:GetUserIdFromNameAsync(ct)
		end)
		if not cu or not cv then
			return nil, 'Could not find Roblox user @' .. ct .. '.'
		end
		local cw = nil
		local cx, cy = pcall(function ()
			if type(cj.Players.GetHumanoidDescriptionFromUserIdAsync) == 'function' then
				return cj.Players:GetHumanoidDescriptionFromUserIdAsync(cv)
			end
			return cj.Players:GetHumanoidDescriptionFromUserId(cv)
		end)
		if not cx or not cy then
			return nil, 'Could not load the profile avatar for @' .. ct .. '.'
		end
		cw = cy
		local cz = cj.createCopiedProperties(cw, nil)
		if type(cz) ~= 'table' then
			return nil, 'Could not serialize the profile avatar for @' .. ct .. '.'
		end
		local cA = cj.LocalPlayer.Character and cj.LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
		local cB = cA and cA.RigType or Enum.HumanoidRigType.R6
		local cC = ct
		pcall(function ()
			local cD = cj.Players:GetPlayerByUserId(cv)
			if cD then
				cC = cD.DisplayName
			end
		end)
		local cD = {Name = ct, Username = ct, UserId = cv, DisplayName = cC, Properties = cz, RigType = (cB == Enum.HumanoidRigType.R6) and 'R6' or 'R15', Signature = cj.getAvatarSignature(cz, cB), Order = 1}
		return cD
	end
	cj.findExactSavedAvatarMatch = function (ct)
		if type(ct) ~= 'table' then
			return nil
		end
		local cu = ct.Signature
		if not cu and ct.Properties then
			cu = cj.getAvatarSignature(ct.Properties, ct.RigType or 'R6')
		end
		for cv, cw in ipairs(cj.ui.savedAvatars or {}) do
			local cx = cw.Signature
			if not cx and cw.Properties then
				cx = cj.getAvatarSignature(cw.Properties, cw.RigType or 'R6')
				cw.Signature = cx
			end
			if cu and cx and cu == cx then
				return cw
			end
		end
		return nil
	end
	cj.saveAndWearUsernameAvatar = function (ct)
		local cu = tostring(ct or ''):gsub('^%s+', ''):gsub('%s+$', '')
		cu = cu:gsub('^@', '')
		if cu == '' then
			return false, 'Enter a Roblox username first.'
		end
		if cj.ui.selectingPlayer then
			cj.stopPlayerSelection()
		end
		if cj.tryOnActive or cj.localTryOnModel or cj.localTryOnBuilding or cj.placeholderR6Active then
			cj.tryOnActive = false
			cj.stopLocalTryOn(false)
		end
		cj.ui.selectedAvatar = nil
		cj.updateRowVisuals(nil)
		local cv, cw = cj.buildSavedAvatarDataFromUsername(cu)
		if not cv then
			return false, cw
		end
		local cx = cj.findExactSavedAvatarMatch(cv)
		if cx then
			cv = cx
			cj.ui.selectedAvatar = cv
			cj.populateAvatarList()
			cj.updateRowVisuals(cv)
			if cj.IS_CATALOG_AVATAR_CREATOR then
				local cy, cz = cj.wearAvatarThroughCatalog(cv)
				if not cy then
					cj.showDiagnostics('Existing avatar could not be equipped.', tostring(cz))
					return false, cz
				end
				cj.Status.Text = ('[FE] Already saved ' .. string.char(226, 128, 148) .. ' equipped existing avatar: ') .. tostring(cv.Name or cv.Username or cu)
			else
				cj.Status.Text = ('[OK] Already saved ' .. string.char(226, 128, 148) .. ' equipped existing avatar: ') .. tostring(cv.Name or cv.Username or cu)
				task.defer(function ()
					if cj.scriptAlive and cj.ui.selectedAvatar == cv then
						cj.tryOnSelectedAvatarLocally()
					end
				end)
			end
			cj.clearDiagnostics()
			return true, cv
		end
		local cy = cv.Source ~= 'ava' or not cv.FilePath
		if cy then
			local cz, cA = cj.writeAvatarFile(cv)
			if not cz then
				return false, cA
			end
			cv.FilePath = cA
			cv.FileName = tostring(cA):match('([^/\\]+)$') or cA
			cv.Source = 'ava'
			cj.ui.savedAvatars = cj.ui.savedAvatars or {}
			table.insert(cj.ui.savedAvatars, 1, cv)
		end
		cj.ui.selectedAvatar = cv
		cj.populateAvatarList()
		cj.updateRowVisuals(cv)
		if cj.IS_CATALOG_AVATAR_CREATOR then
			local cz, cA, cB = cj.saveAvatarToCatalogOutfit(cv)
			if not cz then
				cj.showDiagnostics('CAC avatar save/wear failed.', tostring(cB))
				return false, cB
			end
			cj.Status.Text = '[FE] Wore @' .. cu .. ' and saved to Saved Outfits as ' .. tostring(cA)
			cj.clearDiagnostics()
			return true, cv
		end
