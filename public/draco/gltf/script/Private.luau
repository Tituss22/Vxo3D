		local function aoReconcile(camPos)
			local q = Q()
			local list = PB.aoNext or {}
			PB.aoNext = nil
			local want = {}
			if PB.ao and PB.aoStr > 0 then
				for _, e in ipairs(list) do
					local to = camPos - e.cf.Position
					local facing = e.cf.UpVector:Dot(to) > 0 and 1 or 0.05
					e.pri = e.peak * facing / (1 + to.Magnitude / 18)
				end
				table.sort(list, function (a, b)
					return a.pri > b.pri
				end)
				local n, casts = 0, 0
				local gg = math.floor(q.aoMax * aoDistK() + 0.5)
				for _, e in ipairs(list) do
					if n >= gg then
						break
					end
					if e.pri > 0.004 and not (e.cast and casts >= q.castMax) then
						local cur = want[e.key]
						if not cur then
							want[e.key] = e
							n = n + 1
							if e.cast then
								casts = casts + 1
							end
						elseif (e.src or 0) < (cur.src or 0) then
							want[e.key] = e
						end
					end
				end
			end
			for key, o in pairs(PB.aoPatches) do
				local e = want[key]
				if e then
					o.target = 1
					if o.e ~= e then
						o.e, o.place = e, true
					end
					want[key] = nil
				else
					o.target = 0
				end
			end
			local pend = {}
			for _, e in pairs(want) do
				pend[#pend + 1] = e
			end
			table.sort(pend, function (a, b)
				return a.pri > b.pri
			end)
			PB.aoPending = pend
		end
		local function similarShape(a, b)
			if a.kind ~= b.kind or a.round ~= b.round or (a.cast and true) ~= (b.cast and true) or (a.band and true) ~= (b.band and true) then
				return false
			end
			local function near(x, y)
				return math.abs(x - y) <= 0.5 * math.max(x, y) + 0.3
			end
			return near(a.W, b.W) and near(a.D, b.D) and near(a.xmax, b.xmax) and (a.cf.Position - b.cf.Position).Magnitude <= 0.5 * (b.W + b.D) + 2
		end
		local function aoTick(camPos, dt, now)
			local gf = Q()
			SB.budget = 96
			local queue = PB.aoQueue
			if queue then
				local solved, meshes = 0, 0
				local sunShare, sunDir = nil, PB.env.dir
				while PB.aoQi <= #queue and solved < gf.aoPer do
					local p = queue[PB.aoQi]
					local alive = p.Parent ~= nil
					local c = alive and PB.aoCache[p] or nil
					local pos, size, rest = nil
					local fresh = false
					if alive then
						rest = swayOf(p)
						pos, size = rest and rest.Position or p.Position, p.Size
						fresh = c ~= nil and (c.pos - pos).Magnitude < 0.05 and c.size == size and now < c.t and (c.sun - sunDir).Magnitude < (c.cast and 0.035 or 0.12) and c.sway == (rest ~= nil)
					end
					local mesh = alive and not fresh and not p:IsA('Part')
					if mesh and meshes >= 1 then
						break
					end
					PB.aoQi = PB.aoQi + 1
					if alive then
						if not fresh then
							sunShare = sunShare or eD()
							local ok, res = pcall(aoCompute, p, sunShare)
							local list = ok and res or {}
							local hasCast = false
							for _, e in ipairs(list) do
								if e.cast then
									hasCast = true
									break
								end
							end
							c = {pos = pos, size = size, sun = sunDir, t = now + 40 + math.random() * 20, list = list, cast = hasCast, sway = rest ~= nil}
							PB.aoCache[p] = c
							solved = solved + 1
							if mesh then
								meshes = meshes + 1
							end
						end
						for _, e in ipairs(c.list) do
							PB.aoNext[#PB.aoNext + 1] = e
