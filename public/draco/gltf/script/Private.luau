				local inst = hit.Instance
				if inst:IsA('Terrain') or PB.seeT(inst) < 0.6 then
					return hit
				end
				local left = dir.Magnitude - (hit.Position - from).Magnitude - 0.05
				if left <= 0 then
					return nil
				end
				local u = dir.Unit
				from, dir = hit.Position + u * 0.05, u * left
				hit = workspace:Raycast(from, dir, PB.sp)
			end
			return hit
		end
