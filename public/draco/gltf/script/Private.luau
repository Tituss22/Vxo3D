		cv = string.match(cv, '^%s*(.-)%s*$')
		local cw = cv ~= ''
		local cx = cj.applyHeadShapeToDescription(cu, ct)
		local cy = {'Face', 'Shirt', 'Pants', 'GraphicTShirt', 'Head', 'Torso', 'LeftArm', 'RightArm', 'LeftLeg', 'RightLeg', 'WalkAnimation', 'MoodAnimation', 'ClimbAnimation', 'FallAnimation', 'RunAnimation', 'SwimAnimation', 'IdleAnimation', 'JumpAnimation'}
		for cz, cA in ipairs(cy) do
			local cB = cj.parseAssetId(ct[cA])
			if cB and not (cA == 'Head' and cw and cx) then
				pcall(function ()
					cu[cA] = cB
				end)
			end
		end
		if not cx and (cu.Head == 0 or not cu.Head) then
			local cz = cj.parseAssetId(ct.HeadAssetId) or cj.parseAssetId(ct.HeadId) or (type(ct.BodyParts) == 'table' and cj.parseAssetId(ct.BodyParts.Head)) or (type(ct.EquippedAssets) == 'table' and cj.parseAssetId(ct.EquippedAssets.Head))
			if cz then
