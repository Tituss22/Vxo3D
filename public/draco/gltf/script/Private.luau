								N = r.N
								pen = d * sun.tanS + 0.015 * sun.soft
								local U2 = 4 * r2 * r2
								peak = sun.dark * str * fade * sh.w * U2 / (U2 + 4 * pen * pen) * (r.water and 0.3 or 1) * (r.wet or 1) * er((ln - 0.1) / 0.15)
							end
						end
						local tgt = (peak > 0.004 and Cp) and 1 or 0
						if tgt > 0 and not s then
							s = table.remove(WLS.pool) or WLS.mk()
							s.alpha, s.cfp = 0, nil
							sl[i] = s
							WLS.n = WLS.n + 1
						end
						if s then
