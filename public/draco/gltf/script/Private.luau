				if not job then
					break
				end
				local ok, r = pcall(listRow, ui.list, job.i, job.it)
				if ok and r and pool then
					pool[job.rk] = r
				end
			end
		end
		function showList(force)
			local ui = UI
			if not ui then
				return
			end
			local key = P.tab
			pcall(function ()
				key = ui.tabs.Key() or key
			end)
			local m = MODEL[key] or {rows = {}, empty = 'Loading' .. aM.ELLIPSIS, sig = '~'}
			if not force and ui.shownKey == key and ui.shownSig == m.sig then
				return
			end
			local switched = ui.shownKey ~= key
			ui.shownKey, ui.shownSig = key, m.sig
			ui.caption.Text = m.title or ''
			if switched then
				for tab, rows in pairs(ui.pool) do
					if tab ~= key then
						for _k, r in pairs(rows) do
							r.Parent = ui.park
						end
					end
				end
			end
			local old = ui.pool[key] or {}
			local pool, queue = {}, {}
			for i, it in ipairs(m.rows) do
				local rk = rowKey(it)
				if pool[rk] or queue[rk] then
					rk = rk .. '\2' .. i
				end
				local r = old[rk]
				if r then
					old[rk] = nil
					pool[rk] = r
					if r.LayoutOrder ~= i then
						r.LayoutOrder = i
					end
					if r.Parent ~= ui.list then
						r.Parent = ui.list
					end
				else
					queue[rk] = true
					queue[#queue + 1] = {i = i, it = it, rk = rk}
				end
			end
			for _k, r in pairs(old) do
				pcall(function ()
					r:Destroy()
				end)
			end
			ui.pool[key] = pool
			for _k, job in ipairs(queue) do
				queue[job.rk] = nil
			end
			ui.queue, ui.queueTab = queue, key
			IP.buildRows(ui.rowsShown and (ui.rowsShown + 1) or 6)
			local n = #m.rows
			ui.empty.Text = m.empty or ''
			ui.empty.Visible = n == 0
			ui.more.Text = m.more or ''
			ui.more.Visible = n > 0 and m.more ~= nil
			ui.contentH = (n == 0) and 44 or (n * ROW + (n - 1) * GAP + (ui.more.Visible and (GAP + 18) or 0))
			if switched then
				pcall(function ()
					ui.list.CanvasPosition = V2(0, 0)
				end)
			end
			fitList()
		end
		local STATE = {map = {C3(22, 163, 74), C3(187, 247, 208), 'IN MAP'}, dead = {C3(185, 28, 28), C3(254, 202, 202), 'RESPAWNING'}, away = {C3(80, 80, 100), C3(200, 200, 220), 'NOT IN MAP'}}
		function setState(kind, dist)
			if not UI then
				return
			end
			local t = STATE[kind] or STATE.map
			local text = aM.BULLET .. ' ' .. t[3]
			if UI.state.Text ~= text then
				UI.state.Text = text
				UI.state.TextColor3 = t[2]
				UI.stateChip.BackgroundColor3 = t[1]
				UI.stateChip.BackgroundTransparency = 0.8
			end
			local d = dist or ''
			if UI.dist.Text ~= d then
				UI.dist.Text = d
			end
			if UI.distChip.Visible ~= (d ~= '') then
				UI.distChip.Visible = d ~= ''
			end
		end
		function setFollow(text, who)
			local ui = UI
			if not ui then
				return
			end
			local id = text and type(who) == 'table' and tonumber(who.id) or nil
			local fkey = tostring(text) .. '|' .. tostring(id) .. '|' .. tostring(id and (who.name or who.username) or '')
			if ui.followKey == fkey then
				if ui.followSeatFn then
					ui.followSeatFn()
				end
				return
			end
			ui.followKey, ui.followSeatFn = fkey, nil
			local t = id and tostring(who.name or who.username or text) or text or ('Loading' .. aM.ELLIPSIS)
			if ui.follow.Text ~= t then
				ui.follow.Text = t
			end
			local col = text and aI.Text or aI.Home.Muted
			if ui.follow.TextColor3 ~= col then
				ui.follow.TextColor3 = col
			end
			ui.followWho = id and who or nil
			local img = id and ('rbxthumb://type=AvatarHeadShot&id=' .. id .. '&w=48&h=48') or ''
			if ui.followPic.Image ~= img then
				ui.followPic.Image = img
			end
			ui.followPic.Visible = id ~= nil
			ui.followGo.Visible = id ~= nil
			ui.follow.Position = U2(0.42, id and 24 or 0, 0, 0)
			ui.follow.Size = U2(0.58, id and -38 or 0, 1, 0)
			if not id then
				ui.followSeat = nil
				return
			end
			if ui.followSeat ~= t then
				ui.followSeat = t
				ui.followPic.Position = U2(0.42, 19, 0.5, 0)
			end
			local function seat()
				local box, w = 0, 0
				pcall(function ()
					box, w = ui.follow.AbsoluteSize.X, ui.follow.TextBounds.X
				end)
				if box > 0 and w > 0 then
					local pos = U2(1, -(19 + min(w, box)), 0.5, 0)
					if ui.followPic.Position ~= pos then
						ui.followPic.Position = pos
					end
				end
			end
			ui.followSeatFn = seat
			seat()
			task.defer(seat)
		end
	end

	local clip, render
	do
		local CAP = 60
		function clip(s, n)
			s = tostring(s or '')
			local len = utf8.len(s)
			if len and len > n then
				return string.sub(s, 1, utf8.offset(s, n) - 1) .. aM.ELLIPSIS
			elseif not len and #s > n then
				return string.sub(s, 1, n) .. aM.ELLIPSIS
			end
			return s
		end
		local function lower(s)
			return string.lower(tostring(s or ''))
		end
		local function person(uid, display, user, tag, tone)
			user = tostring(user or '?')
			display = (display and display ~= '') and tostring(display) or user
			return {uid = tonumber(uid), name = display, user = user, sub = '@' .. user, tag = tag, tone = tone}
		end
		local function inMap(v, owner)
			local rows, seen = {}, {}
			local function add(uid)
				uid = tonumber(uid)
				if not uid or seen[uid] then
					return
				end
				seen[uid] = true
				local p = D:GetPlayerByUserId(uid)
				if p then
					local it = person(uid, p.DisplayName, p.Name, (p == LP) and 'YOU' or nil, 'accent')
					it.me = p == LP
					rows[#rows + 1] = it
				end
			end
			if type(v.withIds) == 'table' then
				for uid in pairs(v.withIds) do
					add(uid)
				end
			end
			if type(v.friends) == 'table' then
				for _k, f in ipairs(v.friends) do
					if f.inServer then
						add(f.id)
					end
				end
			end
			table.sort(rows, function (a, b)
				if a.me ~= b.me then
					return a.me == true
				end
				return lower(a.name) < lower(b.name)
			end)
			local m = {rows = rows, count = #rows, title = owner .. "'s friends in this server"}
			if #rows == 0 then
				if v.friendsState == 'loading' then
					m.count = nil
					m.empty = 'Checking who their friends are' .. aM.ELLIPSIS
				else
					m.empty = 'None of their friends are in this server'
				end
			end
			return m
		end
		local function allFriends(v, owner)
			local list = v.friends
			local count = tonumber(string.match(tostring(v.friendsCount or ''), '^%d+')) or (type(list) == 'table' and #list) or nil
			local m = {rows = {}, count = count, title = 'All of ' .. owner .. "'s friends"}
			if type(list) ~= 'table' then
				m.empty = (v.friendsState == 'failed') and 'Their friends list is hidden or failed to load' or ('Loading their friends list' .. aM.ELLIPSIS)
				return m
			end
			for i, f in ipairs(list) do
				if i > CAP then
					break
				end
				local me = tonumber(f.id) == LP.UserId
				m.rows[i] = person(f.id, f.name, f.username, me and 'YOU' or (f.inServer and 'IN MAP' or nil), (f.inServer and not me) and 'green' or 'accent')
			end
			if #list > CAP then
				m.more = '+' .. (#list - CAP) .. ' more' .. SEP .. 'full list in the Main tab'
			end
			if #list == 0 then
				m.empty = 'No friends'
			end
			return m
		end
		local function tools(v, owner, plr)
			local held, bag = tostring(v.holding or ''), tostring(v.inventory or '')
			local m = {rows = {}, title = owner .. "'s tools (inventory)"}
			if not plr then
				m.empty = 'Not in this server'
				return m
			end
			local function blank(s)
				return s == '' or s == '-'
			end
			if blank(held) and blank(bag) then
				local body = plr and plr.Character and plr.Character:FindFirstChildOfClass('Humanoid')
				m.empty = body and ('Reading their inventory' .. aM.ELLIPSIS) or 'No character right now'
				return m
			end
			local order, counts, inHand = {}, {}, nil
			if not blank(held) and held ~= 'None' then
				inHand = held
				order[1], counts[held] = held, 1
			end
			if not blank(bag) and bag ~= 'Empty' then
				for name in string.gmatch(bag .. ', ', '(.-), ') do
					if name ~= '' then
						if counts[name] then
							counts[name] = counts[name] + 1
						else
							order[#order + 1], counts[name] = name, 1
						end
					end
				end
			end
			local total = 0
			for i, name in ipairs(order) do
				local n = counts[name]
				total = total + n
				if name == inHand then
					m.rows[i] = {name = name, sub = (n > 1) and ('In hand' .. SEP .. (n - 1) .. ' more in backpack') or 'In hand', tag = 'HOLDING', tone = 'accent'}
				else
					m.rows[i] = {name = name, sub = 'In backpack', tag = (n > 1) and (aM.MULTIPLY .. n) or nil, tone = 'muted'}
				end
			end
			m.count = total
			if total == 0 then
				m.empty = 'No tools'
			end
			return m
		end
		local function followText(v)
			local s = tostring(v.follow or '')
			if s == '' or s == '-' or string.find(lower(s), 'loading', 1, true) then
				return nil
			end
			if string.find(s, 'Did not', 1, true) then
				return 'No, joined on their own'
			elseif string.find(s, 'not in server', 1, true) then
				return '-'
			end
			local rid = string.match(s, '^UserId (%d+)')
			if rid then
				if string.find(s, '...', 1, true) then
					return nil
				end
				return 'User ID ' .. rid
			end
			return clip(string.match(s, '^(.-)%s*|%s*%d+$') or s, 40)
		end
		local function signature(m)
			local t = {m.title or '', m.empty or '', m.more or ''}
			for _k, it in ipairs(m.rows) do
				t[#t + 1] = tostring(it.uid or '') .. ':' .. tostring(it.name) .. ':' .. tostring(it.sub or '') .. ':' .. tostring(it.tag or '')
			end
			return table.concat(t, '|')
		end
		local function sourceKey(v)
			local n, sum = 0, 0
			if type(v.withIds) == 'table' then
				for uid in pairs(v.withIds) do
					n, sum = n + 1, sum + (tonumber(uid) or 0)
				end
			end
			local fw = type(v.followWho) == 'table' and tostring(v.followWho.id) or ''
			local ch = SEL.plr and SEL.plr.Character
			if ch ~= SEL.srcChar then
				SEL.srcChar, SEL.srcGen = ch, (SEL.srcGen or 0) + 1
			end
			return table.concat({tostring(SEL.uid), tostring(SEL.plr), tostring(SEL.srcGen), tostring(v.friends), tostring((type(v.friends) == 'table') and #v.friends or -1), tostring(v.friendsCount), tostring(v.friendsState), tostring(v.holding), tostring(v.inventory), tostring(v.follow), fw, tostring(n), tostring(sum)}, '|')
		end
		function render(v)
			local key = sourceKey(v)
			if SEL.srcKey == key then
				return
			end
			SEL.srcKey = key
			local plr = SEL.plr
			local owner = (plr and ((plr.DisplayName ~= '' and plr.DisplayName) or plr.Name)) or SEL.name or 'Their'
			MODEL.map = inMap(v, owner)
			MODEL.friends = allFriends(v, owner)
			MODEL.tools = tools(v, owner, plr)
			for _k, m in pairs(MODEL) do
				m.sig = signature(m)
			end
			setFollow(followText(v), v.followWho)
			tabLabels()
			showList(false)
		end
		IP.render = render
		IP.clip = clip
	end

	local wake
	do
		local bound = false
		local function unbind()
			if bound then
				bound = false
				pcall(function ()
					G:UnbindFromRenderStep('JH_Inspect')
				end)
			end
		end
		local function fit(vp)
			return (tonumber(aJ) or 1) * clamp(min(vp.Y / 640, vp.X / 960), 0.86, 1)
		end
		local function place(dt)
			local ui = UI
			local plr = SEL.plr
			local cam = workspace.CurrentCamera
			if not (ui and cam) then
				return
			end
			local vp = cam.ViewportSize
			local sc = fit(vp) * (0.96 + 0.04 * SEL.shown)
			if abs(ui.scale.Scale - sc) > 0.001 then
				ui.scale.Scale = sc
			end
			local rows = (vp.Y / sc >= 860) and 5 or ((vp.Y / sc >= 560) and 4 or 3)
			if rows ~= ui.rowsShown then
				ui.rowsShown = rows
				fitList(rows)
			end
			local ch = plr and plr.Character
			local head = ch and (ch:FindFirstChild('Head') or ch:FindFirstChild('HumanoidRootPart'))
			local root = ch and (ch:FindFirstChild('HumanoidRootPart') or head)
			local holder = ui.holder
			local size = holder.AbsoluteSize
			local onScreen = false
			local hx, hy = 0, 0
			local pinned = SEL.hover or os.clock() < SEL.pinUntil
			if head and head:IsA('BasePart') then
				local hp, vis = cam:WorldToViewportPoint(head.Position + V3(0, 0.7, 0))
				onScreen = vis and hp.Z > 0
				hx, hy = hp.X, hp.Y
				if onScreen and not (pinned and SEL.x) then
					local rp = cam:WorldToViewportPoint(root.Position + cam.CFrame.RightVector * 1.8)
					local half = clamp(abs(rp.X - hx), 10, 240)
					local right = hx + half + 24
					local side = (right + size.X + 12 <= vp.X) and 1 or -1
					local tx = (side == 1) and right or (hx - half - 24 - size.X)
					local ty = hy - 30
					tx = clamp(tx, 12, max(12, vp.X - size.X - 12))
					ty = clamp(ty, 12, max(12, vp.Y - size.Y - 12))
					if not SEL.x then
						SEL.x, SEL.y = tx, ty
					else
						local a = 1 - exp(-dt * 16)
						SEL.x, SEL.y = SEL.x + (tx - SEL.x) * a, SEL.y + (ty - SEL.y) * a
					end
					SEL.side = side
				end
			end
			if not SEL.x then
				SEL.x, SEL.y = max(12, vp.X - size.X - 24), max(12, vp.Y * 0.2)
			end
			SEL.y = clamp(SEL.y, 12, max(12, vp.Y - size.Y - 12))
			local px, py = floor(SEL.x + 0.5), floor(SEL.y + 0.5)
			if ui.px ~= px or ui.py ~= py then
				ui.px, ui.py = px, py
				holder.Position = U2(0, px, 0, py)
				ui.shadow.Position = U2(0, px - 24, 0, py - 20)
			end
			local sw, sh = floor(size.X + 48.5), floor(size.Y + 48.5)
			if ui.sw ~= sw or ui.sh ~= sh then
				ui.sw, ui.sh = sw, sh
				ui.shadow.Size = U2(0, sw, 0, sh)
			end
			local lead = onScreen and SEL.shown > 0.5
			if ui.leadOn ~= lead then
				ui.leadOn = lead
				ui.anchor.Visible = lead
				ui.lead.Visible = lead
			end
			if lead then
				local ax, ay = floor(hx + 0.5), floor(hy + 0.5)
				local ex = (ax <= px + size.X / 2) and px or floor(px + size.X + 0.5)
				local ey = py + floor(27 * sc + 0.5)
				if ui.ax ~= ax or ui.ay ~= ay or ui.ex ~= ex or ui.ey ~= ey then
					ui.ax, ui.ay, ui.ex, ui.ey = ax, ay, ex, ey
					ui.anchor.Position = U2(0, ax, 0, ay)
					local dx, dy = ex - ax, ey - ay
					ui.lead.Position = U2(0, (ax + ex) / 2, 0, (ay + ey) / 2)
					ui.lead.Size = U2(0, math.sqrt(dx * dx + dy * dy), 0, 1)
					ui.lead.Rotation = math.deg(math.atan2(dy, dx))
				end
			end
			local gt = 1 - SEL.shown * ((onScreen or not plr) and 1 or 0.65)
			if abs(holder.GroupTransparency - gt) > 0.005 then
				holder.GroupTransparency = gt
			end
			local st = 1 - SEL.shown * 0.45
			if ui.st ~= st then
				ui.st = st
				ui.shadow.ImageTransparency = st
			end
		end
		local function info(dt)
			SEL.refresh = SEL.refresh - dt
			if SEL.refresh > 0 then
				return
			end
			SEL.refresh = 0.25
			SEL.ticks = SEL.ticks + 1
			local plr = SEL.plr
			local ui = UI
			if not (SEL.uid and ui) then
				return
			end
			if plr and not plr.Parent then
				IP.release()
				return
			end
			if not plr then
				plr = D:GetPlayerByUserId(SEL.uid)
				if plr then
					SEL.plr = plr
					local ic = infoCard()
					if ic then
						pcall(ic.live, SEL.uid)
					end
				end
			end
			local ic = infoCard()
			if ic then
				local ok, t = pcall(ic.target)
				if ok and t ~= SEL.uid and os.clock() - SEL.t0 > 1 then
					IP.release()
					return
				end
				if not SEL.rendered or SEL.ticks % 2 == 0 then
					local okV, v = pcall(ic.view, SEL.uid)
					if okV and type(v) == 'table' and v.ready then
						SEL.rendered = true
						render(v)
					end
				end
			elseif not SEL.rendered then
				SEL.rendered = true
				local note = {rows = {}, empty = 'Open the Main tab once to load player info', sig = 'none'}
				MODEL.map, MODEL.friends, MODEL.tools = note, note, note
				setFollow('-')
				showList(true)
			end
			if not plr then
				setState('away', nil)
				return
			end
			local me = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
			local them = plr.Character and plr.Character:FindFirstChild('HumanoidRootPart')
			local hum = plr.Character and plr.Character:FindFirstChildOfClass('Humanoid')
			local alive = hum and hum.Health > 0
			local dist = nil
			if me and them then
				local m = (them.Position - me.Position).Magnitude * 0.28
				dist = (m >= 1000) and (('%.1f km away'):format(m / 1000)) or (floor(m + 0.5) .. ' m away')
			end
			setState(alive and 'map' or 'dead', dist)
			espFocus(plr)
		end
		local function step(dt)
			if not y() then
				IP.teardown()
				return
			end
			dt = min(dt, 0.1)
			local ui = UI
			local now = os.clock()
			if HOLD.active and ui then
				local total = max(P.hold / 1000, 0.1)
				local k = (now - HOLD.t0) / total
				if k >= 1 then
					HOLD.active = false
					local plr = HOLD.plr
					if plr and plr.Parent then
						IP.select(plr)
						HOLD.popUntil = now + 0.28
						a2(ui.ring, 0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {Size = U2(0, 58, 0, 58)})
						a2(ui.ringS, 0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {Transparency = 1})
						a2(ui.ringDot, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {BackgroundTransparency = 1})
					else
						ui.ring.Visible = false
					end
				else
					local lead = HOLD.t1 - HOLD.t0
					local e = clamp((now - HOLD.t1) / max(total - lead, 0.05), 0, 1)
					e = 1 - (1 - e) ^ 2
					ui.ring.Visible = true
					ui.ring.Position = U2(0, HOLD.gx, 0, HOLD.gy)
					local s = 46 - 18 * e
					ui.ring.Size = U2(0, s, 0, s)
					ui.ringS.Transparency = 0.7 - 0.6 * e
					ui.ringDot.BackgroundTransparency = 0.3
				end
			elseif ui and ui.ring.Visible and now >= HOLD.popUntil then
				ui.ring.Visible = false
			end
			local want = SEL.uid and 1 or 0
			if SEL.shown ~= want then
				local a = 1 - exp(-dt * 14)
				SEL.shown = SEL.shown + (want - SEL.shown) * a
				if abs(SEL.shown - want) < 0.01 then
					SEL.shown = want
				end
			end
			if ui then
				local vis = SEL.shown > 0.001
				if ui.vis ~= vis then
					ui.vis = vis
					ui.holder.Visible = vis
					ui.shadow.Visible = vis
				end
				if SEL.uid then
					info(dt)
				end
				if ui.queue[1] then
					IP.buildRows(4)
				end
				if vis then
					place(dt)
				elseif ui.leadOn ~= false then
					ui.leadOn = false
					ui.anchor.Visible, ui.lead.Visible = false, false
				end
			end
			if not HOLD.active and not SEL.uid and SEL.shown == 0 and now >= HOLD.popUntil and not (ui and ui.queue[1]) then
				if ui then
					ui.ring.Visible = false
				end
				unbind()
			end
		end
		function wake()
			if bound or IP.tornDown then
				return
			end
			bound = true
			pcall(function ()
				G:BindToRenderStep('JH_Inspect', Enum.RenderPriority.Last.Value, step)
			end)
		end
		IP.unbind = unbind
		IP.step = step
	end
	function IP.release()
		if not SEL.uid then
			return
