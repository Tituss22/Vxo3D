				local a = (i == 1 and sh.a1) or (i == 2 and sh.a2) or sh.a3
				local p = a - L * (a:Dot(N) / ln)
				local x, y = p:Dot(e1), p:Dot(e2)
				sxx, syy, sxy = sxx + x * x, syy + y * y, sxy + x * y
			end
			local m, q = (sxx + syy) * 0.5, el(((sxx - syy) * 0.5) ^ 2 + sxy * sxy)
			local th = 0.5 * ef.atan2(2 * sxy, sxx - syy)
			return sh.C - L * d, e1 * ef.cos(th) + e2 * ef.sin(th), el(m + q), el(ef.max(m - q, 0)), ef.max(d, 0), ln
		end
		function WLS.rigGeo(o, now)
			local geo = WLS.geo[o]
			if geo and geo.groups == o.groups and geo.n == #o.parts and now < geo.t then
				return geo
			end
			geo = {groups = o.groups, n = #o.parts, t = now + 3, list = {}, parts = 0}
			for _, g in ipairs(o.groups) do
				local W, wo, x, y, z, its = 0, 0, 0, 0, 0, {}
				for _, it in ipairs(g.list) do
					local p, off = it[1], it[2]
					if typeof(off) == 'CFrame' and typeof(p) == 'Instance' then
						local s = p.Size
						local a, b, c = s.X * 0.575, s.Y * 0.575, s.Z * 0.575
						if p:IsA('Part') and p.Shape == Enum.PartType.Cylinder then
							b = ef.min(s.Y, s.Z) * 0.5
							c = b
						elseif p:FindFirstChildOfClass('SpecialMesh') then
							a, b, c = s.X * 0.5, s.Y * 0.5, s.Z * 0.5
						end
						local w = ef.pi * (((a * b) ^ 1.6075 + (a * c) ^ 1.6075 + (b * c) ^ 1.6075) / 3) ^ (1 / 1.6075) + 1e-6
						local q = off.Position
						its[#its + 1] = {w = w, q = q, a2 = a * a * 0.25, b2 = b * b * 0.25, c2 = c * c * 0.25, r = off.RightVector, u = off.UpVector, l = off.LookVector}
						W, wo = W + w, wo + w * (1 - (o.bt[p] or 0))
						x, y, z = x + q.X * w, y + q.Y * w, z + q.Z * w
						geo.parts = geo.parts + 1
					end
				end
				if W > 0 then
					local cen = ep(x / W, y / W, z / W)
					local m = {g = g, cen = cen, W = W, op = wo / W, xx = 0, yy = 0, zz = 0, xy = 0, xz = 0, yz = 0}
					for _, it in ipairs(its) do
						local d, a2, b2, c2, r, u, l, w = it.q - cen, it.a2, it.b2, it.c2, it.r, it.u, it.l, it.w / W
						m.xx = m.xx + w * (a2 * r.X * r.X + b2 * u.X * u.X + c2 * l.X * l.X + d.X * d.X)
						m.yy = m.yy + w * (a2 * r.Y * r.Y + b2 * u.Y * u.Y + c2 * l.Y * l.Y + d.Y * d.Y)
						m.zz = m.zz + w * (a2 * r.Z * r.Z + b2 * u.Z * u.Z + c2 * l.Z * l.Z + d.Z * d.Z)
						m.xy = m.xy + w * (a2 * r.X * r.Y + b2 * u.X * u.Y + c2 * l.X * l.Y + d.X * d.Y)
						m.xz = m.xz + w * (a2 * r.X * r.Z + b2 * u.X * u.Z + c2 * l.X * l.Z + d.X * d.Z)
						m.yz = m.yz + w * (a2 * r.Y * r.Z + b2 * u.Y * u.Z + c2 * l.Y * l.Z + d.Y * d.Z)
					end
					geo.list[#geo.list + 1] = m
				end
			end
			WLS.geo[o] = geo
			return geo
		end
		function WLS.at(m, xa, ya, za, xb, yb, zb)
			return m.xx * xa * xb + m.yy * ya * yb + m.zz * za * zb + m.xy * (xa * yb + ya * xb) + m.xz * (xa * zb + za * xb) + m.yz * (ya * zb + za * yb)
		end
		function WLS.shapes(o, cf, near)
			local out, n = WLS.buf, 0
			local k, kind = o.k or 1, o.wlsK
			local R, U, F, P = cf.RightVector, cf.UpVector, cf.LookVector, cf.Position
			local function add(C, a1, a2, a3, w, ao)
				n = n + 1
				local s = out[n] or {}
				out[n] = s
				s.C, s.a1, s.a2, s.a3, s.w, s.ao = C, a1, a2, a3, w, ao
			end
			if kind == 'bird' or kind == 'raptor' then
				local rap = kind == 'raptor'
				local fold = o.fold or 0
				local hs = (rap and 3.4 or 0.95) * k * (1 - 0.6 * fold)
				local fa = (o.flap or 0) * (1 - fold)
				local c, sn = ef.cos(fa), ef.sin(fa)
				add(P + U * (hs * sn * 0.5), R * (hs * em(c) + 0.05 * k), F * ((rap and 0.6 or 0.2) * k), U * (hs * em(sn) * 0.5 + 0.03 * k), 1)
				add(P, R * ((rap and 0.36 or 0.16) * k), F * ((rap and 1.45 or 0.62) * k), U * ((rap and 0.3 or 0.15) * k), 0.9)
			elseif kind == 'butterfly' then
				local hs, wa = 0.55 * k, o.wa or 0.5
				local c, sn = ef.cos(wa), ef.sin(wa)
				add(P + U * (hs * sn * 0.5), R * (hs * em(c) + 0.05 * k), F * (0.3 * k), U * (hs * sn * 0.5 + 0.02 * k), 1)
			elseif kind == 'flower' then
				local hg = o.headG and o.headG.cf
				local head, hU, hR, hF
				if hg then
					head, hU, hR, hF = (hg * eo(0, (o.topH or 0.05) * k * 0.5, 0)).Position, hg.UpVector, hg.RightVector, hg.LookVector
				else
					local g = o.groups[1] and o.groups[1].cf
					head = g and (g * eo(0, (o.topH or 0.8) * k * 0.85, 0)).Position or (P + eu * (o.hh or 1) * 0.9)
					hU, hR, hF = eu, ep(1, 0, 0), ep(0, 0, 1)
				end
				if WLS.flowers then
					local r = (WLS.HEAD[o.kind] or 5) / 60 * k
					add(head, hR * r, hF * r, hU * (r * (WLS.TALL[o.kind] or 0.45)), 1)
					if near then
						local sr = ((o.kind == 'Sunflower') and 1.6 or 0.7) / 30 * k
						add((P + head) * 0.5, ep(sr * 2, 0, 0), ep(0, 0, sr * 2), (head - P) * 0.5, 0.75)
					end
				end
				if WLS.ao and near then
					local r = 0.2 * k + 0.05
					add(P + eu * 0.03, ep(r, 0, 0), ep(0, 0, r), ep(0, 0.01, 0), 1, true)
				end
			elseif WLS.GEN[kind] then
				local geo = WLS.rigGeo(o, os.clock())
				local W, mx, my, mz = 0, 0, 0, 0
				local sxx, syy, szz, sxy, sxz, syz = 0, 0, 0, 0, 0, 0
				for _, gr in ipairs(geo.list) do
					local gcf = gr.g.cf
					if gcf then
						local X, Y, Z = gcf.RightVector, gcf.UpVector, -gcf.LookVector
						local c = gcf * gr.cen - P
						local w = gr.W * gr.op
						W, mx, my, mz = W + w, mx + c.X * w, my + c.Y * w, mz + c.Z * w
						sxx = sxx + w * (WLS.at(gr, X.X, Y.X, Z.X, X.X, Y.X, Z.X) + c.X * c.X)
						syy = syy + w * (WLS.at(gr, X.Y, Y.Y, Z.Y, X.Y, Y.Y, Z.Y) + c.Y * c.Y)
						szz = szz + w * (WLS.at(gr, X.Z, Y.Z, Z.Z, X.Z, Y.Z, Z.Z) + c.Z * c.Z)
						sxy = sxy + w * (WLS.at(gr, X.X, Y.X, Z.X, X.Y, Y.Y, Z.Y) + c.X * c.Y)
						sxz = sxz + w * (WLS.at(gr, X.X, Y.X, Z.X, X.Z, Y.Z, Z.Z) + c.X * c.Z)
						syz = syz + w * (WLS.at(gr, X.Y, Y.Y, Z.Y, X.Z, Y.Z, Z.Z) + c.Y * c.Z)
					end
				end
				if W > 1e-6 then
					mx, my, mz = mx / W, my / W, mz / W
					local a11 = 4 * (sxx / W - mx * mx) + 1e-6
					local a22 = 4 * (syy / W - my * my) + 1e-6
					local a33 = 4 * (szz / W - mz * mz) + 1e-6
					local a21, a31, a32 = 4 * (sxy / W - mx * my), 4 * (sxz / W - mx * mz), 4 * (syz / W - my * mz)
					local l11 = el(ef.max(a11, 1e-8))
					local l21, l31 = a21 / l11, a31 / l11
					local l22 = el(ef.max(a22 - l21 * l21, 1e-8))
					local l32 = (a32 - l31 * l21) / l22
					local l33 = el(ef.max(a33 - l31 * l31 - l32 * l32, 1e-8))
					add(P + ep(mx, my, mz), ep(l11, l21, l31), ep(0, l22, l32), ep(0, 0, l33), geo.parts > 1 and 0.9 or 1)
				end
			end
			return n
		end
		function WLS.tick(dt)
			if not WLS.on then
				if WLS.n > 0 or next(WLS.objs) then
					WLS.reset()
				end
				return
			end
			local now = os.clock()
			if now >= WLS.nextSun or not WLS.sun then
				WLS.nextSun = now + 0.5
				WLS.sunTick()
			end
			if now >= WLS.nextQ then
				WLS.nextQ = now + 1
				WLS.lv = WLS.level()
			end
			local sun, Qv, cam = WLS.sun, WLS.QUAL[WLS.lv], ev.camPos
			WLS.rays = Qv.rays
			if now >= WLS.nextSel then
				WLS.nextSel = now + 0.12
				local cand, nc = WLS.cand, 0
				for o in pairs(WLS.objs) do
					o.wlsSel = false
					local kind = o.wlsK
					local gen = WLS.GEN[kind]
					local on = (kind == 'flower' and (WLS.flowers or WLS.ao)) or (gen and WLS.nature) or (kind ~= 'flower' and not gen and WLS.animals)
					if on and not o.wlsDead and not o.wlsRest and o.wlsPos and ev.frame - (o.wlsF or -99) <= 12 and WLS.vis(o) > 0.03 then
						local rng = WLS.RANGE[kind] or 60
						local d = (o.wlsPos - cam).Magnitude
						if d < rng then
							nc = nc + 1
							cand[nc] = o
							o.wlsD = d / rng * (kind == 'raptor' and 0.5 or 1)
						end
					end
				end
				for j = nc + 1, #cand do
					cand[j] = nil
				end
				table.sort(cand, function (a, b)
					return a.wlsD < b.wlsD
				end)
				local left = Qv.shapes
				for _, o in ipairs(cand) do
					local need = WLS.NEED[o.wlsK] or 2
					if left >= need then
						left = left - need
						o.wlsSel = true
					end
				end
			end
			local bp, bc, bn = ev.bp, ev.bc, ev.bn
			local L, str, count = sun.L, WLS.str / 100, 0
			for o in pairs(WLS.objs) do
				if o.wlsDead then
					WLS.free(o)
					WLS.objs[o] = nil
				elseif WLS.GEN[o.wlsK] and not o.wlsSlots and ev.frame - (o.wlsF or -99) > 600 then
					WLS.objs[o] = nil
				elseif o.wlsSel or o.wlsSlots then
					local nsh, r = 0, nil
					local vis = WLS.vis(o)
					local dist = o.wlsPos and (o.wlsPos - cam).Magnitude or 0
					local rng = WLS.RANGE[o.wlsK] or 60
					if o.wlsSel and o.wlsCF then
						local cf = o.wlsCF
						nsh = WLS.shapes(o, cf - cf.Position + (o.wlsPos or cf.Position), dist < 22)
						if nsh > 0 and (sun.dark > 0.01 or o.wlsK == 'flower') then
							r = WLS.receive(o, WLS.buf[1].C, now, L)
						end
					end
					local fade = vis * (1 - er((dist / rng - 0.75) / 0.25))
					local sl = o.wlsSlots or {}
					o.wlsSlots = sl
					local any = false
					for i = 1, 4 do
						local sh = i <= nsh and WLS.buf[i] or nil
						local s = sl[i]
						local peak, Cp, u, N, r1, r2, pen = 0, nil
						if sh and sh.ao then
							N = (r and r.ok and em((r.P0 - sh.C):Dot(r.N)) < 0.6) and r.N or eu
							Cp, u = sh.C, N:Cross(em(N.Y) < 0.9 and ep(0, 0, 1) or ep(1, 0, 0)).Unit
							r1, r2, pen = sh.a1.Magnitude, sh.a1.Magnitude, sh.a1.Magnitude * 1.1
							peak = 0.3 * (1 - 0.5 * sun.night) * str * fade
						elseif sh and r and r.ok and r.lit ~= false and sun.dark > 0.01 then
							local d, ln
							Cp, u, r1, r2, d, ln = WLS.project(sh, r, r.Lr or L)
