		local function step(dt)
			dt = math.clamp(dt, 1 / 240, 0.1)
			local cam = workspace.CurrentCamera
			if not cam then
				return
			end
			local now = os.clock()
			qualityTick(dt)
			if PB.on then
				PB.master = math.min(1, PB.master + dt / 0.7)
			else
				PB.master = math.max(0, PB.master - dt / 0.5)
			end
			if not PB.on and PB.master <= 0 then
				teardown()
				return
			end
			getFolder()
			local camCF = cam.CFrame
			local camPos, look = camCF.Position, camCF.LookVector
			if now >= PB.nextEnv then
				PB.nextEnv = now + 0.25
				pcall(pollEnv)
			end
			shTick(dt)
			if now >= PB.nextExcl then
				PB.nextExcl = now + 1
				local ex = excludeList()
				PB.rp.FilterDescendantsInstances = ex
				PB.sp.FilterDescendantsInstances = ex
			end
			if not PB.pending and (now >= PB.nextScan or not PB.scanCam or (camPos - PB.scanCam).Magnitude > (PB.ao and math.clamp(aoReach() * 0.5, 14, 28) or 28)) then
				PB.nextScan = now + 2.4
				beginScan(camPos)
			end
			if PB.pending then
				scanChunk()
			end
			if PB.fresnel then
				reflTick(camPos, now)
			end
			if now >= PB.nextSel then
				PB.nextSel = now + 0.12
				selectGlints(camPos, look, now)
			end
			updateGlints(camPos, dt, now)
			updateShadows(camPos, dt, now)
			pcall(engineShadows, now)
			pcall(softTick, dt)
			local okA, errA = pcall(aoTick, camPos, dt, now)
			if not okA and not PB.warnedAO then
				PB.warnedAO = true
				warn('[JEYHUB] PBR ambient occlusion:', errA)
			end
			local okE, errE = pcall(edgeTick, camPos, dt, now)
			if not okE and not PB.warnedEdge then
				PB.warnedEdge = true
				warn('[JEYHUB] PBR edges:', errE)
			end
			local okM, errM = pcall(mirTick, camPos, dt, now)
			if not okM and not PB.warnedMir then
				PB.warnedMir = true
				warn('[JEYHUB] PBR reflections:', errM)
			end
			local okP, errP = pcall(puddleTick, camPos, dt, now)
			if not okP and not PB.warnedPud then
				PB.warnedPud = true
				warn('[JEYHUB] PBR puddles:', errP)
			end
			postTick()
			statusTick(now)
		end
		local function run(dt)
			local ok, err = pcall(step, dt)
			if not ok and not PB.warned then
				PB.warned = true
				warn('[JEYHUB] PBR Materials:', err)
			end
		end
