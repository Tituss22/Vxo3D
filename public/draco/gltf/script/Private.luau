							local m = lit * (1 - 0.3 * math.exp(-(c.gap + t) / 0.9)) * (1 + 0.06 * t / math.max(H, 0.1))
							return Color3.new(math.min(col.R * m, 1), math.min(col.G * m, 1), math.min(col.B * m, 1))
						end
						local cs = ColorSequence.new(sc(s[5], s[1]), sc(s[6], s[2]))
						seg.core.Color, seg.soft.Color = cs, cs
					end
					if not seg.on then
						seg.on = true
						seg.core.Enabled = true
						seg.soft.Enabled = true
					end
				elseif seg.on then
					seg.on = false
					seg.core.Enabled, seg.soft.Enabled = false, false
				end
			end
			mirShow(o, #slices + 1, false)
			return shown > 0
		end
		local function mirTick(camPos, dt, now)
			local q = Q()
			local list = PB.mirCast
			local n = #list
			local budget = 1
			for _ = 1, math.min(q.mirPer, n) do
				if PB.mirQi > n then
					PB.mirQi = 1
				end
				local p = list[PB.mirQi]
				PB.mirQi = PB.mirQi + 1
				if p and p.Parent then
					budget = budget - mirSolve(p, now, budget)
				end
			end
			if now >= PB.nextMirSel then
				PB.nextMirSel = now + 0.3
				local sel = {}
				if PB.mir and PB.refl > 0 then
					local cands = {}
					for _, p in ipairs(list) do
						local c = PB.mirInfo[p]
						if c and c.ok and p.Parent then
							cands[#cands + 1] = {key = p, c = c, d = (c.pos - camPos).Magnitude}
						end
					end
					for _, pl in ipairs(cr:GetPlayers()) do
						local ch = pl.Character
						local hrp = ch and ch:FindFirstChild('HumanoidRootPart')
						local hum = ch and ch:FindFirstChildOfClass('Humanoid')
						if hrp and hum and hum.Health > 0 then
							local d = (hrp.Position - camPos).Magnitude
							local head = ch:FindFirstChild('Head')
							local fp = pl == cs and head ~= nil and (head.Position - camPos).Magnitude < 1.6
							if d < q.mirRange and not fp then
								local c = PB.mirChars[ch]
								if not c then
									c = {char = true}
									PB.mirChars[ch] = c
								end
								c.hrp, c.hum, c.model = hrp, hum, ch
								cands[#cands + 1] = {key = ch, c = c, d = d * 0.7}
							end
						end
					end
					table.sort(cands, function (x, y)
						return x.d < y.d
					end)
					for k = 1, math.min(#cands, q.mirMax) do
						sel[cands[k].key] = cands[k].c
					end
				end
				PB.mirSel = sel
			end
			local sel = PB.mirSel
			for key, o in pairs(PB.mirSlots) do
				o.target = sel[key] and 1 or 0
			end
			for key, c in pairs(sel) do
				if not PB.mirSlots[key] then
					local o = table.remove(PB.mirPool) or mkMirror()
					o.alpha, o.target, o.run, o.nextRun, o.runLim, o.runOpen, o.c = 0, 1, nil, 0, nil, false, c
					for _, s in pairs(o.segs) do
						s.tk, s.ck, s.c0, s.c1, s.H, s.gap = nil, nil, nil, nil, nil, nil
					end
					PB.mirSlots[key] = o
				end
			end
			local shown = 0
			for key, o in pairs(PB.mirSlots) do
				local c = sel[key] or o.c
				o.c = c
				if o.alpha ~= o.target then
					local stp = dt / (o.target > o.alpha and 0.35 or 0.25)
					o.alpha = (o.target > o.alpha) and math.min(o.target, o.alpha + stp) or math.max(o.target, o.alpha - stp)
				end
				local draw = false
				if o.alpha > 0 and c then
					local valid = nil
					if c.char then
						valid = mirChar(c, now)
					else
						valid = c.ok and c.part.Parent ~= nil
					end
					if valid then
						local ok, res = pcall(mirStep, o, c, camPos, now)
						draw = ok and res == true
					end
				end
				if not draw and o.on ~= false then
					mirShow(o, 1, false)
				end
				o.on = draw
				if o.target == 0 and o.alpha <= 0 then
					mirShow(o, 1, false)
					o.on, o.c = false, nil
					PB.mirSlots[key] = nil
					if #PB.mirPool < 40 then
						PB.mirPool[#PB.mirPool + 1] = o
					else
						pcall(function ()
							for _, s in pairs(o.segs) do
								s.core:Destroy()
								s.soft:Destroy()
							end
							for _, a in pairs(o.att) do
								a:Destroy()
							end
						end)
					end
				elseif draw then
					shown = shown + 1
				end
			end
			PB.stat.mir = shown
		end
		local PUD_MATS = {}
		for _, nm in ipairs({'Asphalt', 'Concrete', 'Pavement', 'Cobblestone', 'Slate', 'Rock', 'Basalt', 'Brick', 'Ground', 'Mud', 'Limestone', 'Sandstone', 'Granite', 'SmoothPlastic', 'Plastic', 'WoodPlanks', 'Salt', 'Marble', 'CeramicTiles'}) do
			pcall(function ()
				PUD_MATS[Enum.Material[nm] ] = true
			end)
		end
		local PUD_G = 11
		local function cellRand(ix, iz, k)
			local v = math.sin(ix * 127.1 + iz * 311.7 + k * 74.7) * 43758.5453
			return v - math.floor(v)
		end
		local function pudSite(ix, iz, refY)
			if cellRand(ix, iz, 1) > 0.42 then
				return nil
			end
			local x = (ix + 0.15 + 0.7 * cellRand(ix, iz, 2)) * PUD_G
			local z = (iz + 0.15 + 0.7 * cellRand(ix, iz, 3)) * PUD_G
			local hit = workspace:Raycast(V3(x, refY + 14, z), V3(0, -40, 0), PB.rp)
			if not (hit and hit.Normal.Y >= 0.985 and PUD_MATS[hit.Material] and receiverOk(hit.Instance)) then
				return nil
			end
			local p0 = hit.Position
			if workspace:Raycast(p0 + UP * 0.2, UP * 150, PB.rp) then
				return nil
			end
			local rx = 1.2 + 2.4 * cellRand(ix, iz, 4)
			local rz = rx * (0.55 + 0.35 * cellRand(ix, iz, 5))
			local yaw = cellRand(ix, iz, 6) * math.pi
			local ax = V3(math.cos(yaw), 0, math.sin(yaw))
			local bz = V3(-ax.Z, 0, ax.X)
			local function level(at)
				local g = workspace:Raycast(at + UP * 1.5, UP * -3, PB.rp)
				return g ~= nil and g.Normal.Y >= 0.98 and math.abs(g.Position.Y - p0.Y) <= 0.06 and PUD_MATS[g.Material] == true
			end
			for _, v in ipairs({ax * (rx + 0.4), ax * -(rx + 0.4), bz * (rz + 0.4), bz * -(rz + 0.4)}) do
				if not level(p0 + v) then
					return nil
				end
			end
			local ls = 0.45 + 0.25 * cellRand(ix, iz, 11)
			local lo = ax * (rx * (0.55 + 0.25 * cellRand(ix, iz, 8)) * (cellRand(ix, iz, 9) < 0.5 and 1 or -1)) + bz * (rz * 0.3 * (cellRand(ix, iz, 10) - 0.5))
			if cellRand(ix, iz, 7) >= 0.6 or not level(p0 + lo + lo.Unit * (rx * ls + 0.3)) then
				lo = nil
			end
			local gc = nil
			if hit.Instance:IsA('Terrain') then
				local okC, mc = pcall(function ()
					return hit.Instance:GetMaterialColor(hit.Material)
				end)
				gc = okC and mc or RGB(90, 90, 90)
			else
				gc = hit.Instance.Color
			end
			return {pos = p0, ax = ax, rx = rx, rz = rz, lo = lo, ls = ls, col = gc, pace = 0.6 + 0.8 * cellRand(ix, iz, 12)}
		end
		local function mkLens()
			local p = Instance.new('Part')
			p.Name = 'PBRPuddle'
			p.Anchored, p.CanCollide, p.CanTouch, p.CastShadow = true, false, false, false
			pcall(function ()
				p.CanQuery = false
			end)
			pcall(function ()
				p.Massless = true
			end)
			p.Material = Enum.Material.SmoothPlastic
			p.Transparency = 1
			p.Size = V3(1, 0.07, 1)
			p.CFrame = HIDE
			local m = Instance.new('SpecialMesh')
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
			p.Parent = getFolder()
			return p
		end
		local function mkPuddle()
			return {main = mkLens(), lobe = mkLens(), rim = mkBlob('PBRPuddleRim', true), k = 0, target = 0, sz = -1, refl = -1, vis = false}
		end
		local function pudShow(o, on)
			if o.vis == on then
				return
			end
			o.vis = on
			local tr = on and 0 or 1
			o.main.Transparency = tr
			o.lobe.Transparency = (on and o.site and o.site.lo) and 0 or 1
			if not on then
				hideBlob(o.rim)
			end
		end
		local function puddleTick(camPos, dt, now)
			local q = Q()
			local wet = PB.wet
			local want = PB.puddleOn and PB.on and wet > 0.22
			PB.pudK = PB.pudK + ((want and smooth((wet - 0.22) / 0.5) or 0) - PB.pudK) * damp(dt, want and 0.15 or 0.3)
			local focus = camPos
			local ch = cs and cs.Character
			local hrp = ch and ch:FindFirstChild('HumanoidRootPart')
			if hrp and (hrp.Position - camPos).Magnitude < 60 then
				focus = hrp.Position
			end
			if PB.pudK > 0.01 and now >= PB.nextPud then
				PB.nextPud = now + 0.7
				local R = q.pudRange
				local span = math.ceil(R / PUD_G)
				local cx, cz = math.floor(focus.X / PUD_G), math.floor(focus.Z / PUD_G)
				local cand, probes = {}, 0
				for ix = cx - span, cx + span do
					for iz = cz - span, cz + span do
						local key = ix .. ':' .. iz
						local e = PB.pudCache[key]
						if (not e or now > e.t or math.abs(e.refY - focus.Y) > 10) and probes < 8 then
							probes = probes + 1
							local okS, site = pcall(pudSite, ix, iz, focus.Y)
							e = {site = (okS and site) or false, refY = focus.Y, t = now + 25 + math.random() * 10, ix = ix, iz = iz}
							PB.pudCache[key] = e
						end
						if e and e.site then
							local d = (e.site.pos - focus).Magnitude
							if d <= R then
								cand[#cand + 1] = {key = key, site = e.site, d = d}
							end
						end
					end
				end
				table.sort(cand, function (a, b)
					return a.d < b.d
				end)
				local sel = {}
				for k = 1, math.min(#cand, q.puddles) do
					sel[cand[k].key] = cand[k].site
				end
				PB.pudSel = sel
				for key, e in pairs(PB.pudCache) do
					if math.abs(e.ix - cx) > span + 3 or math.abs(e.iz - cz) > span + 3 then
						PB.pudCache[key] = nil
					end
				end
			end
			local sel = (PB.pudK > 0.01 and PB.pudSel) or {}
			for key, o in pairs(PB.pudSlots) do
				o.target = sel[key] and 1 or 0
			end
			for key, site in pairs(sel) do
				if not PB.pudSlots[key] then
					local o = table.remove(PB.pudPool) or mkPuddle()
					o.site, o.k, o.target, o.sz, o.refl, o.vis = site, 0, 1, -1, -1, nil
					local c = site.col
					local wetCol = Color3.new(c.R * 0.3, c.G * 0.31, c.B * 0.34)
					o.main.Color, o.lobe.Color = wetCol, wetCol
					PB.pudSlots[key] = o
				end
			end
			local n = 0
			for key, o in pairs(PB.pudSlots) do
				local s = o.site
				local tk = o.target * PB.pudK * PB.master
				o.k = o.k + (tk - o.k) * damp(dt, (tk > o.k and 0.45 or 0.8) * s.pace)
				if o.k > 0.02 then
					local g = 0.25 + 0.75 * o.k
					if math.abs(g - o.sz) > 0.01 then
						o.sz = g
						local center = s.pos + UP * 0.025
						o.main.Size = V3(2 * s.rx * g, 0.07, 2 * s.rz * g)
						o.main.CFrame = CFrame.fromMatrix(center, s.ax, UP)
						if s.lo then
							local lr = s.rx * s.ls * g
							o.lobe.Size = V3(2 * lr, 0.07, 1.6 * lr)
							o.lobe.CFrame = CFrame.fromMatrix(center + s.lo * g, s.ax, UP)
						end
						local rim = o.rim
						local rl, rw = 2 * s.rx * g * 1.45 + 0.6, 2 * s.rz * g * 1.45 + 0.6
						if math.abs(rl - rim.sx) > 0.05 or math.abs(rw - rim.sz) > 0.05 then
							rim.sx, rim.sz = rl, rw
							rim.plate.Size = V3(rl, 0.04, rw)
						end
						rim.plate.CFrame = CFrame.fromMatrix(s.pos + UP * 0.02, s.ax, UP)
					end
					pudShow(o, true)
					local to = camPos - s.pos
					local cosV = math.clamp(to.Y / math.max(to.Magnitude, 0.1), 0, 1)
					local rf = math.clamp((0.05 + 0.7 * (1 - cosV) ^ 3) * PB.refl / 100, 0.02, 0.8)
					if math.abs(rf - o.refl) > 0.01 then
						o.refl = rf
						o.main.Reflectance, o.lobe.Reflectance = rf, rf
					end
					setBlob(o.rim, 0.22 * o.k * PB.master, 0, nil, nil)
					if not o.rim.on then
						o.rim.on = true
						o.rim.sg.Enabled = true
					end
					n = n + 1
				else
					pudShow(o, false)
				end
				if o.target == 0 and o.k <= 0.02 then
					pudShow(o, false)
					o.main.CFrame, o.lobe.CFrame, o.rim.plate.CFrame = HIDE, HIDE, HIDE
					PB.pudSlots[key] = nil
					if #PB.pudPool < 24 then
						PB.pudPool[#PB.pudPool + 1] = o
					else
						pcall(function ()
							o.main:Destroy()
							o.lobe:Destroy()
							o.rim.plate:Destroy()
						end)
					end
				end
			end
			PB.stat.pud = n
		end
