		cj.previewQueueRunning = true
		while cj.scriptAlive and #cj.previewQueue > 0 do
			local ct = table.remove(cj.previewQueue, 1)
			if ct and ct.Generation == cj.previewQueueGeneration then
				local cu = ct.Card
				local cv = ct.Data
				if cu and cu.Parent and cv then
					cj.previewStates[cv] = 'loading'
					local cw, cx = pcall(function ()
