			if #list == 0 then
				return
			end
			PB.jobs[#PB.jobs + 1] = {list = list, o = origT, m = mineT, i = 1}
			if PB.jobRunning then
				return
			end
			PB.jobRunning = true
			task.spawn(function ()
				while #PB.jobs > 0 do
					local job = PB.jobs[1]
					runJob(job, 350)
					if job.i > #job.list and PB.jobs[1] == job then
						table.remove(PB.jobs, 1)
					end
					if #PB.jobs > 0 then
						task.wait()
					end
				end
				PB.jobRunning = false
			end)
		end
		local function faceGeom(p, ax, sg)
			local cf, sz = p.CFrame, p.Size
			if ax == 1 then
				local n = cf.RightVector * sg
				return cf.Position + n * (sz.X * 0.5), n, cf.UpVector, cf.LookVector, sz.Y * 0.5, sz.Z * 0.5
			elseif ax == 2 then
				local n = cf.UpVector * sg
				return cf.Position + n * (sz.Y * 0.5), n, cf.RightVector, cf.LookVector, sz.X * 0.5, sz.Z * 0.5
			end
			local n = cf.LookVector * -sg
			return cf.Position + n * (sz.Z * 0.5), n, cf.RightVector, cf.UpVector, sz.X * 0.5, sz.Y * 0.5
		end
		local function planeKey(n, d)
			local qx, qy, qz = math.floor(n.X * 40 + 0.5), math.floor(n.Y * 40 + 0.5), math.floor(n.Z * 40 + 0.5)
			return ((qx + 41) * 83 + (qy + 41)) * 83 + (qz + 41) + math.floor(d * 6 + 0.5) * 600000
		end
		local function excludeList()
			local t = {PB.folder}
			for _, pl in ipairs(cr:GetPlayers()) do
				if pl.Character then
					t[#t + 1] = pl.Character
				end
			end
			return t
		end
		local function beginScan(camPos)
			local q = Q()
			PB.op.FilterDescendantsInstances = excludeList()
			local seen, list = {}, {}
			local function add(res)
				for _, p in ipairs(res) do
					if not seen[p] then
						seen[p] = true
						list[#list + 1] = p
					end
				end
			end
			PB.op.MaxParts = math.floor(q.maxParts * 0.4)
			local ok1, near = pcall(function ()
				return workspace:GetPartBoundsInRadius(camPos, q.near, PB.op)
			end)
			if ok1 and near then
				add(near)
			end
			PB.op.MaxParts = q.maxParts
			local ok2, far = pcall(function ()
				return workspace:GetPartBoundsInRadius(camPos, q.radius, PB.op)
			end)
			if ok2 and far then
				add(far)
			end
			PB.pending, PB.pendIdx, PB.scanCam = list, 1, camPos
			PB.nRefl, PB.nPlanes, PB.nPlaneList, PB.nLamps, PB.nBalls = {}, {}, {}, {}, {}
			PB.nAO, PB.nEdge, PB.nMir = {}, {}, {}
		end
		local function classify(p, camPos)
			if not p.Parent then
				return
			end
			local inf = partInfo(p)
			if inf.char then
				return
			end
			local mat, tr = p.Material, PB.seeT(p)
			if mat == NEON then
				if tr < 0.7 then
					local sz = p.Size
					local md = math.max(sz.X, sz.Y, sz.Z)
					if md <= 40 then
						local mid = sz.X + sz.Y + sz.Z - md - math.min(sz.X, sz.Y, sz.Z)
						local rad = math.clamp(0.35 * (mid + md * 0.35), 0.3, 5)
						PB.nLamps[#PB.nLamps + 1] = {kind = 'neon', part = p, rad = rad, I = math.clamp(0.45 + md / 10, 0.45, 1.5)}
					end
				end
				return
			end
			if SKIP_MAT[mat] or tr >= 0.95 then
				return
			end
			local l = p:FindFirstChildWhichIsA('Light')
			if not l then
				local att = p:FindFirstChildWhichIsA('Attachment')
				l = att and att:FindFirstChildWhichIsA('Light')
			end
			if l and l.Enabled and l.Brightness > 0.05 and l.Range > 3 then
				local L = {kind = 'light', part = p, obj = l, rad = 0.6, I = math.clamp(l.Brightness / 2.2, 0.3, 1.6)}
				if l:IsA('SpotLight') or l:IsA('SurfaceLight') then
					L.cone = math.cos(math.rad(math.clamp(l.Angle, 1, 180) * 0.5))
				end
				PB.nLamps[#PB.nLamps + 1] = L
			end
			local isPart = p:IsA('Part')
			local isMesh = not isPart and (p:IsA('MeshPart') or p:IsA('PartOperation') or p:IsA('UnionOperation') or p:IsA('WedgePart') or p:IsA('CornerWedgePart'))
			local anchored = p.Anchored
			local shp = PB.shapeOf(p)
			if (anchored or (PB.ao and PB.aoLoose and atRest(p))) and tr < 0.15 and (isPart or isMesh) and shp ~= 'fake' then
				local sz = p.Size
				local mx, mn = math.max(sz.X, sz.Y, sz.Z), math.min(sz.X, sz.Y, sz.Z)
				local cap = (isPart and mn <= 6) and 160 or 60
				if mn >= 0.15 and mx <= cap and (isPart or PB.meshAO) then
					local fc = Q()
					local lc = p.CFrame:PointToObjectSpace(camPos)
					local half = sz * 0.5
					local near = V3(math.clamp(lc.X, -half.X, half.X), math.clamp(lc.Y, -half.Y, half.Y), math.clamp(lc.Z, -half.Z, half.Z))
					local d = (lc - near).Magnitude
					if d <= aoReach() then
						PB.nAO[#PB.nAO + 1] = {p = p, d = d}
					end
					if anchored and isPart and mx <= 60 and d <= fc.edgeRange and p.Shape == Enum.PartType.Block then
						PB.nEdge[#PB.nEdge + 1] = {p = p, d = d}
					end
				end
				if anchored and shp == 'solid' and mn >= 0.15 and mx <= 80 and (isMesh or p.Shape ~= Enum.PartType.Ball) then
					local d = (p.Position - camPos).Magnitude - mx * 0.5
					if d <= Q().mirRange then
						PB.nMir[#PB.nMir + 1] = {p = p, d = d}
					end
				end
			end
			if inf.sa then
				return
			end
			PB.nRefl[#PB.nRefl + 1] = p
			if not p:IsA('Part') or (tr > 0.6 and mat ~= GLASS) or shp == 'fake' then
				return
			end
			local shape = p.Shape
			if shape == Enum.PartType.Ball then
				local _, r = matResp(mat, 1)
				if r <= 0.72 then
					PB.nBalls[#PB.nBalls + 1] = p
				end
				return
			end
			if shape ~= Enum.PartType.Block then
				return
			end
			local lc = p.CFrame:PointToObjectSpace(camPos)
			local half = p.Size * 0.5
			for ax = 1, 3 do
				local lcA = (ax == 1 and lc.X) or (ax == 2 and lc.Y) or lc.Z
				local hA = (ax == 1 and half.X) or (ax == 2 and half.Y) or half.Z
				if math.abs(lcA) > hA + 0.02 then
					local sg = lcA > 0 and 1 or -1
					local c, n, u, v, hu, hv = faceGeom(p, ax, sg)
					if hu * hv >= 0.4 then
						local _, r = matResp(mat, math.clamp((n.Y - 0.35) / 0.55, 0, 1))
						if r <= 0.72 then
							local d = n:Dot(c)
							local key = planeKey(n, d)
							local pl = PB.nPlanes[key]
							if not pl then
								pl = {key = key, faces = {}, dist = math.huge}
								PB.nPlanes[key] = pl
								PB.nPlaneList[#PB.nPlaneList + 1] = pl
							end
							local dc = camPos - c
							local cu, cv = math.clamp(dc:Dot(u), -hu, hu), math.clamp(dc:Dot(v), -hv, hv)
							local fd = (dc - u * cu - v * cv).Magnitude
							if #pl.faces < 24 then
								pl.faces[#pl.faces + 1] = {p = p, ax = ax, sg = sg, c = c, n = n, u = u, v = v, hu = hu, hv = hv}
							end
							if fd < pl.dist then
								pl.dist = fd
							end
						end
					end
				end
			end
		end
		local function finishScan()
			local q, cam = Q(), PB.scanCam
			table.sort(PB.nPlaneList, function (a, b)
				return a.dist < b.dist
			end)
			local planes = {}
			for k = 1, math.min(#PB.nPlaneList, q.planes) do
				local pl = PB.nPlaneList[k]
				local sum = Vector3.zero
				for _, f in ipairs(pl.faces) do
					sum = sum + f.c
				end
				local cx = sum / #pl.faces
				local rad = 0
				for _, f in ipairs(pl.faces) do
					rad = math.max(rad, (f.c - cx).Magnitude + math.sqrt(f.hu * f.hu + f.hv * f.hv))
				end
				pl.cx, pl.rad = cx, rad
				planes[k] = pl
			end
			for _, L in ipairs(PB.nLamps) do
				L.d = (L.part.Position - cam).Magnitude / L.I
			end
			table.sort(PB.nLamps, function (a, b)
				return a.d < b.d
			end)
			local lamps = {}
			for k = 1, math.min(#PB.nLamps, q.lamps) do
				local L = PB.nLamps[k]
				L.id = idOf(L.obj or L.part)
				lamps[k] = L
			end
			local bd = {}
			for _, b in ipairs(PB.nBalls) do
				bd[b] = (b.Position - cam).Magnitude
			end
			table.sort(PB.nBalls, function (a, b)
				return bd[a] < bd[b]
			end)
			local balls = {}
			for k = 1, math.min(#PB.nBalls, 12) do
				balls[k] = PB.nBalls[k]
			end
			PB.planes, PB.lampList, PB.balls, PB.reflList = planes, lamps, balls, PB.nRefl
			if PB.reflIdx > #PB.reflList then
				PB.reflIdx = 1
			end
			table.sort(PB.nAO, function (a, b)
				return a.d < b.d
			end)
			local aoq = {}
			for k = 1, math.min(#PB.nAO, math.floor(q.aoOcc * aoDistK() + 0.5)) do
				aoq[k] = PB.nAO[k].p
			end
			PB.aoQueue, PB.aoQi, PB.aoNext = aoq, 1, {}
			table.sort(PB.nEdge, function (a, b)
				return a.d < b.d
			end)
			local eq = {}
			for k = 1, math.min(#PB.nEdge, q.edgeParts) do
				eq[k] = PB.nEdge[k].p
			end
			PB.edgeQueue, PB.edgeQi, PB.edgeNext = eq, 1, {}
			table.sort(PB.nMir, function (a, b)
				return a.d < b.d
			end)
			local mc = {}
			for k = 1, math.min(#PB.nMir, q.mirCand) do
				mc[k] = PB.nMir[k].p
			end
			PB.mirCast = mc
			if PB.mirQi > #mc then
				PB.mirQi = 1
			end
			PB.pending, PB.nRefl, PB.nPlanes, PB.nPlaneList, PB.nLamps, PB.nBalls = nil, nil, nil, nil, nil, nil
			PB.nAO, PB.nEdge, PB.nMir = nil, nil, nil
			PB.visCache = {}
		end
		local function scanChunk()
			local list = PB.pending
			local i = PB.pendIdx
			local last = math.min(#list, i + Q().chunk - 1)
			while i <= last do
				pcall(classify, list[i], PB.scanCam)
				i = i + 1
			end
			PB.pendIdx = i
			if i > #list then
				finishScan()
			end
		end
		local function getFolder()
			if PB.folder and PB.folder.Parent then
				return PB.folder
			end
			if PB.folder then
				pcall(function ()
					PB.folder:Destroy()
				end)
			end
			local f = Instance.new('Folder')
			f.Name = 'JeyhubPBR'
			f.Parent = workspace
			PB.folder, PB.slots, PB.nextExcl = f, {}, 0
			PB.aoPatches, PB.aoPool, PB.edgeStrips, PB.edgePool = {}, {}, {}, {}
			PB.beamPool = {}
			PB.mirSlots, PB.mirPool, PB.mirHolder = {}, {}, nil
			PB.castPool, PB.pudSlots, PB.pudPool = {}, {}, {}
			return f
		end
		local GLINT_N, SHADE_N = 8, 18
		local RING_K = {}
		for _, n in ipairs({GLINT_N, SHADE_N}) do
			local t, maxR = {}, math.sqrt(-math.log(0.5 / n))
			for i = 1, n do
				t[i] = math.sqrt(-math.log((i - 0.5) / n)) / maxR
			end
			RING_K[n] = t
		end
		local function mkBlob(name, dark)
			local n = dark and SHADE_N or GLINT_N
			local plate = Instance.new('Part')
			plate.Name = name
			plate.Anchored, plate.CanCollide, plate.CanTouch, plate.CastShadow = true, false, false, false
			pcall(function ()
				plate.CanQuery = false
			end)
			pcall(function ()
				plate.Massless = true
			end)
			plate.Transparency = 1
			plate.Size = V3(1, 0.04, 1)
			plate.CFrame = CFrame.new(0, -1e4, 0)
			plate.Parent = getFolder()
			local sg = Instance.new('SurfaceGui')
			sg.Face = Enum.NormalId.Top
			sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
			sg.CanvasSize = dark and Vector2.new(256, 256) or Vector2.new(64, 64)
			sg.LightInfluence = 0
			sg.AlwaysOnTop = false
			pcall(function ()
				sg.Brightness = 1
			end)
			sg.Adornee = plate
			sg.Enabled = false
			sg.Parent = plate
			local K = RING_K[n]
			local rings = {}
			for i = 1, dark and n or n + 1 do
				local k = K[i] or 0.11
				local f = Instance.new('Frame')
				f.AnchorPoint = Vector2.new(0.5, 0.5)
				f.Position = UDim2.fromScale(0.5, 0.5)
				f.Size = UDim2.fromScale(k, k)
				f.BorderSizePixel = 0
				f.BackgroundColor3 = dark and BLACK or WHITE
				f.BackgroundTransparency = 1
				local cr = Instance.new('UICorner')
				cr.CornerRadius = UDim.new(1, 0)
				cr.Parent = f
				f.Parent = sg
				rings[i] = {f = f, k = k, tr = 1}
			end
			return {plate = plate, sg = sg, rings = rings, n = n, alpha = 0, peak = -1, core = -1, br = -1, sx = 0, sz = 0, on = false, k = 1, nextVis = 0}
		end
		local function setBlob(o, peak, core, col, br)
			local n = o.n
			if math.abs(peak - o.peak) > 0.01 then
				o.peak = peak
				local tr = (1 - math.clamp(peak, 0, 0.97)) ^ (1 / n)
				for i = 1, n do
					local rg = o.rings[i]
					if math.abs(rg.tr - tr) > 0.002 then
						rg.tr = tr
						rg.f.BackgroundTransparency = tr
					end
				end
			end
			local cr = o.rings[n + 1]
			if cr and math.abs(core - o.core) > 0.01 then
				o.core = core
				cr.tr = 1 - math.clamp(core, 0, 0.95)
				cr.f.BackgroundTransparency = cr.tr
			end
			if col then
				local oc = o.col
				if not oc or math.abs(oc.R - col.R) + math.abs(oc.G - col.G) + math.abs(oc.B - col.B) > 0.02 then
					o.col = col
					for _, rg in ipairs(o.rings) do
						rg.f.BackgroundColor3 = col:Lerp(WHITE, math.clamp(0.1 + 0.75 * (1 - rg.k), 0, 1))
					end
				end
			end
			if br and math.abs(br - o.br) > 0.04 then
				o.br = br
				pcall(function ()
					o.sg.Brightness = br
				end)
			end
		end
		local function hideBlob(o)
			if o.on then
				o.on = false
				o.sg.Enabled = false
			end
		end
		local function mirrorPoint(camPos, n, c, L, lp)
			local cn = (camPos - c):Dot(n)
			if cn <= 0.05 then
				return nil
			end
			if L.kind == 'dir' then
				local ld = L.dir:Dot(n)
				if ld <= 0.015 then
					return nil
				end
				return camPos + (L.dir - n * (2 * ld)) * (cn / ld)
			end
			local ln = (lp - c):Dot(n)
			if ln <= 0.1 then
				return nil
			end
			return camPos + ((lp - n * (2 * ln)) - camPos) * (cn / (cn + ln))
		end
		local function ballPoint(camPos, cpos, rad, L, lp)
			local V = camPos - cpos
			local dv = V.Magnitude
			if dv <= rad + 0.2 then
				return nil
			end
			V = V / dv
			local Ld = L.dir
			if L.kind ~= 'dir' then
				Ld = lp - cpos
				local dl = Ld.Magnitude
				if dl <= rad + 0.1 then
					return nil
				end
				Ld = Ld / dl
			end
			local h = V + Ld
			local hm = h.Magnitude
			if hm < 0.05 then
				return nil
			end
			h = h / hm
			return cpos + h * rad, h
		end
		local function glintParams(camPos, P, n, L, lp, mat, ballRad)
			local toCam = camPos - P
			local Dc = toCam.Magnitude
			if Dc < 0.4 then
				return nil
			end
			local cosV = math.clamp(toCam:Dot(n) / Dc, 0.001, 1)
			local _, r, metal = matResp(mat, math.clamp((n.Y - 0.35) / 0.55, 0, 1))
			if r > 0.75 then
				return nil
			end
			local theta = 0.03 + 0.45 * r * r
			local f5 = (1 - cosV) ^ 5
			local fres = metal and (0.8 + 0.2 * f5) or (0.32 + 0.68 * f5)
			local I, ang = nil
			if L.kind == 'dir' then
				ang = math.max(theta, 0.02)
				I = L.I * math.clamp(0.06 / theta, 0.25, 1)
			else
				local dl = math.max((lp - P).Magnitude, 0.5)
				local lr = L.rad / dl
				ang = math.sqrt(theta * theta + (L.rad / (Dc + dl)) ^ 2)
				I = L.I * math.clamp(lr * lr / (theta * theta), 0.15, 1) * (0.5 + 0.5 * PB.env.night)
			end
			I = I * (1 - r) ^ 1.3 * fres * 1.35 * PB.spec / 100
			local a, b = nil
			if ballRad then
				b = math.clamp(ballRad * (0.07 + 0.8 * theta), 0.03, ballRad * 0.45)
				a = b
			else
				b = math.clamp(Dc * math.tan(ang) * 1.7, 0.05, 24)
				a = math.clamp(b / math.max(cosV, 0.08), b, 64)
				if PB.wetStreak and PB.wet > 0.05 and not metal then
					local st = 1 + 5 * PB.wet * (1 - 0.6 * cosV)
					a = math.clamp(a * st, b, 64)
					b = b * (1 - 0.25 * PB.wet)
				end
			end
			return I, a, b, r, metal
		end
		local function stretchAxes(P, n, camPos)
			local s = P - camPos
			s = s - n * s:Dot(n)
			if s.Magnitude < 1e-3 then
				s = n:Cross(math.abs(n.Y) < 0.9 and UP or V3(1, 0, 0))
			end
			s = s.Unit
			return s, s:Cross(n)
		end
		local function hostIn(pl, pt)
			for _, f in ipairs(pl.faces) do
				local d = pt - f.c
				if math.abs(d:Dot(f.u)) <= f.hu and math.abs(d:Dot(f.v)) <= f.hv then
					return f
				end
			end
			return nil
		end
		local FIT = {1, 0.72, 0.5, 0.32}
		local function edgeFit(pl, P, s, t, a, b)
			for _, k in ipairs(FIT) do
				if hostIn(pl, P + s * (a * k)) and hostIn(pl, P - s * (a * k)) and hostIn(pl, P + t * (b * k)) and hostIn(pl, P - t * (b * k)) then
					return k
				end
			end
			return 0.22
		end
		local function visible(P, n, L, lp, camPos)
			local o = P + n * 0.06
			local dir = nil
			if L.kind == 'dir' then
				dir = L.dir * 400
			else
				dir = lp - o
				dir = dir * (1 - 0.6 / math.max(dir.Magnitude, 0.7))
			end
			local hit = workspace:Raycast(o, dir, PB.rp)
			if hit and PB.seeT(hit.Instance) < 0.5 and hit.Instance ~= L.part then
				return false
			end
			local tc = camPos - o
			local hit2 = workspace:Raycast(o, tc * (1 - 0.4 / math.max(tc.Magnitude, 0.5)), PB.rp)
			if hit2 and PB.seeT(hit2.Instance) < 0.5 then
				return false
			end
			return true
		end
		local function buildLights()
			local out, env = {}, PB.env
			if PB.sunGlints and env.I > 0.02 then
				out[1] = {kind = 'dir', dir = env.dir, I = env.I, col = env.col, id = env.src, rad = 0}
			end
			if PB.lamps then
				for _, L in ipairs(PB.lampList) do
					local ok = pcall(function ()
						if not L.part.Parent then
							error('gone', 0)
						end
						if L.kind == 'neon' then
							L.pos, L.col = L.part.Position, L.part.Color
						else
							local l = L.obj
							if not (l.Parent and l.Enabled) then
								error('off', 0)
							end
							local par = l.Parent
							local cf = par:IsA('Attachment') and par.WorldCFrame or L.part.CFrame
							L.pos, L.col = cf.Position, l.Color
							if L.cone then
								L.cdir = cf:VectorToWorldSpace(Vector3.FromNormalId(l.Face))
							end
						end
					end)
					if ok then
						out[#out + 1] = L
					end
				end
			end
			PB.lights = out
			return out
		end
		local function selectGlints(camPos, look, now)
			local q = Q()
			local lights = buildLights()
			local cands, nc = {}, 0
			local function consider(key, sc, pl, host, ball, L)
				local vis = PB.visCache[key]
				if vis and now < vis.t then
					sc = sc * (vis.v > 0 and 1 or 0.05)
				end
				nc = nc + 1
				cands[nc] = {key = key, sc = sc, pl = pl, host = host, ball = ball, L = L}
