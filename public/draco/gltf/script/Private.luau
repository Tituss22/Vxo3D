				if ct[cB] ~= nil then
					pcall(function ()
						cu[cB] = tostring(ct[cB])
					end)
				end
			end
		end
		local cA = {'RightArmColor', 'TorsoColor', 'RightLegColor', 'LeftLegColor', 'LeftArmColor', 'HeadColor'}
		for cB, cC in ipairs(cA) do
			local cD = ct[cC]
			if type(cD) == 'table' then
				pcall(function ()
					cu[cC] = Color3.fromRGB(cD.r or cD.R or 255, cD.g or cD.G or 255, cD.b or cD.B or 255)
				end)
			end
		end
		local cB = {'ProportionScale', 'DepthScale', 'HeightScale', 'WidthScale', 'BodyTypeScale', 'HeadScale'}
		for cC, cD in ipairs(cB) do
			if ct[cD] ~= nil then
				pcall(function ()
					cu[cD] = tonumber(ct[cD]) or 1
				end)
			end
		end
		return cu
	end
	cj.applyRigidAccessoryRefinements = function (ct, cu)
		local cv = cu and cu.AccessoryRefinements
		if type(cv) ~= 'table' then
			return 0
		end
		local cw = 0
		local cx = {}
		for cy, cz in ipairs(ct:GetDescendants()) do
			if cz:IsA('Accessory') then
				local cA = cz:FindFirstChild('Handle')
				if cA then
					local cB = nil
					pcall(function ()
						cB = cj.parseAssetId(cz:GetAttribute('AssetId'))
					end)
					if not cB then
						pcall(function ()
							cB = cj.parseAssetId(cA:GetAttribute('AssetId'))
						end)
					end
					if not cB then
						local cC = cA:FindFirstChildOfClass('SpecialMesh')
						if cC and cC.MeshId then
							cB = cj.parseAssetId(cC.MeshId)
						end
					end
					if not cB and cA:IsA('MeshPart') and cA.MeshId then
						cB = cj.parseAssetId(cA.MeshId)
					end
					local cC = (cB and cv[tostring(cB)]) or cv[cz.Name]
					if cC and type(cC) == 'table' then
						local cD = cB or cz.Name
						if not cx[cD] then
							local cE = cj.vector3FromSaved(cC.Position, Vector3.zero)
							local cF = cj.vector3FromSaved(cC.Rotation, Vector3.zero)
							local cG = cj.vector3FromSaved(cC.Scale, Vector3.one)
							local cH = CFrame.new(cE) * CFrame.Angles(math.rad(cF.X), math.rad(cF.Y), math.rad(cF.Z))
							local cI = cA:FindFirstChildOfClass('Attachment')
							if cI then
								cI.CFrame = cI.CFrame * cH
							else
								local cJ = cA:FindFirstChildOfClass('Weld') or cA:FindFirstChildOfClass('WeldConstraint') or cA:FindFirstChildOfClass('ManualWeld')
								if cJ and cJ:IsA('Weld') then
									cJ.C0 = cJ.C0 * cH
								end
							end
							if cG ~= Vector3.one then
								cA.Size = cA.Size * cG
								local cJ = cA:FindFirstChildOfClass('SpecialMesh')
								if cJ then
									cJ.Scale = cJ.Scale * cG
								end
							end
							cx[cD] = true
							cw = cw + 1
						end
					end
				end
			end
		end
		return cw
	end
	cj.getAnimationIdFromFolder = function (ct, cu)
