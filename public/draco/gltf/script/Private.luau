					end
					local gk = math.floor(c.gap * 8 + 0.5)
					if ck ~= seg.ck or s[5] ~= seg.c0 or s[6] ~= seg.c1 or H ~= seg.H or gk ~= seg.gap then
						seg.ck, seg.c0, seg.c1, seg.H, seg.gap = ck, s[5], s[6], H, gk
