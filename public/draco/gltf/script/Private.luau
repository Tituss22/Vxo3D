							return NumberSequence.new({NumberSequenceKeypoint.new(0, 1 - x * fadeAt(u0)), NumberSequenceKeypoint.new(0.5, 1 - x * fadeAt(um)), NumberSequenceKeypoint.new(1, 1 - x * fadeAt(u1))})
						end
