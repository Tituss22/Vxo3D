		for cy, cz in ipairs(cu) do
			local cA = ct:FindFirstChild(cz, true)
			if cA and cA:IsA('BasePart') and not cx[cA] then
				cx[cA] = true
				cw = true
				cv = math.min(cv, cj.getPartBottomY(cA))
			end
		end
		return cw and cv or nil
	end
	cj.calculateLocalTryOnSwimOffset = function (ct, cu, cv, cw)
		local cx = ct:FindFirstChild('UpperTorso') or ct:FindFirstChild('Torso') or cv
		local cy = cu:FindFirstChild('UpperTorso') or cu:FindFirstChild('Torso') or cw
		local cz = cv.CFrame:ToObjectSpace(cx.CFrame).Y
		local cA = cw.CFrame:ToObjectSpace(cy.CFrame).Y
		return Vector3.new(0, cz - cA, 0)
	end
	cj.calculateGroundOffsetFromCurrentPlacement = function (ct, cu, cv)
		if not ct or not cu then
			return nil
		end
		local cw = cj.getFeetBottomY(ct)
		local cx = cj.getFeetBottomY(cu)
		if not cw or not cx then
			return nil
		end
		local cy = cv and cv.Y or 0
		return Vector3.new(0, cw - cx + cy, 0)
	end
	cj.calculateGroundOffsetFromNeutralCloneFeet = function (ct, cu)
		if not ct or not cu or cj.localTryOnNeutralCloneFeetRootOffsetY == nil then
			return nil
		end
		local cv = cj.getFeetBottomY(ct)
		if not cv then
			return nil
		end
		return Vector3.new(0, cv - cu.Position.Y - cj.localTryOnNeutralCloneFeetRootOffsetY, 0)
	end
	cj.getLocalTryOnHipReference = function (ct)
		if not ct then
			return nil
		end
		local cu = ct:FindFirstChild('LowerTorso', true)
		if cu and cu:IsA('BasePart') then
			local cv = cu:FindFirstChild('LeftHipRigAttachment')
			local cw = cu:FindFirstChild('RightHipRigAttachment')
			if cv and cv:IsA('Attachment') and cw and cw:IsA('Attachment') then
				return (cv.WorldPosition + cw.WorldPosition) * 0.5
			end
			local cx = ct:FindFirstChild('LeftUpperLeg', true)
			local cy = ct:FindFirstChild('RightUpperLeg', true)
			local cz = cx and cx:FindFirstChild('LeftHipAttachment')
			local cA = cy and cy:FindFirstChild('RightHipAttachment')
			if cz and cz:IsA('Attachment') and cA and cA:IsA('Attachment') then
				return (cz.WorldPosition + cA.WorldPosition) * 0.5
			end
		end
		local cv = ct:FindFirstChild('Torso', true)
		if cv and cv:IsA('BasePart') then
			local cw = cv:FindFirstChild('Left Hip')
			local cx = cv:FindFirstChild('Right Hip')
			if cw and cw:IsA('Motor6D') and cx and cx:IsA('Motor6D') then
				local cy = cw.Part0 or cv
				local cz = cx.Part0 or cv
				local cA = cy.CFrame * cw.C0 * cw.Transform
				local cB = cz.CFrame * cx.C0 * cx.Transform
				return (cA.Position + cB.Position) * 0.5
			end
		end
		return nil
	end
	cj.calculateLocalTryOnSeatedHipOffset = function (ct, cu, cv)
		if not cj.scriptAlive or not cu or cu ~= cj.localTryOnModel or not cu:IsDescendantOf(cj.Workspace) then
			return nil
		end
		if not ct or not ct.Parent then
			return nil
		end
		local cw = cj.getLocalTryOnHipReference(ct)
		local cx = cj.getLocalTryOnHipReference(cu)
		if not cw or not cx then
			return nil
		end
		local cy = cv or Vector3.zero
		return cy + (cw - cx)
	end
	cj.getLocalTryOnSeatedHipOffsetLocal = function (ct, cu)
		if not ct or not cu then
			return Vector3.zero
		end
		return ct.CFrame:VectorToObjectSpace(cu)
	end
	cj.isCloneSitAnimationSettled = function (ct)
		if not ct then
			return false
		end
		local cu = ct:FindFirstChildOfClass('Humanoid')
		if not cu then
			return false
		end
		local cv = cu:FindFirstChildOfClass('Animator')
		if not cv then
			return false
		end
		local cw = cu.RigType
		local cx = cw == Enum.HumanoidRigType.R6 or (ct:FindFirstChild('Torso') ~= nil and ct:FindFirstChild('UpperTorso') == nil)
		local cy = cj.resolveAnimationIds(ct, nil, cx)
		local cz = cj.parseAssetId(cy and cy.Sit)
		if not cz then
			return false
		end
		local cA = nil
		for cB, cC in ipairs(cv:GetPlayingAnimationTracks()) do
			if cC and cC.Animation then
				local cD = cj.parseAssetId(cC.Animation.AnimationId)
				if cD == cz and cC.IsPlaying then
					cA = cC
					break
				end
			end
		end
		if not cA then
			return false
		end
		if cA.WeightTarget < 0.95 then
			return false
		end
		if math.abs(cA.WeightCurrent - cA.WeightTarget) > 0.02 then
			return false
		end
		for cB, cC in ipairs(cv:GetPlayingAnimationTracks()) do
			if cC ~= cA and cC.IsPlaying and cC.WeightCurrent > 0.05 then
				return false
			end
		end
		return true
	end
	cj.isPlayerSitAnimationCleared = function (ct)
		if not ct then
			return true
		end
		local cu = ct:FindFirstChildOfClass('Humanoid')
		if not cu then
			return true
		end
		local cv = cu:FindFirstChildOfClass('Animator')
		if not cv then
			return true
		end
		local cw = cu.RigType == Enum.HumanoidRigType.R6 or (ct:FindFirstChild('Torso') ~= nil and ct:FindFirstChild('UpperTorso') == nil)
		local cx = cj.resolveAnimationIds(ct, nil, cw)
		local cy = cj.parseAssetId(cx and cx.Sit)
		if not cy then
			return true
		end
		for cz, cA in ipairs(cv:GetPlayingAnimationTracks()) do
			if cA and cA.Animation then
				local cB = cj.parseAssetId(cA.Animation.AnimationId)
				if cB == cy and (cA.IsPlaying or cA.WeightCurrent > 0.05 or cA.WeightTarget > 0.05) then
					return false
				end
			end
		end
		return true
	end
	cj.waitForCloneSitAnimationToSettle = function (ct, cu, cv, cw, cx)
		local cy = os.clock() + (cx or 0.6)
		while cj.scriptAlive and os.clock() < cy do
			if not ct or not ct.Parent or not cv then
				return false
			end
			if not cu or cu ~= cj.localTryOnModel or not cu:IsDescendantOf(cj.Workspace) then
				return false
			end
			local cz = cv:GetState()
			local cA = cv.Sit or cv.SeatPart ~= nil or cz == Enum.HumanoidStateType.Seated
			if not cA or cv.SeatPart ~= cw then
				return false
			end
			if cj.isCloneSitAnimationSettled(cu) then
				return true
			end
			cj.RunService.Heartbeat:Wait()
		end
		return false
	end
	cj.scheduleSeatHipCalibrationAfterHeartbeat = function (ct, cu, cv, cw, cx)
		cj.localTryOnSeatCalibrationToken = cj.localTryOnSeatCalibrationToken + 1
		local cy = cj.localTryOnSeatCalibrationToken
		cj.localTryOnSeatCalibrationPending = true
		task.spawn(function ()
			local cz = cj.waitForCloneSitAnimationToSettle(ct, cu, cv, cw, 0.6)
			if not cj.scriptAlive or cy ~= cj.localTryOnSeatCalibrationToken then
				return
			end
			if not cz then
				cj.localTryOnSeatCalibrationPending = false
				return
			end
			if not cu or cu ~= cj.localTryOnModel or not cu:IsDescendantOf(cj.Workspace) then
				cj.localTryOnSeatCalibrationPending = false
				return
			end
			if not ct or not ct.Parent or not cv then
				cj.localTryOnSeatCalibrationPending = false
				return
			end
			local cA = cv:GetState()
			local cB = cv.Sit or cv.SeatPart ~= nil or cA == Enum.HumanoidStateType.Seated
			if not cB or cv.SeatPart ~= cw then
				cj.localTryOnSeatCalibrationPending = false
				return
			end
			local cC = ct:FindFirstChild('HumanoidRootPart') or ct.PrimaryPart
			if not cC then
				cj.localTryOnSeatCalibrationPending = false
				return
			end
			local cD = cj.calculateLocalTryOnSeatedHipOffset(ct, cu, cx)
			if cD then
				cj.localTryOnSeatedHipOffsetLocal = cj.getLocalTryOnSeatedHipOffsetLocal(cC, cD)
				cj.localTryOnSeatedHipOffsetValid = true
				cj.localTryOnPositionMode = 'Seat'
			end
			cj.localTryOnSeatCalibrationPending = false
		end)
	end
	cj.isGroundPlacementState = function (ct)
		return ct == Enum.HumanoidStateType.Running or ct == Enum.HumanoidStateType.Landed or ct == Enum.HumanoidStateType.PlatformStanding
	end
	cj.tryOnSelectedAvatarLocally = function ()
		if cj.localTryOnBuilding then
			return
		end
		local ct = cj.ui.selectedAvatar
		if not ct or not ct.Properties then
			cj.Status.Text = '[!] Select an avatar first.'
			cj.clearDiagnostics()
			return
		end
		if cj.IS_CATALOG_AVATAR_CREATOR then
			local cu, cv = cj.wearAvatarThroughCatalog(ct)
			if cu then
				cj.tryOnActive = true
				cj.Status.Text = '[FE] Avatar worn through Catalog Avatar Creator.'
				cj.clearDiagnostics()
				return
			end
			cj.tryOnActive = false
			cj.showDiagnostics('CAC avatar wear failed.', tostring(cv))
			return
		end
		local cu = cj.LocalPlayer.Character
		local cv = cu and cu:FindFirstChildOfClass('Humanoid')
		if cj.placeholderMode and cv and cv.RigType == Enum.HumanoidRigType.R6 then
			cj.tryOnActive = true
			cj.Status.Text = '[...] Applying R6 placeholder...'
			cj.clearDiagnostics()
			local cw, cx = cj.applyPlaceholderR6(ct)
			if cw then
				cj.Status.Text = '[OK] R6 placeholder active!'
				return
			end
			cj.tryOnActive = false
			cj.showDiagnostics('R6 placeholder failed.', tostring(cx))
			return
		end
		if not cu or not cu.Parent then
			cj.showDiagnostics('Local try-on failed.', 'Your character is not available yet. Waiting for spawn...')
			return
		end
		if cj.isCharacterCurrentlySitting(cu, cv) then
			cj.abortLocalTryOnForSeatedPlayer()
			return
		end
		cj.tryOnActive = true
		cj.stopLocalTryOn(true)
		cj.localTryOnBuildId = cj.localTryOnBuildId + 1
		local cw = cj.localTryOnBuildId
		cj.localTryOnBuilding = true
		cj.WearButton.Active = false
		cj.updateWearButtonState()
		cj.Status.Text = '[...] Building local avatar...'
		cj.clearDiagnostics()
		local cx = cj.getEnumRigType(ct.RigType)
		local cy = cv
		local cz = 'Unknown local avatar creation failure.'
		local cA = false
		if cv then
			cj.setLocalTryOnConnection('buildSeat', cv.Seated, function (cB)
				if cB then
					cA = true
				end
			end)
		end
		local function cB()
			return cA or cj.isCharacterCurrentlySitting(cu, cv)
		end
		for cC = 1, 3 do
			if cB() then
				cj.abortLocalTryOnForSeatedPlayer()
				return
			end
			if not cj.scriptAlive or cw ~= cj.localTryOnBuildId then
				cj.localTryOnBuilding = false
				cj.WearButton.Active = true
				cj.updateWearButtonState()
				return
			end
			if cC > 1 then
				cj.Status.Text = string.format('[...] Retrying local avatar... (%d/3)', cC)
				task.wait(0.1 * (cC - 1))
				if cB() then
					cj.abortLocalTryOnForSeatedPlayer()
					return
				end
				if not cj.scriptAlive or cw ~= cj.localTryOnBuildId then
					cj.localTryOnBuilding = false
					cj.WearButton.Active = true
					cj.updateWearButtonState()
					return
				end
			end
			local cD = cj.reconstructHumanoidDescription(ct.Properties)
			cj.mergePlayerEmotesIntoDescription(cD, cy, cx)
			local cE, cF = pcall(function ()
				return cj.Players:CreateHumanoidModelFromDescriptionAsync(cD, cx)
			end)
			pcall(function ()
				cD:Destroy()
			end)
			if cB() then
				if typeof(cF) == 'Instance' then
					pcall(function ()
						cF:Destroy()
					end)
				end
				cj.abortLocalTryOnForSeatedPlayer()
				return
			end
			if not cE or typeof(cF) ~= 'Instance' or not cF:IsA('Model') then
				cz = tostring(cF)
				if cF and typeof(cF) == 'Instance' then
					pcall(function ()
						cF:Destroy()
					end)
				end
			else
				local cG = cF
				local cH = nil
				local cI, cJ = pcall(function ()
					cG.Name = 'LocalWearer_LocalTryOn'
					cj.applyBodyColors(cG, ct.Properties)
					cj.applyHeadShapeToModel(cG, ct.Properties)
					cj.applyRigidAccessoryRefinements(cG, ct.Properties)
					local cI = cG:FindFirstChild('HumanoidRootPart', true) or cG.PrimaryPart or cG:FindFirstChild('Head', true)
					local cJ = cu:FindFirstChild('HumanoidRootPart') or cu.PrimaryPart
					if not cI then
						error('Generated avatar missing root part.')
					end
					if not cJ then
						error('Your character missing root part.')
					end
					cj.prepareLocalModel(cG)
					for cK, cL in ipairs(cG:GetDescendants()) do
						cj.disableLocalTryOnCollision(cL)
					end
					cj.setLocalTryOnConnection('collision', cG.DescendantAdded, cj.disableLocalTryOnCollision)
					cj.setLocalTryOnConnection('preSimulation', cj.RunService.PreSimulation, cj.enforceLocalTryOnNoCollision)
					cj.enforceLocalTryOnNoCollision()
					cj.setLocalTryOnStagingVisibility(cG, true)
					cI.CFrame = cJ.CFrame + Vector3.new(0, 100, 0)
					cG.Parent = cj.Workspace
					if not cj.isLocalTryOnModelValid(cG) then
						error([[Generated avatar was removed or invalid immediately after entering Workspace.]])
					end
					cj.localTryOnModel = cG
					cj.RunService.Heartbeat:Wait()
					if cB() then
						error([[Local try-on blocked: player became seated during avatar build.]])
					end
					if not cj.isLocalTryOnModelValid(cG) then
						error('Generated avatar did not survive initial rig settling.')
					end
					cI = cG:FindFirstChild('HumanoidRootPart', true) or cG.PrimaryPart or cG:FindFirstChild('Head', true)
					if not cI then
						error('Generated avatar root disappeared after rig settling.')
					end
					cI.CFrame = cJ.CFrame
					local cK = cv and cv:GetState()
					local cL = cK == Enum.HumanoidStateType.Swimming
					cj.currentVerticalOffset = Vector3.zero
					cj.localTryOnRootPart = cI
					cj.localTryOnSwimOffset = cj.calculateLocalTryOnSwimOffset(cu, cG, cJ, cI)
					local cM = cj.getFeetBottomY(cG)
					cj.localTryOnNeutralCloneFeetRootOffsetY = cM and (cM - cJ.Position.Y) or nil
					cj.localTryOnGroundOffset = cj.calculateGroundOffsetFromCurrentPlacement(cu, cG, Vector3.zero)
					if not cj.localTryOnGroundOffset then
						error('Could not establish initial feet-to-feet ground alignment.')
					end
					cj.localTryOnGroundOffsetValid = true
					cj.localTryOnSeatedHipOffsetValid = false
					cj.localTryOnPositionMode = 'Ground'
					cj.localTryOnSeatCalibrationPending = false
					cj.localTryOnSeatCalibrationToken = cj.localTryOnSeatCalibrationToken + 1
					cj.localTryOnGroundCalibrationFrames = 0
					cj.localTryOnSwimTransitionActive = false
					cj.localTryOnSwimTransitionStart = Vector3.zero
					cj.localTryOnSwimTransitionStartedAt = 0
					cj.localTryOnLastSwimming = cL
					cj.localTryOnSeatPart = nil
					cj.currentVerticalOffset = cL and cj.localTryOnSwimOffset or cj.localTryOnGroundOffset
					cj.localTryOnRootPart.CFrame = cJ.CFrame + cj.currentVerticalOffset
					cj.enforceLocalTryOnNoCollision()
					cj.setLocalTryOnStagingVisibility(cG, false)
					cj.localTryOnHiddenInFirstPerson = false
					cj.setLocalTryOnFirstPersonVisibility(cj.isFirstPersonCamera(cu))
					cH = cj.bindAnimationSync(cu, cG, ct.Properties, ct.RigType)
					if cB() then
						error([[Local try-on blocked: player became seated during avatar build.]])
					end
					if not cj.isLocalTryOnModelValid(cG) then
						error('Generated avatar did not survive animation setup.')
					end
					cj.hideCharacterLocally(cu)
					task.spawn(function ()
						if cj.scriptAlive and cG.Parent and cG:IsDescendantOf(cj.Workspace) then
							cj.preloadAvatarVisualContent(cG)
						end
					end)
				end)
				if not cI then
					if cj.localTryOnModel == cG then
						cj.localTryOnModel = nil
					end
					cj.setLocalTryOnConnection('collision', nil)
					cj.setLocalTryOnConnection('preSimulation', nil)
					pcall(function ()
						cG:Destroy()
					end)
					cz = tostring(cJ)
					if cB() then
						cj.abortLocalTryOnForSeatedPlayer()
						return
					end
				end
				if cI and cj.scriptAlive and cw == cj.localTryOnBuildId and cj.isLocalTryOnModelValid(cG) then
					if cB() then
						cj.abortLocalTryOnForSeatedPlayer()
						return
					end
					cj.destroyOrphanedLocalTryOnModels(cG)
					cj.enforceLocalTryOnNoCollision()
					cj.setLocalTryOnConnection('buildSeat', nil)
					cj.localTryOnBuilding = false
					cj.WearButton.Active = true
					cj.setLocalTryOnConnection('position', cj.RunService.RenderStepped, function ()
						if not cj.scriptAlive then
							return
						end
						if not cj.localTryOnModel or not cj.localTryOnModel:IsDescendantOf(cj.Workspace) then
							if cj.tryOnActive and not cj.localTryOnBuilding and not cj.localTryOnMissingRecoveryPending then
								cj.localTryOnMissingRecoveryPending = true
								local cK = cj.localTryOnBuildId
								task.delay(0.15, function ()
									cj.localTryOnMissingRecoveryPending = false
									if not cj.scriptAlive or cK ~= cj.localTryOnBuildId or cj.localTryOnBuilding or not cj.tryOnActive then
										return
									end
									if not cj.localTryOnModel or not cj.localTryOnModel:IsDescendantOf(cj.Workspace) then
										cj.stopLocalTryOn(false)
										cj.Status.Text = [[[!] Local try-on was removed by this experience. Original avatar restored.]]
										cj.showDiagnostics('Local try-on unavailable in this experience.', [[The generated avatar was removed after creation. Your real avatar has been restored. Try again; some games replace or restrict local Humanoid models.]])
									end
								end)
							end
							return
						end
						cj.localTryOnMissingRecoveryPending = false
						cj.enforceLocalTryOnNoCollision()
						if not cu or not cu.Parent then
							cj.stopLocalTryOn(cj.tryOnActive)
							cj.updateWearButtonState()
							if cj.tryOnActive then
								cj.Status.Text = '[...] Character respawning...'
							end
							return
						end
						local cK = cu:FindFirstChild('HumanoidRootPart') or cu.PrimaryPart
						local cL = cu:FindFirstChildOfClass('Humanoid')
						if not cK or not cj.localTryOnRootPart then
							cj.stopLocalTryOn(cj.tryOnActive)
							cj.updateWearButtonState()
							if cj.tryOnActive then
								cj.Status.Text = '[...] Waiting for character...'
							end
							return
						end
						local cM = cL and cL:GetState()
						local cN = (cM == Enum.HumanoidStateType.Swimming)
						local cO = cL and (cL.Sit or cL.SeatPart ~= nil or cM == Enum.HumanoidStateType.Seated) or false
						local cP = cL and cL.SeatPart or nil
						if not cO and cN ~= cj.localTryOnLastSwimming then
							cj.localTryOnLastSwimming = cN
							cj.localTryOnSwimTransitionActive = cN or cj.localTryOnGroundOffsetValid
							cj.localTryOnSwimTransitionStart = cj.currentVerticalOffset
							cj.localTryOnSwimTransitionStartedAt = os.clock()
						elseif cO then
							cj.localTryOnLastSwimming = cN
							cj.localTryOnSwimTransitionActive = false
						end
						if cH then
							cH()
						end
						local cQ = cj.currentVerticalOffset
						if cO then
							if (cj.localTryOnPositionMode ~= 'Seat' and not cj.localTryOnSeatCalibrationPending) or cj.localTryOnSeatPart ~= cP then
								cj.localTryOnPositionMode = 'SeatCalibration'
								cj.localTryOnGroundCalibrationFrames = 0
								cj.localTryOnSeatPart = cP
								cj.localTryOnSeatedHipOffsetValid = false
								cj.localTryOnSeatTransitionActive = false
								if not cj.localTryOnSeatCalibrationPending then
									cj.scheduleSeatHipCalibrationAfterHeartbeat(cu, cj.localTryOnModel, cL, cP, cj.localTryOnGroundOffset)
								end
							end
							if cj.localTryOnSeatedHipOffsetValid then
								if not cj.localTryOnSeatTransitionActive then
									cj.localTryOnSeatTransitionActive = true
									cj.localTryOnSeatTransitionStartLocal = cK.CFrame:VectorToObjectSpace(cj.currentVerticalOffset)
									cj.localTryOnSeatTransitionStartedAt = os.clock()
								end
								local cR = math.clamp((os.clock() - cj.localTryOnSeatTransitionStartedAt) / 0.16, 0, 1)
								local cT = cR * cR * (3 - 2 * cR)
								local cU = cj.localTryOnSeatTransitionStartLocal:Lerp(cj.localTryOnSeatedHipOffsetLocal, cT)
								cQ = cK.CFrame:VectorToWorldSpace(cU)
							else
								cQ = cj.currentVerticalOffset
							end
						else
							if cj.localTryOnPositionMode == 'Seat' or cj.localTryOnPositionMode == 'SeatCalibration' then
								cj.localTryOnSeatCalibrationToken = cj.localTryOnSeatCalibrationToken + 1
								cj.localTryOnSeatCalibrationPending = false
								cj.localTryOnSeatPart = nil
								cj.localTryOnSeatedHipOffsetValid = false
								cj.localTryOnSeatTransitionActive = false
								cj.localTryOnSeatTransitionStartLocal = Vector3.zero
								cj.localTryOnSeatTransitionStartedAt = 0
								if cj.localTryOnGroundOffsetValid then
									cj.localTryOnPositionMode = 'Ground'
									cj.localTryOnGroundCalibrationFrames = 0
									cQ = cN and cj.localTryOnSwimOffset or cj.localTryOnGroundOffset
								else
									cj.localTryOnPositionMode = 'GroundCalibration'
									cj.localTryOnGroundCalibrationFrames = 2
								end
							end
							if cj.localTryOnPositionMode == 'GroundCalibration' then
								if not cN and cj.isGroundPlacementState(cM) then
									if not cj.isPlayerSitAnimationCleared(cu) then
										cj.localTryOnGroundCalibrationFrames = 2
									elseif cj.localTryOnGroundCalibrationFrames > 0 then
										cj.localTryOnGroundCalibrationFrames = cj.localTryOnGroundCalibrationFrames - 1
									end
									if cj.localTryOnGroundCalibrationFrames == 0 and cj.isPlayerSitAnimationCleared(cu) then
										local cR = cj.calculateGroundOffsetFromNeutralCloneFeet(cu, cK)
										if cR then
											cj.localTryOnGroundOffset = cR
