					return slap * 1.4 + bub + d + hi * env(t, 0.001, 0.015) * 0.2
				end), 0.7
			end
			SND.grit = function ()
				local bp = svf()
				return render(0.5, function (t)
					local _u, s = bp(nrand(), 3400, 1.8)
					local crackle = (nrand() > 0.93) and nrand() * 1.8 or 0
					local a = env(t, 0.01, 0.12) * (0.6 + 0.4 * sin(TAU * 23 * t))
					return (s + crackle) * a
				end), 0.6
			end
			local SND_ORDER = {'whoosh', 'puff', 'thump', 'impact', 'heart', 'shutter', 'wind', 'breath', 'slap', 'grit', 'ring'}
			local LOOPS = {wind = true}
			local function imgId(name)
				local rel = JX.pick and JX.pick({'images/camfx_' .. name .. '.png', 'images/jh_camfx_' .. name .. '.png'})
				return rel and JX.id(rel) or nil
			end
			function AS.register(name)
				local ids = JX.soundIds and JX.soundIds('camfx_' .. name) or {}
				if #ids == 0 or not _.def then
					return
				end
				local slot = 'jhfx_' .. name
				local seam = nil
				if LOOPS[name] then
					seam = {}
					for _k, id in ipairs(ids) do
						seam[id] = true
					end
				end
				_.def(slot, {cat = 'vfx', src = ids, vol = 1, cap = 1, poly = (name == 'thump' or name == 'puff' or name == 'slap') and 4 or 2, att = 0.003, loop = LOOPS[name] or nil, seam = seam, len = {0.01, 60}})
				_.whenReady(slot, function ()
					AS.snd[name] = slot
				end)
			end
			local canBuild = fs and fs.ok and JX.canAsset and JX.png and JX.wav
			local stale = P.assetVer ~= ASSET_VER
			local function buildImg(name)
				local rel = 'images/jh_camfx_' .. name .. '.png'
				if stale or not fs.exists(fs.path(rel)) then
					local spec = IMG[name]
					local paint = spec[3]
					local ok, data = pcall(JX.png, spec[1], spec[2], function (x, py)
						slice()
						return paint(x, py)
					end)
					if ok and data then
						fs.write(fs.path(rel), data)
						JX.forget(rel)
					end
				end
				AS.img[name] = imgId(name)
			end
			local function buildSnd(name)
				local rel = 'sounds/jh_camfx_' .. name .. '.wav'
				if stale or not fs.exists(fs.path(rel)) then
					local ok, samples, gain = pcall(SND[name])
					if ok and samples then
						local okW, data = pcall(JX.wav, samples, gain)
						if okW and data then
							fs.write(fs.path(rel), data)
							JX.forget(rel)
							for _k, ext in ipairs({'mp3', 'ogg'}) do
								local alt = 'sounds/jh_camfx_' .. name .. '_pcm.' .. ext
								fs.write(fs.path(alt), data)
								JX.forget(alt)
							end
						end
					elseif not ok then
						warn('[JEYHUB] Cutscene FX sound ' .. name .. ':', samples)
					end
				end
				pcall(AS.register, name)
			end
			local running = false
			local function worker()
				local wait = AS.notBefore - os.clock()
				if wait > 0 then
					task.wait(wait)
				end
				while #AS.queue > 0 and not CS.tornDown and y() do
					local job = table.remove(AS.queue, 1)
					budget, count = os.clock(), 0
					local ok, err = pcall((job.kind == 'img') and buildImg or buildSnd, job.name)
					if not ok then
						warn('[JEYHUB] Cutscene FX asset ' .. job.name .. ':', err)
					end
					AS.state[job.key] = 'done'
					task.wait()
				end
				running = false
				if stale and #AS.queue == 0 and P.assetVer ~= ASSET_VER then
					P.assetVer = ASSET_VER
					save()
				end
			end
			function AS.want(kind, name)
				local key = kind .. ':' .. name
				if AS.state[key] then
					return
				end
				local spec = (kind == 'img') and IMG[name] or ((kind == 'snd') and SND[name] or nil)
				if not (canBuild and spec) then
					AS.state[key] = 'done'
					return
				end
				AS.state[key] = 'queued'
				AS.queue[#AS.queue + 1] = {kind = kind, name = name, key = key}
				if not running then
					running = true
					task.spawn(worker)
				end
			end
			local USES = {
				whoosh = {'tp', 'respawn', 'spec', 'bigJump'}, thump = {'tp', 'death', 'downwash', 'phase', 'bigJump', 'hit'},
				heart = {'death', 'respawn', 'lowHp'}, breath = {'respawn'}, wind = {'speed', 'flight'}, ring = {'muffle'},
				shutter = {'snap'}, puff = {'downwash', 'airJump', 'bigJump'}, impact = {'bigJump'},
				slap = {'tpDust', 'ripples', 'downwash', 'bigJump'}, grit = {'climb'},
			}
			function AS.build()
				for _k, name in ipairs(SND_ORDER) do
					for _j, key in ipairs(USES[name] or {}) do
						if P[key] then
							AS.want('snd', name)
							break
						end
					end
				end
			end
		end
		local FALLBACK = {whoosh = {'whoosh', 1, 0.9}, puff = {'whoosh', 1.6, 0.5}, thump = {'impact', 0.8, 0.9}, impact = {'impact', 0.6, 1.1}, heart = {'impact', 0.55, 0.7}, shutter = {'ui_tick', 1.3, 0.9}, slap = {'splash', 1.2, 0.7}}
		function sfx(name, vol, speed, delay)
			vol = (vol or 1) * P.svol / 100
			if vol <= 0.001 then
				return
			end
			local slot = AS.snd[name]
			if slot then
				pcall(_.play, slot, vol, speed or 1, delay)
				return
			end
			AS.want('snd', name)
			local fb = FALLBACK[name]
			if fb and _.slots and _.slots[fb[1]] then
				pcall(_.play, fb[1], vol * fb[3], (speed or 1) * fb[2], delay)
			end
		end
		CS.sfx = sfx
		local WL = {h = nil, slot = nil, v = 0, s = 1}
		local function windSet(vol, speed)
			local slot = AS.snd.wind or (_.slots and _.slots.rush and 'rush') or nil
			if not slot or (vol <= 0 and not WL.h) then
				return
			end
			if WL.slot ~= slot then
				if WL.h then
					WL.h.destroy()
				end
				WL.h, WL.slot, WL.v = _.loop(slot), slot, -1
			end
			if abs(vol - WL.v) > 0.02 or (vol == 0 and WL.v ~= 0) then
				local fade = (vol > WL.v) and 0.35 or 0.6
				WL.v = vol
				WL.h:set(vol, fade)
			end
			if abs(speed - WL.s) > 0.02 then
				WL.s = speed
				WL.h:speed(speed, 0.3)
			end
		end
		function windLoop(vol, speed)
			if vol <= 0 and not WL.h then
				return
			end
			if vol > 0 and not AS.snd.wind then
				AS.want('snd', 'wind')
			end
			pcall(windSet, clamp(vol * P.svol / 100, 0, 1.2), speed)
		end
		function CS.windOff()
			pcall(function ()
				if WL.h then
					WL.h.destroy()
				end
				WL.h, WL.slot, WL.v = nil, nil, 0
			end)
		end
	end

	local OUT, resetOut, addVig, addTint, wantDof, applyOut, UI, kp, txt
	do
		local Lighting = A('Lighting')
		OUT = {}
		function resetOut()
			OUT.bright, OUT.contrast, OUT.sat = 0, 0, 0
			OUT.tr, OUT.tg, OUT.tb = 1, 1, 1
			OUT.blur, OUT.vig, OUT.fade, OUT.flash, OUT.fov, OUT.muffle, OUT.bars = 0, 0, 0, 0, 0, 0, 0
			OUT.dofW, OUT.dofFocus, OUT.dofRad, OUT.dofFar, OUT.dofNear = 0, 20, 10, 0, 0
			OUT.pitch, OUT.yaw, OUT.roll, OUT.posY, OUT.lag = 0, 0, 0, 0, ZERO
		end
		resetOut()
		function addVig(a)
			OUT.vig = 1 - (1 - OUT.vig) * (1 - clamp(a, 0, 1))
		end
		function addTint(c, w)
			OUT.tr = OUT.tr * (1 + (c.R - 1) * w)
			OUT.tg = OUT.tg * (1 + (c.G - 1) * w)
			OUT.tb = OUT.tb * (1 + (c.B - 1) * w)
		end
		function wantDof(w, focus, radius, far, near)
			if w > OUT.dofW then
				OUT.dofW, OUT.dofFocus, OUT.dofRad, OUT.dofFar, OUT.dofNear = w, focus, radius, far, near
			end
		end

		local FX = {}
		CS.fxInst = FX
		local function fxEnsure()
			local c = cam()
			if not c then
				return nil
			end
			if FX.cam ~= c or not (FX.cc and FX.cc.Parent == c and FX.blur and FX.blur.Parent == c and FX.dof and FX.dof.Parent == c) then
				for _k, k in ipairs({'cc', 'blur', 'dof'}) do
					if FX[k] then
						pcall(function ()
							FX[k]:Destroy()
						end)
					end
				end
				FX.cc = aY('ColorCorrectionEffect', {Name = 'JH_CamFX_Grade', Enabled = false, Parent = c})
				FX.blur = aY('BlurEffect', {Name = 'JH_CamFX_Blur', Enabled = false, Size = 0, Parent = c})
				FX.dof = aY('DepthOfFieldEffect', {Name = 'JH_CamFX_DOF', Enabled = false, FarIntensity = 0, NearIntensity = 0, FocusDistance = 20, InFocusRadius = 10, Parent = c})
				FX.cam = c
			end
			return FX
		end
		local DOFS = {claimed = false, list = {}}
		local function dofClaim(on)
			if on and not DOFS.claimed then
				DOFS.claimed = true
				DOFS.list = {}
				for _k, holder in ipairs({Lighting, cam()}) do
					pcall(function ()
						for _k, e in ipairs(holder:GetChildren()) do
