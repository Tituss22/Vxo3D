		local function setVis(o, v)
			if o.Visible ~= v then
				o.Visible = v
			end
		end
		local OV = {bars = 0, lt = 0, vf = 0}
		CS.ov = OV
		local LIVE = {fx = false, ui = false}
		function applyOut(dt)
			local k = P.screen / 100 * P.intensity / 100
			local b, c, s = OUT.bright * k, OUT.contrast * k, clamp(OUT.sat * k, -1, 1)
			local tr, tg, tb = 1 + (OUT.tr - 1) * k, 1 + (OUT.tg - 1) * k, 1 + (OUT.tb - 1) * k
			local gradeOn = abs(b) > 0.002 or abs(c) > 0.002 or abs(s) > 0.002 or abs(tr - 1) + abs(tg - 1) + abs(tb - 1) > 0.004
			local bl = min(OUT.blur * k, 24)
			local dw = OUT.dofW * min(k, 1.2)
			local fxWant = gradeOn or bl > 0.15 or dw > 0.01
			if fxWant or LIVE.fx then
				local fx = fxEnsure()
				if fx then
					if fx.cc.Enabled ~= gradeOn then
						fx.cc.Enabled = gradeOn
					end
					if gradeOn then
						fx.cc.Brightness, fx.cc.Contrast, fx.cc.Saturation = b, c, s
						fx.cc.TintColor = Color3.new(clamp(tr, 0, 1), clamp(tg, 0, 1), clamp(tb, 0, 1))
					end
					if fx.blur.Enabled ~= (bl > 0.15) then
						fx.blur.Enabled = bl > 0.15
					end
					if bl > 0.15 then
						fx.blur.Size = bl
					end
					if dw > 0.01 then
						dofClaim(true)
						fx.dof.FocusDistance = clamp(OUT.dofFocus, 0, 200)
						fx.dof.InFocusRadius = clamp(OUT.dofRad, 0.5, 50)
						fx.dof.FarIntensity = clamp(OUT.dofFar * dw, 0, 1)
						fx.dof.NearIntensity = clamp(OUT.dofNear * dw, 0, 1)
						if not fx.dof.Enabled then
							fx.dof.Enabled = true
						end
					elseif fx.dof.Enabled then
						fx.dof.Enabled = false
						dofClaim(false)
					end
				end
				LIVE.fx = fxWant
			end
			muffle(P.muffle and OUT.muffle > 0.5)
			OV.bars = OV.bars + (OUT.bars - OV.bars) * (1 - exp(-dt * 5))
			if OUT.bars <= 0 and OV.bars < 0.002 then
				OV.bars = 0
			end
			local v = clamp(OUT.vig * k, 0, 1)
			local fl = clamp(OUT.flash * k, 0, 1)
			local fd = clamp(OUT.fade, 0, 1)
			local show = v > 0.005 or fl > 0.004 or fd > 0.004 or OV.bars > 0 or OV.lt > 0.01 or OV.vf > 0.01
			if not (show or LIVE.ui) then
				return
			end
			local ui = UI
			if show and not (ui and ui.gui.Parent) then
				ui = CS.gui()
			end
			LIVE.ui = show and ui ~= nil
			if not ui then
				return
			end
			local img = nil
			if v > 0.005 then
				img = AS.img.vig
				if not img then
					AS.want('img', 'vig')
				elseif ui.vig.Image ~= img then
					ui.vig.Image = img
				end
			end
			setVis(ui.vig, img ~= nil)
			if img then
				ui.vig.ImageTransparency = 1 - v
			end
			local soft = v > 0.005 and not img
			for _k, f in ipairs(ui.vigFb) do
				setVis(f, soft)
				if soft then
					f.BackgroundTransparency = 1 - v * 0.85
				end
			end
			setVis(ui.flash, fl > 0.004)
			if fl > 0.004 then
				ui.flash.BackgroundTransparency = 1 - fl
			end
			setVis(ui.fade, fd > 0.004)
			if fd > 0.004 then
				ui.fade.BackgroundTransparency = 1 - fd
			end
			local bh = 0
			if OV.bars > 0 then
				local cm = cam()
				local vp = cm and cm.ViewportSize or V2(1280, 720)
				bh = floor(clamp((vp.Y - vp.X / 2.39) / 2, 0, vp.Y * 0.12) * OV.bars + 0.5)
			end
			if ui.bh ~= bh then
				ui.bh = bh
				setVis(ui.barT, bh > 0)
				setVis(ui.barB, bh > 0)
				ui.barT.Size = U2(1, 0, 0, bh)
				ui.barB.Size = U2(1, 0, 0, bh)
				ui.lt.Position = U2(0, 28, 1, -(bh + 26))
			end
			setVis(ui.lt, OV.lt > 0.01)
			if OV.lt > 0.01 and ui.ltA ~= OV.lt then
				ui.ltA = OV.lt
				ui.lt.GroupTransparency = 1 - OV.lt
			end
			setVis(ui.vf, OV.vf > 0.01)
			if OV.vf > 0.01 and ui.vfA ~= OV.vf then
				ui.vfA = OV.vf
				ui.vf.GroupTransparency = 1 - OV.vf
			end
		end
	end

	local groundAt, dustColor, aimCF, burst, ripple, wfxStep, wfxClear
	do
		local Terrain = workspace:FindFirstChildOfClass('Terrain')
		local M = Enum.Material
		local DUSTY = {
			[M.Sand] = 1, [M.Ground] = 1, [M.Mud] = 0.9, [M.Snow] = 1, [M.Grass] = 0.75, [M.LeafyGrass] = 0.75,
			[M.Salt] = 1, [M.Sandstone] = 0.9, [M.Limestone] = 0.85, [M.Concrete] = 0.7, [M.Slate] = 0.6,
			[M.Rock] = 0.6, [M.Basalt] = 0.6, [M.CrackedLava] = 0.6, [M.Pavement] = 0.55, [M.Asphalt] = 0.5,
			[M.Brick] = 0.6, [M.Cobblestone] = 0.6, [M.Wood] = 0.4, [M.WoodPlanks] = 0.4, [M.Fabric] = 0.3,
			[M.Plastic] = 0.35, [M.SmoothPlastic] = 0.3, [M.Granite] = 0.5, [M.Marble] = 0.35, [M.Pebble] = 0.7,
		}
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.IgnoreWater = false
		local W = {folder = nil, pools = {}, anims = {}, ripples = {}}
		CS.wfx = W
		local function folder()
			if W.folder and W.folder.Parent then
				return W.folder
			end
			W.folder = aY('Folder', {Name = 'JH_CamFX', Parent = cam() or workspace})
			W.pools, W.ripples = {}, {}
			return W.folder
		end
		CS.wfxFolder = folder
		local PLATFORM = {_GroundCollider = true, _WaterCollider = true}
		function groundAt(origin, dir, extra)
			local ex = {W.folder, LP and LP.Character}
			if extra then
				ex[#ex + 1] = extra
			end
			local hit = nil
			for _k = 1, 3 do
				params.FilterDescendantsInstances = ex
				hit = workspace:Raycast(origin, dir, params)
				if not (hit and hit.Instance and PLATFORM[hit.Instance.Name]) then
					break
				end
				ex[#ex + 1] = hit.Instance
				hit = nil
			end
			if not hit then
				return nil
			end
			local col = WHITE
			local inst = hit.Instance
			if inst == Terrain then
				pcall(function ()
					col = Terrain:GetMaterialColor(hit.Material)
				end)
			elseif inst and inst:IsA('BasePart') then
				col = inst.Color or WHITE
			end
			return {pos = hit.Position, normal = hit.Normal, mat = hit.Material, color = col, inst = inst, dust = DUSTY[hit.Material] or 0, water = hit.Material == M.Water}
		end
		function aimCF(p, dir)
			local d = dir.Unit
			if d.Y > 0.999 then
				return CFrame.new(p)
			elseif d.Y < -0.999 then
				return CFrame.new(p) * CFrame.Angles(PI, 0, 0)
			end
			return lookAt(p, p + d) * CFrame.Angles(-PI / 2, 0, 0)
		end
		local HAZE = C3(196, 186, 170)
		function dustColor(g)
			if not g then
				return HAZE
			end
			if g.mat == M.Snow or g.mat == M.Glacier or g.mat == M.Salt then
				return C3(242, 244, 248)
			end
			return g.color:Lerp(HAZE, 0.45)
		end
		local TEX = {dust = 'rbxasset://textures/particles/smoke_main.dds', mist = 'rbxasset://textures/particles/smoke_main.dds', drop = 'rbxasset://textures/particles/sparkles_main.dds', grit = 'rbxasset://textures/particles/sparkles_main.dds'}
		local function texFor(kind)
			if kind == 'grit' then
				return TEX.grit
			end
			local name = (kind == 'drop') and 'drop' or 'dust'
			local img = AS.img[name]
			if not img then
				AS.want('img', name)
			end
			return img or TEX[kind]
		end
		local function emitter(kind, life)
			local pool = W.pools[kind]
			if not pool then
				pool = {}
				W.pools[kind] = pool
			end
			local now = os.clock()
			for _k, e in ipairs(pool) do
				if e.part.Parent and now - e.used > e.life + 0.15 then
					e.used, e.life = now, life
					return e
				end
			end
			if #pool >= 8 then
				local oldest = pool[1]
				for _k, e in ipairs(pool) do
					if e.used < oldest.used then
						oldest = e
					end
				end
				oldest.used, oldest.life = now, life
				return oldest
			end
			local part = aY('Part', {Name = 'Emitter', Anchored = true, CanCollide = false, CanTouch = false, CastShadow = false, Transparency = 1, Size = V3(0.6, 0.1, 0.6), Parent = folder()})
			pcall(function ()
				part.CanQuery = false
			end)
			local em = aY('ParticleEmitter', {Rate = 0, LightInfluence = 1, LightEmission = 0, Parent = part})
			local e = {part = part, em = em, used = now, life = life}
			pool[#pool + 1] = e
			return e
		end
		local BANK = {left = 240, at = os.clock()}
		function burst(pos, o)
			local q = GENV and GENV.JH_VFXQ
			local amt = (type(q) == 'table' and tonumber(q.amt)) or 1
			local now = os.clock()
			BANK.left = min(240, BANK.left + (now - BANK.at) * 240)
			BANK.at = now
			local n = min(floor((o.n or 8) * amt * P.intensity / 100 + 0.5), floor(BANK.left))
			if n < 1 then
				return
			end
			BANK.left = BANK.left - n
			local life = o.life or {0.8, 1.4}
			local e = emitter(o.kind or 'dust', life[2])
			local em = e.em
			e.part.CFrame = o.cf or CFrame.new(pos)
			em.Texture = texFor(o.kind or 'dust')
			em.Color = ColorSequence.new(o.color or WHITE)
			local sz = o.size or {0.8, 3}
			em.Size = NumberSequence.new({kp(0, sz[1]), kp(1, sz[2])})
			local tr = o.trans or {0.55, 1}
			em.Transparency = NumberSequence.new({kp(0, tr[1]), kp(0.6, tr[1] + (tr[2] - tr[1]) * 0.45), kp(1, tr[2])})
			em.Lifetime = NumberRange.new(life[1], life[2])
			local sp = o.speed or {2, 6}
			em.Speed = NumberRange.new(sp[1], sp[2])
			em.Drag = o.drag or 3
			em.Acceleration = o.accel or V3(0, 0.6, 0)
			em.Rotation = NumberRange.new(0, 360)
			em.RotSpeed = NumberRange.new(-(o.rot or 40), o.rot or 40)
			em.LightInfluence = o.lit or 1
			em.EmissionDirection = Enum.NormalId.Top
			local ringOk = false
			if o.ring then
				ringOk = pcall(function ()
					em.Shape = Enum.ParticleEmitterShape.Cylinder
					em.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
					em.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
				end)
				e.part.Size = V3(o.ring, 0.1, o.ring)
			else
				pcall(function ()
					em.Shape = Enum.ParticleEmitterShape.Box
					em.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
					em.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
				end)
				e.part.Size = V3(o.box or 0.6, 0.1, o.box or 0.6)
			end
			local spread = o.spread or V2(25, 25)
			if o.ring and not ringOk then
				spread = V2(80, 80)
			end
			em.SpreadAngle = spread
			pcall(function ()
				em:Emit(n)
			end)
		end
		function ripple(pos, r0, r1, dur, alpha)
			if not AS.img.ripple then
				AS.want('img', 'ripple')
				return
			end
			local rp = nil
			for _k, r in ipairs(W.ripples) do
				if not r.busy and r.part.Parent then
					rp = r
					break
				end
			end
			if not rp then
				if #W.ripples >= 24 then
					return
				end
				local part = aY('Part', {Name = 'Ripple', Anchored = true, CanCollide = false, CanTouch = false, CastShadow = false, Transparency = 1, Size = V3(1, 0.05, 1), Parent = folder()})
				pcall(function ()
					part.CanQuery = false
				end)
				local dec = aY('Decal', {Face = Enum.NormalId.Top, Texture = AS.img.ripple, Transparency = 1, Parent = part})
				rp = {part = part, dec = dec}
				W.ripples[#W.ripples + 1] = rp
			end
			rp.busy = true
			rp.dec.Texture = AS.img.ripple
			local base = CFrame.new(pos + V3(0, 0.03, 0)) * CFrame.Angles(0, rnd(0, TAU), 0)
			rp.part.Size = V3(r0 * 2, 0.05, r0 * 2)
			rp.part.CFrame = base
			W.anims[#W.anims + 1] = {t = 0, dur = dur, upd = function (u)
				local e = easeOut(u)
				local r = r0 + (r1 - r0) * e
				rp.part.Size = V3(r * 2, 0.05, r * 2)
				rp.dec.Transparency = 1 - alpha * (1 - u) ^ 1.3
			end, done = function ()
				rp.dec.Transparency = 1
				rp.busy = false
			end}
		end
		function wfxStep(dt)
			local list = W.anims
			for i = #list, 1, -1 do
				local a = list[i]
				a.t = a.t + dt
				local u = a.t / a.dur
				if u >= 1 then
					pcall(a.done)
					table.remove(list, i)
				else
					local ok = pcall(a.upd, u)
					if not ok then
						pcall(a.done)
						table.remove(list, i)
					end
				end
			end
		end
		function wfxClear()
			for _k, a in ipairs(W.anims) do
				pcall(a.done)
			end
			W.anims = {}
			if W.folder then
				pcall(function ()
					W.folder:Destroy()
				end)
			end
			W.folder, W.pools, W.ripples = nil, {}, {}
		end
	end

	local RIG, motionK, addTrauma, kickCam, setOverride, rigStep, rigRestore, rigLate
	do
		RIG = {trauma = 0, kp = {x = 0, v = 0}, ky = {x = 0, v = 0}, kr = {x = 0, v = 0}, kz = {x = 0, v = 0}, kf = {x = 0, v = 0}, ovr = nil, filter = nil, applied = false, cam = nil, baseCF = nil, baseFov = 70, setCF = nil, setFov = nil, lastFinal = nil, lastFov = 70}
		CS.rig = RIG
		function motionK()
			local k = P.intensity / 100
			if P.reduce and aI._reducedMotion then
				k = k * 0.45
			end
			return k
		end
		function addTrauma(a)
			RIG.trauma = min(1, RIG.trauma + a)
		end
		function kickCam(pitch, yaw, roll, dip, fov)
			RIG.kp.v = RIG.kp.v + rad(pitch or 0) * 12
			RIG.ky.v = RIG.ky.v + rad(yaw or 0) * 12
			RIG.kr.v = RIG.kr.v + rad(roll or 0) * 11
			RIG.kz.v = RIG.kz.v + (dip or 0) * 10
			RIG.kf.v = RIG.kf.v + (fov or 0) * 7.5
		end
		function setOverride(o)
			local old = RIG.ovr
			RIG.ovr = o
			if old and old ~= o and old.finish then
				pcall(old.finish, old)
			end
		end
		function rigStep(c, dt, now)
			local base, baseFov = c.CFrame, c.FieldOfView
			RIG.cam, RIG.baseCF, RIG.baseFov = c, base, baseFov
			RIG.setCF, RIG.setFov = nil, nil
			if c.CameraType == Enum.CameraType.Scriptable then
				if RIG.ovr then
					setOverride(nil)
				end
				RIG.lastFinal, RIG.lastFov = base, baseFov
				return
			end
			local cf, fovAdd = base, 0
			local ov = RIG.ovr
			if ov then
				local ok, ocf, ofov, done = pcall(ov.step, ov, dt, base, baseFov, now)
				if ok and ocf then
					cf = ocf
					fovAdd = ofov or 0
				elseif not ok then
					warn('[JEYHUB] Cutscene FX shot:', ocf)
				end
				if (not ok or done) and RIG.ovr == ov then
					setOverride(nil)
				end
			elseif RIG.filter then
				local ok, fcf = pcall(RIG.filter, base, dt, now)
				if ok and fcf then
					cf = fcf
				end
			end
			local mk = motionK()
			local sk = mk * P.shake / 100
			local fk = mk * P.fovAmt / 100
			local p = kick(RIG.kp, dt, 170, 0.42)
			local yw = kick(RIG.ky, dt, 170, 0.42)
			local rl = kick(RIG.kr, dt, 150, 0.4)
			local dz = kick(RIG.kz, dt, 120, 0.5)
			local df = kick(RIG.kf, dt, 70, 0.6)
			RIG.trauma = max(0, RIG.trauma - dt * 1.4)
			local s2 = RIG.trauma * RIG.trauma
			local np, ny, nr = 0, 0, 0
			if s2 > 1e-6 then
				np, ny, nr = nz(now * 23, 1.7) * s2 * 0.055, nz(now * 21, 5.3) * s2 * 0.05, nz(now * 17, 9.1) * s2 * 0.065
			end
			local pitch = (np + p) * sk + OUT.pitch * mk
			local yaw = (ny + yw) * sk + OUT.yaw * mk
			local roll = (nr + rl) * sk + OUT.roll * mk
			local lift = dz * sk + OUT.posY * mk
			if abs(pitch) + abs(yaw) + abs(roll) > 1e-5 or abs(lift) > 1e-4 then
				cf = cf * CFrame.new(0, lift, 0) * CFrame.Angles(0, 0, roll) * CFrame.Angles(pitch, yaw, 0)
			end
			if OUT.lag.Magnitude > 1e-3 then
				cf = cf + OUT.lag * mk
			end
			local fov = clamp(baseFov + (fovAdd + OUT.fov + df) * fk, 5, 115)
			if cf ~= base and not nearCF(cf, base) then
				c.CFrame = cf
				RIG.setCF = cf
				RIG.applied = true
			end
			if abs(fov - baseFov) > 0.01 then
				c.FieldOfView = fov
				RIG.setFov = fov
				RIG.applied = true
			end
			RIG.lastFinal, RIG.lastFov = cf, fov
		end
		function rigRestore()
			if not RIG.applied then
				return
			end
			RIG.applied = false
			local c = cam()
			if not c or c ~= RIG.cam then
				return
			end
			pcall(function ()
				if RIG.setCF and nearCF(c.CFrame, RIG.setCF) then
					c.CFrame = RIG.baseCF
				end
				if RIG.setFov and abs(c.FieldOfView - RIG.setFov) < 0.02 then
					c.FieldOfView = RIG.baseFov
				end
			end)
		end
		function rigLate()
			if not (RIG.ovr and RIG.setCF) then
				return
			end
			local c = cam()
			if c and c == RIG.cam and not nearCF(c.CFrame, RIG.setCF) then
				c.CFrame = RIG.setCF
				RIG.applied = true
			end
		end
	end

	local addFx, cancelFx, fxStep, fxBusy
	do
		local list = {}
		function cancelFx(key)
			for i = #list, 1, -1 do
				local f = list[i]
				if f.key == key then
					table.remove(list, i)
					if f.onEnd then
						pcall(f.onEnd)
					end
				end
			end
		end
		function addFx(dur, step, key, onEnd)
			if key then
				cancelFx(key)
			end
			list[#list + 1] = {t = 0, dur = dur, step = step, key = key, onEnd = onEnd}
		end
		function fxStep(dt)
			for i = #list, 1, -1 do
				local f = list[i]
				f.t = f.t + dt
				local done = f.t >= f.dur
				if not done then
					local ok, err = pcall(f.step, f, f.t / f.dur, f.t)
					if not ok then
						done = true
						warn('[JEYHUB] Cutscene FX:', err)
					end
				end
				if done then
					table.remove(list, i)
					if f.onEnd then
						pcall(f.onEnd)
					end
				end
			end
		end
		function fxBusy()
			return #list > 0
		end
	end

	local ME, F, meStep
	do
		ME = {char = nil, hum = nil, root = nil, head = nil, pos = nil, lastPos = nil, vel = ZERO, lastVel = ZERO, hs = 0, vy = 0, grounded = true, minVy = 0, seated = false, hp = 100, maxHp = 100, dead = false, first = true, conns = {}, pendingSpawn = nil, jumpWatch = nil}
		F = {fly = false, noclip = false, infjump = false, spider = false, ext = false, extScan = false}
		CS.me, CS.flags = ME, F
		local function disconnect()
			for _k, c in ipairs(ME.conns) do
				pcall(function ()
					c:Disconnect()
				end)
			end
			ME.conns = {}
		end
		CS.meDisconnect = disconnect
		local function bindChar(char)
			disconnect()
			ME.char, ME.hum, ME.root, ME.head = char, nil, nil, nil
			ME.lastPos, ME.dead, ME.minVy, ME.jumpWatch, ME.grounded = nil, false, 0, nil, true
			if not char then
				return
			end
			if ME.first then
				ME.first = false
			else
				ME.pendingSpawn = {char = char, t = os.clock()}
			end
		end
		local function hookHum(hum)
			ME.hum = hum
			ME.hp, ME.maxHp = hum.Health, max(hum.MaxHealth, 1)
			ME.conns[#ME.conns + 1] = hum.Died:Connect(function ()
				if CS.onDied then
					pcall(CS.onDied)
				end
			end)
			ME.conns[#ME.conns + 1] = hum.StateChanged:Connect(function (old, new)
				if CS.onState then
					pcall(CS.onState, old, new)
				end
			end)
			ME.conns[#ME.conns + 1] = hum.HealthChanged:Connect(function (h)
				local was = ME.hp
				ME.hp, ME.maxHp = h, max(hum.MaxHealth, 1)
				if CS.onHealth then
					pcall(CS.onHealth, was, h)
				end
			end)
		end
		local scan = 0
		local function extFly(root, hum)
			scan = scan - 1
			if scan <= 0 then
				scan = 15
				local found = false
				for _k, o in ipairs(root:GetChildren()) do
					if (o:IsA('BodyVelocity') or o:IsA('BodyGyro') or o:IsA('LinearVelocity') or o:IsA('AlignPosition') or o:IsA('BodyPosition')) and not o.Name:find('JH_') then
						found = true
						break
					end
				end
				F.extScan = found
			end
			return hum.FloorMaterial == Enum.Material.Air and (F.extScan or (hum.PlatformStand and abs(root.AssemblyLinearVelocity.Y) < 20))
		end
		function meStep(dt, rawDt)
			local char = LP and LP.Character
			if char ~= ME.char then
				bindChar(char)
			end
			if not char then
				return false
			end
			local hum = ME.hum
			if not (hum and hum.Parent == char) then
				hum = char:FindFirstChildOfClass('Humanoid')
				if not hum then
					return false
				end
				disconnect()
				hookHum(hum)
			end
			local root = ME.root
			if not (root and root.Parent == char) then
				root = char:FindFirstChild('HumanoidRootPart') or char.PrimaryPart
				ME.root = root
				if not root then
					return false
				end
			end
			if not (ME.head and ME.head.Parent == char) then
				ME.head = char:FindFirstChild('Head')
			end
			local g = GENV
			if type(g) == 'table' then
				F.fly = (g.JH_FLYING or g.JH_AIRSWIM) and true or false
				F.noclip = g.JH_NOCLIP and true or false
				F.infjump = g.JH_INFJUMP and true or false
				F.spider = g.JH_SPIDER and true or false
			end
			F.ext = (not F.fly) and (P.flight or P.downwash) and extFly(root, hum) or false
			local pos = root.Position
			local vel = root.AssemblyLinearVelocity
			ME.lastVel, ME.vel = ME.vel, vel
			ME.hs = V3(vel.X, 0, vel.Z).Magnitude
			ME.vy = vel.Y
			ME.seated = hum.Sit or hum.SeatPart ~= nil
			if hum.Health <= 0 and not ME.dead and CS.onDied then
				pcall(CS.onDied)
			end
			local grounded = hum.FloorMaterial ~= Enum.Material.Air
			if not grounded then
				ME.minVy = min(ME.minVy, vel.Y)
			elseif not ME.grounded then
				local impact = -ME.minVy
				ME.minVy = 0
				if CS.onLanded then
					pcall(CS.onLanded, impact)
				end
			end
			ME.grounded = grounded
			if ME.lastPos and not ME.pendingSpawn then
				local d = (pos - ME.lastPos).Magnitude
				local tp = CS.tpPending
				if tp and os.clock() - tp.t < 1 and d > 2 then
					CS.tpPending = nil
					if CS.onTeleport then
						pcall(CS.onTeleport, ME.lastPos, pos, tp.kind)
					end
				elseif d > max(28, vel.Magnitude * (rawDt or dt) * 3 + 10) and not ME.seated then
					if CS.onTeleport then
						pcall(CS.onTeleport, ME.lastPos, pos, 'world')
					end
				end
			end
			if CS.tpPending and os.clock() - CS.tpPending.t > 1 then
				CS.tpPending = nil
			end
			ME.lastPos, ME.pos = pos, pos
			local jw = ME.jumpWatch
			if jw then
				jw.t = jw.t + dt
				jw.peak = max(jw.peak, vel.Y)
				if jw.t > 0.12 then
					ME.jumpWatch = nil
					if jw.peak > 72 and CS.onSuperJump then
						pcall(CS.onSuperJump, jw.peak)
					end
				end
			end
			local ps = ME.pendingSpawn
			if ps then
				if hum.Health > 0 then
					ME.pendingSpawn = nil
					if CS.onRespawn then
						pcall(CS.onRespawn, char)
					end
				elseif os.clock() - ps.t > 8 then
					ME.pendingSpawn = nil
				end
			end
			return true
		end
	end

	local glideShot, whipShot, flashCut, arrival
	do
		function glideShot(A, dur, arcK, kind)
			local o = {kind = kind or 'glide', t = 0, dur = dur, A = A, arcK = arcK or 0.16, last = nil}
			function o.step(self, dt, base)
				self.t = self.t + dt
				local u = clamp(self.t / self.dur, 0, 1)
				local e = smoother(u)
				local Ap, Bp = self.A.Position, base.Position
				local h = clamp((Bp - Ap).Magnitude * self.arcK, 1.5, 90)
				local pos = Ap:Lerp(Bp, e) + UP * (h * sin(PI * e))
				local focus = (ME.head and ME.head.Position) or (Bp + base.LookVector * 12)
				if (focus - pos).Magnitude < 0.5 then
					focus = pos + base.LookVector
				end
				local startR = self.A - Ap
				local midR = lookAt(pos, focus) - pos
				local endR = base - Bp
				local r = startR:Lerp(midR, smoother(u / 0.42)):Lerp(endR, smoother((u - 0.5) / 0.5))
				local cf = CFrame.new(pos) * r
				if self.last and P.grade then
					local ang = math.acos(clamp(self.last.LookVector:Dot(cf.LookVector), -1, 1)) / max(dt, 1e-3)
					local lin = (cf.Position - self.last.Position).Magnitude / max(dt, 1e-3)
					OUT.blur = OUT.blur + clamp(ang * 1.3 + lin * 0.01, 0, 6)
				end
				self.last = cf
				return cf, 7 * sin(PI * u) ^ 2, u >= 1
			end
			return o
		end
		function whipShot(A, dur, kind)
			local o = {kind = kind or 'whip', t = 0, dur = dur, A = A, side = (rnd(0, 1) < 0.5) and -1 or 1}
			function o.step(self, dt, base)
				self.t = self.t + dt
				local u = clamp(self.t / self.dur, 0, 1)
				local a = rad(95) * self.side
				local cf = nil
				if u < 0.5 then
					local k = (u / 0.5) ^ 2
					cf = self.A * CFrame.Angles(0, a * k, 0)
				else
					local k = 1 - (u - 0.5) / 0.5
					cf = base * CFrame.Angles(0, -a * k * k, 0)
				end
				if P.grade then
					OUT.blur = OUT.blur + 22 * (1 - abs(u - 0.5) * 2) ^ 2
				end
				return cf, 5 * sin(PI * u), u >= 1
			end
			return o
		end
		function flashCut(k)
			if P.grade then
				addFx(0.5, function (self, u)
					local f = (1 - u) ^ 2.2
					OUT.bright = OUT.bright + 0.2 * k * f
					OUT.contrast = OUT.contrast + 0.07 * k * f
					OUT.blur = OUT.blur + 13 * k * f
					OUT.flash = max(OUT.flash, 0.16 * k * (1 - u) ^ 6)
				end)
			end
			kickCam(-0.8 * k, 0, 0, 0, 6 * k)
			addTrauma(0.26 * k)
		end
		function arrival(pos, big)
			local g = groundAt(pos + V3(0, 1, 0), V3(0, -9, 0))
			if not g then
				return
			end
			if g.water then
				burst(g.pos, {kind = 'drop', n = 14, color = C3(220, 235, 245), size = {0.22, 0.1}, life = {0.5, 0.9}, speed = {9, 16}, trans = {0.15, 1}, drag = 0.6, accel = V3(0, -42, 0), spread = V2(32, 32), lit = 0.5})
				ripple(g.pos, 0.5, 6, 1.6, 0.6)
				task.delay(0.15, ripple, g.pos, 0.4, 4, 1.3, 0.45)
				sfx('slap', 0.55, 0.8)
				return
			end
			if g.dust <= 0 then
				return
			end
			local col = dustColor(g)
			local s = big and 1.3 or 1
			burst(g.pos, {kind = 'dust', n = 22 * g.dust * s, color = col, ring = 2.4, size = {1.2, 4.6 * s}, life = {0.9, 1.7}, speed = {8, 15 * s}, trans = {0.5, 1}, drag = 5, accel = V3(0, 1.1, 0), spread = V2(10, 10)})
			burst(g.pos, {kind = 'dust', n = 7 * g.dust, color = col, size = {0.8, 3}, life = {0.7, 1.2}, speed = {1.5, 3.5}, trans = {0.6, 1}, drag = 3, accel = V3(0, 1.6, 0), spread = V2(40, 40)})
		end
		CS.arrival = arrival
		function CS.onTeleport(from, to, kind, A0)
			if not A0 and (not (P.on and P.tp) or CS.spec.active) then
				return
			end
			local now = os.clock()
			if not A0 and CS.tpLast and now - CS.tpLast < 0.25 then
				return
			end
			if kind == 'world' then
				local recent = CS.tpRecent or {}
				CS.tpRecent = recent
				for i = #recent, 1, -1 do
					if now - recent[i] > 1.5 then
						table.remove(recent, i)
					end
				end
				recent[#recent + 1] = now
				if #recent >= 3 then
					CS.tpQuietUntil = now + 2
				end
				if now < (CS.tpQuietUntil or 0) then
					return
				end
			end
			CS.tpLast = now
			local dist = (to - from).Magnitude
			local style = P.tpStyle
			if style == 'Auto' then
				if dist < 30 or F.fly then
					style = 'Jump Cut'
				elseif dist > 1500 then
					style = 'Whip Pan'
				else
					style = 'Drone Glide'
				end
			end
			if P.reduce and aI._reducedMotion then
				style = 'Jump Cut'
			end
			local ov = RIG.ovr
			local A = A0 or RIG.lastFinal or (cam() and cam().CFrame)
			if not A or (ov and (ov.kind == 'death' or ov.kind == 'respawn')) then
				style = 'Jump Cut'
			end
			if style == 'Drone Glide' then
				local dur = clamp(0.5 + 0.2 * math.log10(1 + dist / 10), 0.55, 1.2)
				setOverride(glideShot(A, dur, 0.16))
				sfx('whoosh', 0.75, clamp(1.15 - dist / 3000, 0.75, 1.15))
				sfx('thump', 0.32, 1.1, dur * 0.9)
				if P.tpDust or A0 then
					task.delay(dur * 0.55, arrival, to)
				end
			elseif style == 'Whip Pan' then
				setOverride(whipShot(A, 0.42))
				sfx('whoosh', 0.85, 1.45)
				sfx('thump', 0.3, 1.15, 0.24)
				if P.tpDust or A0 then
					task.delay(0.18, arrival, to)
				end
			else
				flashCut(1)
				sfx('whoosh', 0.55, 1.3)
				sfx('thump', 0.45, 1)
				if P.tpDust or A0 then
					arrival(to)
				end
			end
		end
		function CS.snapshot(slot, preview)
			if not preview and not (P.on and P.snap) then
				return
			end
			sfx('shutter', 0.85)
			local ov = CS.ov
			local ui = CS.gui()
			if ui then
				ui.vfText.Text = slot and ('POSITION SAVED  ' .. DOT .. '  SLOT ' .. tostring(slot)) or 'POSITION SAVED'
			end
			addFx(1.1, function (self, u, t)
				OUT.flash = max(OUT.flash, 0.32 * (1 - clamp(t / 0.12, 0, 1)))
				ov.vf = (t < 0.08) and (t / 0.08) or (1 - smoother((t - 0.65) / 0.45))
				if UI then
					local s = 1 + 0.25 * (1 - easeOut(t / 0.3))
					UI.vfMark.Size = U2(0, 26 * s, 0, 26 * s)
				end
			end, 'snap', function ()
				ov.vf = 0
			end)
			kickCam(-0.25, 0, 0, 0, -1.2)
		end
	end

	local deathStep
	do
		local DEATH = nil
		local function respawnTime()
			local t = 5
			pcall(function ()
				t = D.RespawnTime
			end)
			return clamp(tonumber(t) or 5, 0.5, 30)
		end
		local function focusOf(d)
			local ch = d.char
			local h = ch and (ch:FindFirstChild('Head') or ch:FindFirstChild('UpperTorso') or ch:FindFirstChild('Torso') or ch:FindFirstChild('HumanoidRootPart'))
			if h and h.Parent and h:IsA('BasePart') then
				local p = h.Position
				if p.Y > -400 and (not d.focus or (p - d.focus).Magnitude < 60) then
					d.focus = p
				end
			end
			return d.focus
		end
		local function fadeBack()
			addFx(0.8, function (self, u)
				OUT.fade = max(OUT.fade, 1 - smoother(u))
			end, 'deathFade')
		end
		local function deathShot(d, A)
			local o = {kind = 'death', t = 0, A = A, d = d}
			local f0 = focusOf(d) or (A.Position + A.LookVector * 10)
			local off = A.Position - f0
			local hd = flat(off)
			o.dist0 = clamp(V3(off.X, 0, off.Z).Magnitude, 6, 15)
			o.h0 = clamp(off.Y, 1.5, 9)
			o.side = (rnd(0, 1) < 0.5) and -1 or 1
			o.ang0 = atan2(hd.X, hd.Z)
			o.fs = f0
			function o.step(self, dt)
				self.t = self.t + dt
				local t = self.t
				local f = focusOf(self.d) or self.fs
				self.fs = self.fs:Lerp(f, 1 - exp(-dt * 4))
				local style = self.d.style
				local cf, fov = nil, 0
				if style == 'Orbit' then
					local e = 1 - exp(-t / 2)
					local a = self.ang0 + 0.3 * t * self.side
					local pos = self.fs + V3(sin(a), 0, cos(a)) * (10 + 1.5 * e) + UP * (3.2 + 2.2 * e)
					cf = self.A:Lerp(lookAt(pos, self.fs), smoother(t / 0.8))
					fov = -3 * e
					if P.grade then
						wantDof(1, (cf.Position - self.fs).Magnitude, 3.5, 0.55, 0.35)
					end
				elseif style == 'Collapse' then
					if not self.target then
						local g = groundAt(f + UP * 2, V3(0, -14, 0))
						local floorY = g and g.pos.Y or (f.Y - 2.5)
						local right = (self.A - self.A.Position).RightVector
						self.target = V3(f.X, floorY + 0.85, f.Z) + flat(right) * 1.2 * self.side
					end
					local k = clamp(t / 0.85, 0, 1)
					k = k * k
					if t >= 0.85 and not self.hit then
						self.hit = true
						addTrauma(0.38)
						kickCam(-1.2, 0, 2 * self.side, -0.2, 0)
						sfx('thump', 0.6, 0.85)
					end
					local rot = (self.A - self.A.Position) * CFrame.Angles(rad(-8) * k, 0, rad(70) * self.side * k)
					cf = CFrame.new(self.A.Position:Lerp(self.target, k) + UP * (sin(t * 1.3) * 0.03 * k)) * rot
					fov = 6 * k
					if P.grade then
						OUT.blur = OUT.blur + 3 + 5 * k
					end
				else
					local e = 1 - exp(-t / 1.8)
					local a = self.ang0 + rad(28) * self.side * smoother(t / 6)
					local pos = self.fs + V3(sin(a), 0, cos(a)) * (self.dist0 + 4 * e) + UP * (self.h0 + 9 * e)
					cf = self.A:Lerp(lookAt(pos, self.fs), smoother(t / 0.6))
					fov = -5 * e
					if P.grade then
						wantDof(1, (cf.Position - self.fs).Magnitude, 4, 0.55, 0.35)
					end
				end
				return cf, fov, DEATH ~= self.d
			end
			return o
		end
		function CS.onDied(preview)
			if not preview then
				if ME.dead then
					return
				end
				ME.dead = true
				if not (P.on and P.death) then
					return
				end
			end
			local c = cam()
			local A = RIG.lastFinal or (c and c.CFrame)
			if not A or (c and c.CameraType == Enum.CameraType.Scriptable) then
				return
			end
			local d = {t = 0, char = ME.char, style = P.deathStyle, rt = preview and 3.2 or respawnTime(), preview = preview, auto = true}
			local watching = CS.spec.active and not preview
			pcall(function ()
				d.auto = D.CharacterAutoLoads
			end)
			DEATH = d
			CS.death = d
			if not watching then
				addTrauma(0.5)
				kickCam(1.5, rnd(-1, 1), rnd(-2, 2), -0.15, 0)
			end
			sfx('thump', 0.5, 0.9)
			sfx('heart', 0.55, 0.92, 0.2)
			sfx('heart', 0.38, 0.84, 1.35)
			if P.muffle then
				sfx('ring', 0.3, 1, 0.1)
			end
			if not watching then
				setOverride(deathShot(d, A))
			end
			CS.wake()
		end
		function deathStep(dt)
			local d = DEATH
			if not d then
				return
			end
			d.t = d.t + dt
			local t = d.t
			if P.grade then
				local e1, e2 = 1 - exp(-t / 0.5), 1 - exp(-t / 1.6)
				OUT.sat = OUT.sat - 0.55 * e1 - 0.35 * e2
				OUT.contrast = OUT.contrast + 0.12 * e2
				OUT.bright = OUT.bright - 0.06 * e2
				addTint(C3(222, 230, 255), 0.6 * e2)
				addVig(0.35 + 0.35 * e2)
				OUT.blur = OUT.blur + 9 * exp(-t / 0.35) + 1.2 * e2
			end
			OUT.muffle = 1
			local fadeAt, endAt = d.rt - 0.75, d.rt + 4
			if d.preview then
				endAt = d.rt
			elseif not d.auto then
				fadeAt, endAt = 10, 10.7
			end
			if t > fadeAt then
				OUT.fade = max(OUT.fade, smoother((t - fadeAt) / 0.6))
			end
			if t >= endAt then
				DEATH, CS.death = nil, nil
				fadeBack()
			end
		end
		local function craneDown(dur)
			local o = {kind = 'respawn', t = 0, dur = dur}
			function o.step(self, dt, base)
				self.t = self.t + dt
				local u = clamp(self.t / self.dur, 0, 1)
				if not self.A then
					local f = (ME.head and ME.head.Position) or (base.Position + base.LookVector * 10)
					self.A = lookAt(f + flat(base.Position - f) * 7 + UP * 22, f)
				end
				local e = smoother(u)
				return self.A:Lerp(base, e), -4 * (1 - e), u >= 1
			end
			return o
		end
		function CS.onRespawn(char, preview)
			local was = DEATH
			DEATH, CS.death = nil, nil
			local ov = RIG.ovr
			if ov and ov.kind == 'death' then
				setOverride(nil)
			end
			if not preview and not (P.on and P.respawn) then
				if was then
					fadeBack()
				end
				return
			end
			cancelFx('deathFade')
			local style = P.respawnStyle
			sfx('breath', 0.55, 1, 0.12)
			sfx('heart', 0.3, 1, 0.55)
			if style == 'Crane Down' and not (P.reduce and aI._reducedMotion) then
				setOverride(craneDown(1.9))
				sfx('whoosh', 0.35, 0.8)
				addFx(2.2, function (self, u, t)
					OUT.fade = max(OUT.fade, 1 - smoother(t / 0.7))
					if P.grade then
						OUT.sat = OUT.sat - 0.4 * (1 - smoother(t / 2))
						OUT.blur = OUT.blur + 6 * (1 - easeOut(t / 1.2))
					end
				end, 'respawn')
			elseif style == 'Focus Pull' then
				addFx(2.3, function (self, u, t)
					OUT.fade = max(OUT.fade, 1 - smoother(t / 0.6))
					if P.grade then
						local d = (ME.head and RIG.baseCF) and (RIG.baseCF.Position - ME.head.Position).Magnitude or 12
						local k = easeOut(t / 1.5)
						wantDof(1 - smoother((t - 1.5) / 0.8), lerp(0.4, d, k), lerp(0.6, max(d * 0.3, 3), k), 0.9, 0.2 + 0.7 * (1 - k))
						OUT.sat = OUT.sat - 0.35 * (1 - smoother(t / 1.8))
					end
					OUT.fov = OUT.fov - 4 * (1 - easeOut(t / 1.4))
				end, 'respawn')
			else
				addFx(2.5, function (self, u, t)
					local fd = 0
					if t < 0.2 then
						fd = 1
					elseif t < 0.55 then
						fd = 1 - 0.55 * smoother((t - 0.2) / 0.35)
					elseif t < 0.7 then
						fd = 0.45 + 0.4 * smoother((t - 0.55) / 0.15)
					else
						fd = 0.85 * (1 - easeOut((t - 0.7) / 1))
					end
					OUT.fade = max(OUT.fade, fd)
					if P.grade then
						OUT.blur = OUT.blur + 16 * (1 - easeOut(t / 2.1))
						OUT.bright = OUT.bright + 0.22 * exp(-((t - 0.95) / 0.45) ^ 2)
						OUT.sat = OUT.sat - 0.55 * (1 - smoother(t / 2.3))
						addVig(0.5 * (1 - smoother(t / 2)))
					end
					OUT.fov = OUT.fov - 7 * (1 - easeOut(t / 1.6))
					OUT.pitch = OUT.pitch - rad(5) * (1 - easeOut(t / 1.7))
					OUT.roll = OUT.roll + rad(3) * (1 - easeOut(t / 1.9))
				end, 'respawn')
			end
			CS.wake()
		end
	end

	local specStep
	do
		local SPEC = {active = false, target = nil, sm = nil, fd = 15, fdv = 0, infoT = 0}
		CS.spec = SPEC
		local function filter(base, dt)
			local a = 1 - exp(-lerp(22, 2.6, P.lag / 100) * dt)
			local sm = SPEC.sm and SPEC.sm:Lerp(base, a) or base
			local off = sm.Position - base.Position
			if off.Magnitude > 18 then
				sm = sm - off + off.Unit * 18
			end
			local ang = math.acos(clamp(sm.LookVector:Dot(base.LookVector), -1, 1))
			if ang > 0.42 then
				sm = base:Lerp(sm, 0.42 / ang)
			end
			SPEC.sm = sm
			return sm
		end
		local function transition()
			local ov = RIG.ovr
			if ov and (ov.kind == 'death' or ov.kind == 'respawn') then
				return
			end
			local A = RIG.lastFinal
			local kind = P.specTrans
			if P.reduce and aI._reducedMotion then
				kind = 'Cut'
			end
			SPEC.sm = nil
			if not A or kind == 'Cut' then
				flashCut(0.7)
				sfx('whoosh', 0.35, 1.4)
			elseif kind == 'Whip Pan' then
				setOverride(whipShot(A, 0.4, 'spec'))
				sfx('whoosh', 0.6, 1.5)
			else
				local dist = RIG.baseCF and (RIG.baseCF.Position - A.Position).Magnitude or 50
				setOverride(glideShot(A, clamp(0.55 + dist / 900, 0.6, 1.1), 0.08, 'spec'))
				sfx('whoosh', 0.45, 1.1)
			end
		end
		local function playerOf(model)
			local ok, plr = pcall(function ()
				return D:GetPlayerFromCharacter(model)
			end)
			return ok and plr or nil
		end
		function specStep(dt, now, c)
			local subj = c.CameraSubject
			local model = nil
			if subj then
				if subj:IsA('Humanoid') then
					model = subj.Parent
				elseif subj:IsA('BasePart') then
					model = subj:FindFirstAncestorOfClass('Model') or subj
				end
			end
			local mine = ME.char
			local other = model ~= nil and model ~= workspace and mine ~= nil and model ~= mine and not model:IsDescendantOf(mine)
			local fx = (P.on and P.spec) or CS.specPreview
			if other then
				if not SPEC.active then
					SPEC.active, SPEC.target = true, model
					if fx then
						transition()
					end
				elseif model ~= SPEC.target then
					SPEC.target = model
					if fx then
						transition()
					end
				end
			elseif SPEC.active then
				SPEC.active, SPEC.target = false, nil
				if fx then
					transition()
				end
			end
			local ov = CS.ov
			local on = SPEC.active and fx
			RIG.filter = on and filter or nil
			if not on then
				SPEC.sm = nil
				ov.lt = max(0, ov.lt - dt * 4)
				return
			end
			if P.bars then
				OUT.bars = 1
			end
			local hm = P.hand / 100
			OUT.pitch = OUT.pitch + (fbm(now * 0.47, 3.3) * 0.011 + sin(now * 1.3) * 0.0016) * hm
			OUT.yaw = OUT.yaw + fbm(now * 0.52, 7.1) * 0.013 * hm
			OUT.roll = OUT.roll + fbm(now * 0.36, 11.4) * 0.009 * hm
			local tm = SPEC.target
			local head = tm and (tm:FindFirstChild('Head') or tm:FindFirstChild('HumanoidRootPart'))
			if head and not head:IsA('BasePart') then
				head = nil
			end
			if P.focus and head then
				local d = (head.Position - (RIG.lastFinal or c.CFrame).Position).Magnitude
				SPEC.fd, SPEC.fdv = spring(SPEC.fd, SPEC.fdv, d, 5, dt)
				wantDof(0.9, SPEC.fd, clamp(SPEC.fd * 0.28, 2.5, 30), 0.45, 0.3)
			end
			ov.lt = P.overlay and min(1, ov.lt + dt * 3) or max(0, ov.lt - dt * 4)
			SPEC.infoT = SPEC.infoT - dt
			local ui = P.overlay and CS.gui()
			if ui and SPEC.infoT <= 0 then
				SPEC.infoT = 0.25
				local plr = playerOf(tm)
				local hum = tm and tm:FindFirstChildOfClass('Humanoid')
				ui.ltName.Text = plr and plr.DisplayName or (tm and tm.Name or '')
				local bits = {}
				if plr then
					bits[#bits + 1] = '@' .. plr.Name
				end
				if ME.root and head then
					bits[#bits + 1] = floor((head.Position - ME.root.Position).Magnitude * 0.28 + 0.5) .. ' m away'
				end
				if hum then
					local hp = clamp(hum.Health / max(hum.MaxHealth, 1), 0, 1)
					bits[#bits + 1] = floor(hp * 100 + 0.5) .. '% HP'
					ui.ltHpFill.Size = U2(hp, 0, 1, 0)
				end
				ui.ltInfo.Text = table.concat(bits, '  ' .. DOT .. '  ')
				ui.ltLive.BackgroundTransparency = (floor(now * 1.6) % 2 == 0) and 0 or 0.65
			end
		end
	end

	local namesStep, namesRestore
	do
		local weak = {__mode = 'k'}
