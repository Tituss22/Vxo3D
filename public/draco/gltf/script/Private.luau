	cj.ensureAvatarFolder = function ()
		if type(makefolder) ~= 'function' then
			return false
		end
		if type(isfolder) ~= 'function' then
			return false
		end
		local ct = pcall(function ()
			if not isfolder(cj.AVATARS_FOLDER) then
				makefolder(cj.AVATARS_FOLDER)
			end
		end)
		return ct
	end
	cj.getAvatarFilePath = function (ct)
		return cj.AVATARS_FOLDER .. '/' .. cj.AVATAR_FILE_PREFIX .. tostring(ct) .. cj.AVATAR_FILE_EXTENSION
	end
	cj.getNextAvatarFilePath = function (ct)
		cj.ensureAvatarFolder()
		if type(isfile) ~= 'function' then
			return nil
		end
		local cu = cj.sanitizeAvatarFileName(ct or 'Avatar')
		if not cu then
			return nil
		end
		cu = cu:sub(1, -5)
		for cv = 1, 10000 do
			local cw = cu
			if cv > 1 then
				cw = cu .. tostring(cv)
			end
			local cx = cj.AVATARS_FOLDER .. '/' .. cw .. cj.AVATAR_FILE_EXTENSION
			local cy = false
			pcall(function ()
				cy = isfile(cx)
			end)
			if not cy then
				return cx
			end
		end
		return nil
	end
	cj.readAvatarFiles = function ()
		local ct = {}
		if type(readfile) ~= 'function' then
			return ct
		end
		cj.ensureAvatarFolder()
		local cu = {}
		if type(listfiles) == 'function' then
			pcall(function ()
				for cv, cw in ipairs(listfiles(cj.AVATARS_FOLDER)) do
					if tostring(cw):lower():match('%.ava$') then
						cu[#cu + 1] = cw
					end
				end
			end)
		end
		if #cu == 0 and type(isfile) == 'function' then
			for cv = 1, 10000 do
				local cw = cj.getAvatarFilePath(cv)
				local cx = false
				pcall(function ()
					cx = isfile(cw)
				end)
				if cx then
					cu[#cu + 1] = cw
				end
			end
		end
		table.sort(cu, function (cv, cw)
			return tostring(cv):lower() < tostring(cw):lower()
		end)
		for cv, cw in ipairs(cu) do
			local cx, cy = pcall(function ()
				return cj.HttpService:JSONDecode(readfile(cw))
			end)
			if cx and type(cy) == 'table' and type(cy.Properties) == 'table' then
				cy.FileName = cy.FileName or tostring(cw):match('([^/\\]+)$')
				cy.Source = 'ava'
				ct[#ct + 1] = cy
			end
		end
		return ct
	end
	cj.writeAvatarFile = function (ct)
		if type(writefile) ~= 'function' then
			return false, 'The executor does not provide writefile().'
		end
		cj.ensureAvatarFolder()
		local cu = ct.FilePath or cj.getNextAvatarFilePath(ct.DisplayName or ct.Name)
		if not cu then
			return false, 'No free avatar filename was found.'
		end
		ct.FilePath = cu
		ct.FileName = tostring(cu):match('([^/\\]+)$') or cu
		ct.Source = 'ava'
		local cv, cw = pcall(function ()
			writefile(cu, cj.HttpService:JSONEncode(ct))
		end)
		if not cv then
			return false, tostring(cw)
		end
		return true, cu
	end
	cj.sanitizeAvatarFileName = function (ct)
		ct = tostring(ct or ''):gsub('^%s+', ''):gsub('%s+$', '')
		ct = ct:gsub('[<>:"/\\|%?%*]', '-')
		ct = ct:gsub('[%. ]+$', '')
		if ct == '' then
			return nil
		end
		if ct:lower():sub(-4) == '.ava' then
			ct = ct:sub(1, -5)
		end
		if ct == '' then
			return nil
		end
		return ct .. '.ava'
	end
	cj.renameAvatarFile = function (ct, cu)
		if not ct or ct.Source ~= 'ava' then
			return false, 'This is not a .ava avatar file.'
		end
		if type(writefile) ~= 'function' or type(isfile) ~= 'function' or type(delfile) ~= 'function' then
			return false, [[The executor must provide writefile(), isfile(), and delfile().]]
		end
		local cv = cj.sanitizeAvatarFileName(cu)
		if not cv then
			return false, 'The filename is empty or invalid.'
		end
		cj.ensureAvatarFolder()
		local cw = ct.FilePath
		if not cw and ct.FileName then
			cw = cj.AVATARS_FOLDER .. '/' .. tostring(ct.FileName)
		end
		if not cw then
			return false, 'The avatar file path is unavailable.'
		end
		local cx = cj.AVATARS_FOLDER .. '/' .. cv
		if cw:lower() ~= cx:lower() then
			local cy = false
			pcall(function ()
				cy = isfile(cx)
			end)
			if cy then
				return false, 'An avatar with that filename already exists.'
			end
		end
		local cy = tostring(cu):gsub('^%s+', ''):gsub('%s+$', '')
		local cz = {}
		for cA, cB in pairs(ct) do
			cz[cA] = cB
		end
		cz.FilePath = cx
		cz.FileName = cv
		cz.DisplayName = cy
		cz.Source = 'ava'
		local cA, cB = pcall(function ()
			return cj.HttpService:JSONEncode(cz)
		end)
		if not cA then
			return false, tostring(cB)
		end
		local cC, cD = pcall(function ()
			writefile(cx, cB)
		end)
		if not cC then
			return false, tostring(cD)
		end
		if cw:lower() ~= cx:lower() then
			local cE, cF = pcall(function ()
				delfile(cw)
			end)
			if not cE then
				pcall(function ()
					delfile(cx)
				end)
				return false, tostring(cF)
			end
		end
		for cE, cF in pairs(cz) do
			ct[cE] = cF
		end
		return true, cx
	end
	cj.buildSavedAvatarData = function (ct)
		if not ct or not ct.Character then
			return nil, 'Player character is unavailable.'
		end
		local cu = ct.Character:FindFirstChildOfClass('Humanoid')
		if not cu then
			return nil, 'Humanoid is unavailable.'
		end
		local cv, cw = pcall(function ()
			return cu:GetAppliedDescription()
		end)
		if not cv or not cw then
			return nil, 'Could not read the currently applied avatar.'
		end
		local cx = cj.createCopiedProperties(cw, ct.Character)
		if type(cx) ~= 'table' then
			return nil, 'Could not serialize the avatar.'
		end
		local cy = cu.RigType
		local cz = {Name = ct.Name, UserId = ct.UserId, DisplayName = ct.DisplayName, Properties = cx, RigType = (cy == Enum.HumanoidRigType.R6) and 'R6' or 'R15', Signature = cj.getAvatarSignature(cx, cy), Order = 1}
		return cz
	end
	cj.notifyCatalogAvatarCreator = function ()
		if not cj.IS_CATALOG_AVATAR_CREATOR then
			return
		end
		local ct = {Title = 'Avatar Thingy', Text = [[You are in Catalog Avatar Creator, therefore your avatars will be FE and will be saved to "Saved Outfits"]], Duration = 8}
		task.spawn(function ()
