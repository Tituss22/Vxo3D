			for _, names in ipairs(FOOT_NAMES) do
				local f = ch:FindFirstChild(names[1]) or ch:FindFirstChild(names[2])
				if f and f:IsA('BasePart') then
					local cf, sz = f.CFrame, f.Size
					local b = cf.Position - cf.UpVector * (sz.Y * 0.5)
					lo, sum, n = math.min(lo, b.Y), sum + b, n + 1
