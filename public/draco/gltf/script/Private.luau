		local function castPerson(e, ground, nrm, air)
			local sh, env = PB.sh, PB.env
			local hrp, hum = e.hrp, e.hum
			local leg = (hum.RigType == Enum.HumanoidRigType.R6) and 2 or hum.HipHeight
			local body, head = hrp.Size.Y, 1.2
