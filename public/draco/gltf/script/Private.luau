				local e = table.remove(PB.aoPending, 1)
				if not PB.aoPatches[e.key] then
					local o = SB.take(e)
					o.e, o.place, o.alpha, o.target, o.kill = e, true, 0, 1, nil
					PB.aoPatches[e.key] = o
					made = made + 1
				end
			end
			local strength = PB.aoStr / 100 * PB.master
			local castOn = (PB.adaptive and PB.castMode ~= 'Off') and 1 or 0
			local direct = PB.sh.vDirect
			local swayOn = PB.adaptive and PB.windShadow
			local gk = damp(dt, 2.2)
			local tintLeft = aoReach()
			local go = math.max(0.3 * tintLeft, 4)
			local gp = 10
			local bp, bc, nb = PB.abp, PB.abc, 0
			local n, nc = 0, 0
			for key, o in pairs(PB.aoPatches) do
				local e = o.e
				local moved = false
				if o.place then
					o.place, o.kill = false, nil
					if (o.beam == true) ~= (e.beam ~= nil) then
						o.target, o.kill, o.glide = 0, true, false
					end
					local gz = e.dim == true
					if gz ~= (o.dim == true) then
						o.dim, o.tv = gz, -1
					end
					if o.kill then
						o.base = o.base or e.cf
					elseif o.on and o.base and o.shape and o.alpha > 0.05 and not e.dyn and similarShape(o.shape, e) then
						o.glide = true
					else
						SB.shape(o, e)
						o.base, o.glide = e.cf, false
					end
					moved = true
				end
				if e.dyn then
					local gz = PB.dynParts[e.key]
					if not (gz and gz.Parent) or (gz.Position - e.dpos).Magnitude > 0.08 then
						o.target, o.kill = 0, true
					end
				end
				if o.glide then
					local ts = patchSize(e)
					o.base = o.base:Lerp(e.cf, gk)
					o.size = o.size:Lerp(ts, gk)
					o.plate.Size = o.size
					if o.beam then
						SB.morph(o, e, gk)
					end
					if (o.base.Position - e.cf.Position).Magnitude < 0.01 and (o.size - ts).Magnitude < 0.01 and o.base.RightVector:Dot(e.cf.RightVector) > 0.99995 then
						o.glide = false
						SB.shape(o, e)
						o.base = e.cf
					end
					moved = true
				elseif o.beam and o.gm and o.shape and o.fv ~= SB.fver then
					SB.layout(o, o.gm, o.shape)
				end
				if o.alpha ~= o.target then
					local stp = dt / (o.target > o.alpha and 0.6 or (o.kill and 0.12 or 0.4))
					o.alpha = (o.target > o.alpha) and math.min(o.target, o.alpha + stp) or math.max(o.target, o.alpha - stp)
				end
				local share = e.share
				if e.cast then
					share = share * math.clamp(direct / e.dir0, 0, 1) * castOn
				elseif PB.adaptive and e.dir0 then
					share = 0.8 + (share - 0.8) * math.clamp(direct / e.dir0, 0, 1)
				end
				local mul = (e.cf.Position - camPos).Magnitude - 0.5 * math.max(e.W, e.D)
				local zl = math.min(math.max(mul, 0) * 0.0009 * (0.4 + PB.aoBias / 100), 0.07)
				if math.abs(zl - (o.zl or 0)) > 0.005 then
					o.zl, moved = zl, true
				end
				local mul = o.alpha * share * strength * ((mul > tintLeft - go) and smooth((tintLeft - mul) / go) or 1)
				if mul > 0.004 and o.tv ~= PB.tintVer and (gp > 0 or o.alpha < 0.15) then
					gp = gp - 1
					SB.tint(o)
				end
				SB.alpha(o, mul)
				if o.target == 0 and o.alpha <= 0 then
					SB.alpha(o, 0)
					o.plate.CFrame = HIDE
					o.off, o.glide, o.kill = nil, false, nil
					PB.aoPatches[key] = nil
					SB.give(o)
				else
					local off = nil
					local plant = swayOn and e.sway and PB.swayParts[e.key]
					if plant then
						local rest, cur = swayOf(plant)
						if rest and cur then
							local up = (cur * rest:Inverse()).UpVector
							off = V3(up.X * e.swayH, 0, up.Z * e.swayH)
							if e.sn then
								off = alongFit(e.sn, off)
							end
						end
					end
					if off then
						if not o.off or (off - o.off).Magnitude > 0.002 then
							o.off, moved = off, true
						end
					elseif o.off then
						o.off, moved = nil, true
					end
					if moved then
						nb = nb + 1
						local cf = o.off and (o.base + o.off) or o.base
						bp[nb], bc[nb] = o.plate, (o.zl or 0) > 0 and (cf + cf.UpVector * o.zl) or cf
					end
					if e.cast then
						nc = nc + 1
					else
						n = n + 1
					end
				end
			end
			for k = nb + 1, #bp do
				bp[k] = nil
				bc[k] = nil
			end
			if nb > 0 then
				pcall(function ()
					workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
				end)
			end
			PB.stat.ao, PB.stat.cast = n, nc
		end
		local function mkEdge()
			local plate = mkPlate('PBREdge')
			local sg = Instance.new('SurfaceGui')
			sg.Face = Enum.NormalId.Top
			sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
			sg.CanvasSize = Vector2.new(4, 4)
			sg.LightInfluence = 1
			sg.AlwaysOnTop = false
			sg.Adornee = plate
			sg.Enabled = false
			sg.Parent = plate
			local f = Instance.new('Frame')
			f.Size = UDim2.fromScale(1, 1)
			f.BorderSizePixel = 0
			f.BackgroundTransparency = 1
			f.Parent = sg
			return {plate = plate, sg = sg, f = f, alpha = 0, target = 1, tr = 1, base = 0, on = false, nextUpd = 0}
		end
		local function edgeGeom(d)
			local fc, fn, fu, fv, hu, hv = faceGeom(d.p, d.ax, d.sg)
			local k = d.ei
			if k == 1 then
				return fc, fn, fu, hu, fv, hv
			elseif k == 2 then
				return fc, fn, -fu, hu, fv, hv
			elseif k == 3 then
				return fc, fn, fv, hv, fu, hu
			end
			return fc, fn, -fv, hv, fu, hu
		end
		local function edgeCompute(p, camPos)
			local out = {}
			local lc = p.CFrame:PointToObjectSpace(camPos)
			local half = p.Size * 0.5
			local id = idOf(p)
			for ax = 1, 3 do
				local lcA = (ax == 1 and lc.X) or (ax == 2 and lc.Y) or lc.Z
				local hA = (ax == 1 and half.X) or (ax == 2 and half.Y) or half.Z
				if math.abs(lcA) > hA + 0.02 then
					local sg = lcA > 0 and 1 or -1
					for ei = 1, 4 do
						local d = {p = p, ax = ax, sg = sg, ei = ei}
						local fc, fn, e, ext, _, alen = edgeGeom(d)
						if alen >= 0.1 then
							local w = math.clamp(0.14 * math.min(ext, alen), 0.025, 0.08)
							local mid = fc + e * ext
							local flush = workspace:Raycast(mid - e * 0.01 - fn * 0.02, e * 0.1, PB.rp)
							local dg = (fn + e).Unit
							local covered = (not flush) and workspace:Raycast(mid - dg * 0.01, dg * 0.3, PB.rp)
							covered = covered or ((not flush) and workspace:Raycast(mid - e * (w + 0.01) - fn * 0.01, fn * 0.25, PB.rp))
							if not flush and not covered then
								d.w = w
								d.key = id .. ':' .. ax .. ':' .. sg .. ':' .. ei
								out[#out + 1] = d
							end
						end
					end
				end
			end
			return out
		end
		local function edgeShade(o, camPos, now)
			local d = o.d
			local fc, fn, e, ext, along, alen = edgeGeom(d)
			local w = d.w
			local mid = fc + e * (ext - w * 0.5)
			o.cf = CFrame.fromMatrix(mid + fn * 0.02, along, fn)
			if o.sx ~= alen or o.sw ~= w then
				o.sx, o.sw = alen, w
				o.plate.Size = V3(alen * 2, 0.02, w)
			end
			local env = PB.env
			local nb = (fn + e).Unit
			local D = 0.35 * ((nb.Y + 1) * 0.5 - (fn.Y + 1) * 0.5)
			if env.I > 0.03 then
				if now >= (o.nextSh or 0) then
					o.nextSh = now + 2 + math.random()
					local hit = workspace:Raycast(mid + fn * 0.1, env.dir * 250, PB.rp)
					o.lit = not (hit and PB.seeT(hit.Instance) < 0.5)
				end
				if o.lit then
					D = D + env.I * (math.max(nb:Dot(env.dir), 0) - math.max(fn:Dot(env.dir), 0))
				end
			end
			local col, a = nil
			if D >= 0 then
				col = d.p.Color:Lerp(WHITE, 0.6):Lerp(env.col or WHITE, 0.3)
				a = math.clamp(D * 0.6, 0, 0.4)
			else
				col = BLACK
				a = math.clamp(-D * 0.36, 0, 0.23)
			end
			local range = math.max(Q().edgeRange, 1)
			o.base = a * math.clamp((range - (mid - camPos).Magnitude) / (0.3 * range), 0, 1)
			local oc = o.col
			if not oc or math.abs(oc.R - col.R) + math.abs(oc.G - col.G) + math.abs(oc.B - col.B) > 0.02 then
				o.col = col
				o.f.BackgroundColor3 = col
			end
		end
		local function edgeReconcile()
			local q = Q()
			local list = PB.edgeNext or {}
			PB.edgeNext = nil
			local want, order = {}, {}
			if PB.edge and PB.edgeStr > 0 then
				for i = 1, math.min(#list, q.edgeMax) do
					want[list[i].key] = list[i]
					order[#order + 1] = list[i]
				end
			end
			for key, o in pairs(PB.edgeStrips) do
				local d = want[key]
				if d then
					o.d, o.target = d, 1
					want[key] = nil
				else
					o.target = 0
				end
			end
			local pend = {}
			for _, d in ipairs(order) do
				if want[d.key] then
					pend[#pend + 1] = d
				end
			end
			PB.edgePending = pend
		end
		local function edgeTick(camPos, dt, now)
			local q = Q()
			local queue = PB.edgeQueue
			if queue then
				local solved = 0
				while PB.edgeQi <= #queue and solved < math.max(q.edgePer, 1) do
					local p = queue[PB.edgeQi]
					PB.edgeQi = PB.edgeQi + 1
					if p.Parent then
						local lc = p.CFrame:PointToObjectSpace(camPos)
						local half = p.Size * 0.5
						local function side(v, hh)
							return (math.abs(v) > hh + 0.02) and (v > 0 and 2 or 0) or 1
						end
						local sig = side(lc.X, half.X) * 9 + side(lc.Y, half.Y) * 3 + side(lc.Z, half.Z)
						local c = PB.edgeCache[p]
						local pos, size = p.Position, p.Size
						if not (c and c.sig == sig and (c.pos - pos).Magnitude < 0.02 and c.size == size and now < c.t) then
							local ok, res = pcall(edgeCompute, p, camPos)
							c = {sig = sig, pos = pos, size = size, t = now + 60, list = ok and res or {}}
							PB.edgeCache[p] = c
							solved = solved + 1
						end
						for _, d in ipairs(c.list) do
							PB.edgeNext[#PB.edgeNext + 1] = d
						end
					end
				end
				if PB.edgeQi > #queue then
					PB.edgeQueue = nil
					edgeReconcile()
				end
			end
			if not PB.edge then
				for _, o in pairs(PB.edgeStrips) do
					o.target = 0
				end
				PB.edgePending = {}
			end
			local made = 0
			while #PB.edgePending > 0 and made < 6 do
				local d = table.remove(PB.edgePending, 1)
				if not PB.edgeStrips[d.key] and d.p.Parent then
					local o = table.remove(PB.edgePool) or mkEdge()
					o.d, o.alpha, o.target, o.nextUpd, o.nextSh, o.col, o.sx, o.sw = d, 0, 1, 0, 0, nil, nil, nil
					PB.edgeStrips[d.key] = o
					made = made + 1
				end
			end
			local k = PB.edgeStr / 100 * PB.master
			local bp, bc, nb, n = PB.ebp, PB.ebc, 0, 0
			for key, o in pairs(PB.edgeStrips) do
				if not o.d.p.Parent then
					o.target = 0
				end
				if o.target > 0 and now >= o.nextUpd then
					o.nextUpd = now + 0.3 + math.random() * 0.15
					if pcall(edgeShade, o, camPos, now) then
						nb = nb + 1
						bp[nb], bc[nb] = o.plate, o.cf
					end
				end
				if o.alpha ~= o.target then
					local stp = dt / (o.target > o.alpha and 0.5 or 0.35)
					o.alpha = (o.target > o.alpha) and math.min(o.target, o.alpha + stp) or math.max(o.target, o.alpha - stp)
				end
				local a = math.clamp(o.base * o.alpha * k, 0, 0.6)
				local vis = a > 0.01
				if vis ~= o.on then
					o.on = vis
					o.sg.Enabled = vis
				end
				local tr = 1 - a
				if math.abs(tr - o.tr) > 0.008 then
					o.tr = tr
					o.f.BackgroundTransparency = tr
				end
				if o.target == 0 and o.alpha <= 0 then
					o.sg.Enabled, o.on = false, false
					o.plate.CFrame = HIDE
					PB.edgeStrips[key] = nil
					if #PB.edgePool < 80 then
						PB.edgePool[#PB.edgePool + 1] = o
					else
						pcall(function ()
							o.plate:Destroy()
						end)
					end
				else
					n = n + 1
				end
			end
			for k2 = nb + 1, #bp do
				bp[k2] = nil
				bc[k2] = nil
			end
			if nb > 0 then
				pcall(function ()
					workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
				end)
			end
			PB.stat.edge = n
		end
		local MIR_LIFT = 0.065
		local function mirHolder()
			local h = PB.mirHolder
			if h and h.Parent then
				return h
			end
			h = mkPlate('PBRReflections')
			h.CFrame = CFrame.new()
			PB.mirHolder = h
			return h
		end
		local function mkMirror()
			return {segs = {}, att = {}, alpha = 0, target = 0, on = false, seed = math.random() * 100}
		end
		local function mirAtt(o, k)
			local a = o.att[k]
			if not a then
				a = Instance.new('Attachment')
				a.Parent = mirHolder()
				o.att[k] = a
			end
			return a
		end
		local function mirSeg(o, k)
			local s = o.segs[k]
			if s then
				return s
			end
			local a0, a1 = mirAtt(o, k), mirAtt(o, k + 1)
			local function beam()
				local b = Instance.new('Beam')
				b.Attachment0, b.Attachment1 = a0, a1
				b.FaceCamera = false
				b.Segments = 1
				b.LightInfluence = 0
				b.LightEmission = 0
				b.Texture = ''
				b.CurveSize0, b.CurveSize1 = 0, 0
				b.Enabled = false
				b.Parent = mirHolder()
				return b
			end
			s = {core = beam(), soft = beam(), on = false}
			o.segs[k] = s
			return s
		end
		local function mirShow(o, from, on)
			for k = from, #o.segs do
				local s = o.segs[k]
				if s.on ~= on then
					s.on = on
					s.core.Enabled = on
					s.soft.Enabled = on
				end
			end
		end
		local PROF_H = {0.06, 0.34, 0.66, 0.94}
		local function meshProfile(p, cf, up, h, uA, A, uB, B)
			PB.ip.FilterDescendantsInstances = {p}
			local bottom = cf.Position - up * (h * 0.5)
			local prof = {}
			for k, f in ipairs(PROF_H) do
				local c = bottom + up * (h * f)
				local function span(ax, half, other, ohalf)
					local w = 0
					for _, off in ipairs({-0.3, 0.3}) do
						local base = c + other * (off * ohalf)
						local h1 = workspace:Raycast(base + ax * (half + 0.25), ax * -(2 * half + 0.5), PB.ip)
						local h2 = workspace:Raycast(base - ax * (half + 0.25), ax * (2 * half + 0.5), PB.ip)
						if h1 and h2 then
							w = math.max(w, (h1.Position - h2.Position):Dot(ax))
						end
					end
					return w
				end
				prof[k] = {a = span(uA, A * 0.5, uB, B * 0.5), b = span(uB, B * 0.5, uA, A * 0.5)}
			end
			return prof
		end
		local function mirSolve(p, now, budget)
			local c = PB.mirInfo[p]
			local pos, size = p.Position, p.Size
			if c and now < c.t and (c.pos - pos).Magnitude < 0.05 and c.size == size then
				return 0
			end
			local nc = {pos = pos, size = size, t = now + 3 + math.random() * 2, ok = false, part = p}
			local isPart = p:IsA('Part')
			local shape = isPart and p.Shape or nil
			if isPart and shape ~= Enum.PartType.Block and shape ~= Enum.PartType.Cylinder then
				PB.mirInfo[p] = nc
				return 0
			end
			local cf = p.CFrame
			local up, h, uA, A, uB, B = boxAxes(cf, size)
			if up.Y < (isPart and 0.97 or 0.9) or h < 0.5 then
				PB.mirInfo[p] = nc
				return 0
			end
			if shape == Enum.PartType.Cylinder and math.abs(cf.RightVector.Y) < 0.97 then
				PB.mirInfo[p] = nc
				return 0
			end
			local bottom = pos - up * (h * 0.5)
			local hit = workspace:Raycast(bottom + UP * 0.02, V3(0, -6, 0), PB.rp)
			if not (hit and hit.Normal.Y > 0.96 and receiverOk(hit.Instance)) then
				PB.mirInfo[p] = nc
				return 0
			end
			local _, r = matResp(hit.Material, 1)
			if r > 0.62 then
				PB.mirInfo[p] = nc
				return 0
			end
			local prof, spent = nil, 0
			if not isPart then
				local pc = PB.mirProf[p]
				if pc and (pc.pos - pos).Magnitude < 0.05 and pc.size == size then
					prof = pc.prof
				else
					if budget <= 0 then
						return 0
					end
					local okP, res = pcall(meshProfile, p, cf, up, h, uA, A, uB, B)
					spent = 1
					if not okP then
						PB.mirInfo[p] = nc
						return spent
					end
					prof = res
					PB.mirProf[p] = {pos = pos, size = size, prof = prof}
				end
			end
			nc.ok, nc.y0, nc.gap, nc.h, nc.mat = true, hit.Position.Y, math.max(bottom.Y - hit.Position.Y, 0), h, hit.Material
			nc.uA, nc.A, nc.uB, nc.B = onPlane(UP, uA), A, onPlane(UP, uB), B
			nc.cyl = shape == Enum.PartType.Cylinder
			nc.wid = math.min(A, B)
			nc.prof = prof
			PB.mirInfo[p] = nc
			return spent
		end
		local function charPartCol(ch, names)
			for _, nm in ipairs(names) do
				local bp = ch:FindFirstChild(nm)
				if bp and bp:IsA('BasePart') then
					return bp.Color:Lerp(RGB(40, 42, 48), 0.45)
				end
			end
			return RGB(52, 54, 60)
		end
		local function mirChar(c, now)
			local hrp, hum = c.hrp, c.hum
			if not (hrp and hrp.Parent and hum and hum.Parent) then
				return false
			end
			if now >= (c.nextT or 0) then
				c.nextT = now + 0.1
				c.ok = false
				local hit = workspace:Raycast(hrp.Position, V3(0, -16, 0), PB.sp)
				if hit and hit.Normal.Y > 0.96 and hit.Material ~= Enum.Material.Water then
					local _, r = matResp(hit.Material, 1)
					if r <= 0.62 then
						local leg = (hum.RigType == Enum.HumanoidRigType.R6) and 2 or hum.HipHeight
						local feet = hrp.Position.Y - hrp.Size.Y * 0.5 - leg
						c.ok, c.y0, c.mat = true, hit.Position.Y, hit.Material
						c.gap, c.legH, c.bodyH = math.max(feet - hit.Position.Y, 0), leg, hrp.Size.Y
						c.h = leg + hrp.Size.Y + 1.1
						c.wid = math.clamp(hrp.Size.X, 1, 6) * 0.9
						if now >= (c.nextCol or 0) then
							c.nextCol = now + 2
							local ch = c.model
							c.cLeg = charPartCol(ch, {'LeftLowerLeg', 'Left Leg', 'LowerTorso'})
							c.cBody = charPartCol(ch, {'UpperTorso', 'Torso'})
							c.cHead = charPartCol(ch, {'Head'})
						end
					end
				end
			end
			if c.ok then
				local feet = hrp.Position.Y - hrp.Size.Y * 0.5 - (c.legH or 2)
				c.gap = math.max(feet - c.y0, 0)
			end
			return c.ok == true
		end
		local function mirRun(c, foot, dir, dmax)
			local run = dmax
			local blk = workspace:Raycast(foot + UP * 0.25 + dir * 0.06, dir * dmax, PB.rp)
			if blk then
				run = math.min(run, blk.Distance)
			end
			local function floorAt(d)
				local hit = workspace:Raycast(foot + dir * d + UP * 1.2, V3(0, -2, 0), PB.sp)
				local ok = hit ~= nil and hit.Normal.Y > 0.96 and math.abs(hit.Position.Y - c.y0) < 0.2 and hit.Material ~= Enum.Material.Water
				if ok then
					local _, r = matResp(hit.Material, 1)
					ok = r <= 0.7
				end
				return ok
			end
			local good = 0
			for _, f in ipairs({0.5, 1}) do
				if floorAt(run * f) then
					good = run * f
				else
					local lo, hi = good, run * f
					for _ = 1, 3 do
						local mid = (lo + hi) * 0.5
						if floorAt(mid) then
							lo = mid
						else
							hi = mid
						end
					end
					run = lo
					break
				end
			end
			return run
		end
		local function mirSlices(c, perp)
			if c.char then
				local cf = c.hrp.CFrame
				local rgt, fwd = cf.RightVector, cf.LookVector
				local function across(front, side)
					return math.abs(perp:Dot(rgt)) * front + math.abs(perp:Dot(fwd)) * side
				end
				local s = math.clamp(c.wid / 1.8, 0.6, 3)
				local l1, l2 = c.legH, c.legH + c.bodyH
				local wl, wt = across(1.6, 0.95) * s, across(2, 1.05) * s
				local cl, cb, chd = c.cLeg or RGB(52, 54, 60), c.cBody or RGB(52, 54, 60), c.cHead or RGB(52, 54, 60)
				return {{0, l1, wl, wl, cl, cl}, {l1, l2, wt, wt * 0.96, cb, cb}, {l2, c.h, 1.1 * s, 0.8 * s, chd, chd}}
			end
			local col = c.part.Color
			local pr = c.prof
			if pr then
				local function w(k)
					return math.abs(perp:Dot(c.uA)) * pr[k].a + math.abs(perp:Dot(c.uB)) * pr[k].b
				end
				local h = c.h
				return {{0, h / 3, w(1), w(2), col, col}, {h / 3, h * 2 / 3, w(2), w(3), col, col}, {h * 2 / 3, h, w(3), w(4), col, col}}
			end
			local eb = c.cyl and c.wid or (math.abs(perp:Dot(c.uA)) * c.A + math.abs(perp:Dot(c.uB)) * c.B)
			return {{0, c.h, eb, eb, col, col}}
		end
		local function mirStep(o, c, camPos, now)
			local base = c.char and c.hrp.Position or c.pos
			local hc = camPos.Y - c.y0
			if hc < 0.35 then
				return false
			end
			local toC = V3(camPos.X - base.X, 0, camPos.Z - base.Z)
			local dist = toC.Magnitude
			if dist < 0.6 then
				return false
			end
			local dir = toC / dist
			local perp = V3(-dir.Z, 0, dir.X)
			local ea = c.wid
			if not (c.char or c.cyl) then
				ea = math.abs(dir:Dot(c.uA)) * c.A + math.abs(dir:Dot(c.uB)) * c.B
			end
			local df = dist - ea * 0.5
			if df < 0.4 then
				return false
			end
			local foot = V3(base.X, c.y0, base.Z) + dir * (ea * 0.5)
			local function dAt(t)
				return df * (1 - hc / (hc + c.gap + t))
			end
			local slices = mirSlices(c, perp)
			local H = slices[#slices][2]
			local D0, D1 = dAt(0), dAt(H)
			local need = math.min(D1, 40)
			local function measure()
				o.nextRun = now + 0.3 + math.random() * 0.15
				o.run = mirRun(c, foot, dir, need)
				o.runLim, o.runOpen, o.runT = need, o.run >= need - 1e-3, now
			end
			if now >= (o.nextRun or 0) or not o.run or (o.runOpen and need > (o.runLim or 0) * 1.04 + 0.15) then
				measure()
			end
			local cap = math.min(D1, o.run, 40)
			if o.on and cap - D0 < 0.1 and now - (o.runT or 0) > 0.08 then
				measure()
				cap = math.min(D1, o.run, 40)
			end
			if cap - D0 < (o.on and 0.1 or 0.2) then
				return false
			end
			local dm = df - (D0 + cap) * 0.5
			local cosV = hc / math.sqrt(hc * hc + dm * dm)
			local f0, r = matResp(c.mat, 1)
			local F = f0 + (math.max(1 - r, f0) - f0) * (1 - cosV) ^ 5
			local a = math.clamp(F * (1 - r) ^ 1.2 * 1.7 * PB.refl / 100, 0, 0.6) * PB.master * o.alpha
			if a < (o.on and 0.002 or 0.006) then
				return false
			end
			local ak = math.max(math.floor(a * 100 + 0.5), 1)
			local sharp = (PB.mirClarity / 100) * (1 - r)
			local blur = 1 - sharp
			local kMid = 0.35 + 0.55 * sharp
			local kEnd = 0.04 + 0.6 * sharp ^ 1.3
			local span = math.max(D1 - D0, 0.01)
			local function uOf(d)
				return math.clamp((d - D0) / span, 0, 1)
			end
			local function fadeAt(u)
				if u <= 0.4 then
					return lerp(1, kMid, u / 0.4)
				end
				return lerp(kMid, kEnd, (u - 0.4) / 0.6)
			end
			local env = PB.env
			local lit = PB.ambK
			if env.src == 'sun' and env.I > 0.02 then
				local sd = V3(env.dir.X, 0, env.dir.Z)
				if sd.Magnitude > 0.05 then
					lit = lit + 0.7 * env.I * math.max(dir:Dot(sd.Unit), 0)
				end
			end
			lit = math.clamp(lit, 0.15, 1.15)
			local ck = math.floor(lit * 40 + 0.5)
			local sk = math.floor(sharp * 20 + 0.5)
			local rip = 0
			if PB.wet > 0.2 then
				rip = 0.07 * math.clamp((dZ and tonumber(dZ.stormK)) or 0, 0, 1)
			end
			local function jit(k)
				if rip <= 0 then
					return 0
				end
				return rip * 1.2 * math.noise(now * 4.3, o.seed, k * 1.7)
			end
			local shown = 0
			for k, s in ipairs(slices) do
				local seg = mirSeg(o, k)
				local d0, dFull = dAt(s[1]), dAt(s[2])
				local d1 = math.min(dFull, cap)
				if d1 - d0 > (seg.on and 0.02 or 0.08) then
					shown = k
					local tf = (dFull - d0 > 0.01) and (d1 - d0) / (dFull - d0) or 1
					local w0 = s[3] * (1 - d0 / df)
					local w1 = (s[3] + (s[4] - s[3]) * tf) * (1 - d1 / df)
					local u0, u1 = uOf(d0), uOf(d1)
					o.att[k].CFrame = CFrame.fromMatrix(foot + dir * d0 + perp * jit(k) + UP * MIR_LIFT, UP, perp)
					o.att[k + 1].CFrame = CFrame.fromMatrix(foot + dir * d1 + perp * jit(k + 1) + UP * MIR_LIFT, UP, perp)
					local wr = 1 + rip * 1.5 * math.noise(now * 5.1, o.seed + 3, k)
					local sw0, sw1 = 1 + (0.12 + 0.55 * u0) * blur, 1 + (0.12 + 0.55 * u1) * blur
					seg.core.Width0, seg.core.Width1 = w0 * 0.62 * wr, w1 * 0.62 * wr
					seg.soft.Width0, seg.soft.Width1 = w0 * sw0 * wr, w1 * sw1 * wr
					local tk = ((ak * 21 + sk) * 21 + math.floor(u0 * 20 + 0.5)) * 21 + math.floor(u1 * 20 + 0.5)
					if tk ~= seg.tk then
