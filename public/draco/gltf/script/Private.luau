								e.Enabled = false
								DOFS.list[#DOFS.list + 1] = e
							end
						end
					end)
				end
			elseif not on and DOFS.claimed then
				DOFS.claimed = false
				for _k, e in ipairs(DOFS.list) do
					pcall(function ()
						if e.Parent then
							e.Enabled = true
						end
					end)
				end
				DOFS.list = {}
			end
		end
		CS.dofClaim = dofClaim
		local MUF = {on = false, orig = nil}
