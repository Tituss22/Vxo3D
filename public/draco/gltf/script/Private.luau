			ui.ltInfo = txt({BackgroundTransparency = 1, Position = U2(0, 14, 0, 44), Size = U2(1, -20, 0, 12), Font = Enum.Font.Code, TextSize = 10, TextColor3 = C3(185, 185, 190), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = '', Parent = lt}, 'mono500')
			ui.ltHp = aY('Frame', {AnchorPoint = V2(0, 1), Position = U2(0, 14, 1, -3), Size = U2(0, 120, 0, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, BorderSizePixel = 0, Parent = lt})
			ui.ltHpFill = aY('Frame', {Size = U2(1, 0, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.1, BorderSizePixel = 0, Parent = ui.ltHp})
