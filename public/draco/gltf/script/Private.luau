			windLoop(wind, windPitch)
			CH.rest = abs(CH.speedK) + abs(CH.speedV) + abs(CH.flyK) + abs(CH.flyV) + abs(CH.inK) + abs(CH.inV) < 2e-3 and abs(CH.roll) + abs(CH.rollV) + abs(CH.pitch) + abs(CH.pitchV) < 2e-4 and CH.lag.Magnitude + CH.lagV.Magnitude < 2e-3 and CH.beatK == 0
		end
		function CS.cheatIdle()
			return CH.rest and not (P.speed or P.flight or P.downwash or P.phase or P.climb or P.ripples or P.mist or P.lowHp)
		end
		function CS.onState(old, new)
			local S = Enum.HumanoidStateType
			if new == S.Jumping then
				if old == S.Freefall or old == S.Jumping or not ME.grounded then
					CS.airJump()
				else
					ME.jumpWatch = {t = 0, peak = 0}
				end
			end
		end
		function CS.airJump(preview)
			local root = ME.root
			if not root or (not preview and not (P.on and P.airJump)) then
				return
			end
			local now = os.clock()
			if now - CH.airJumpT < 0.1 then
				return
			end
			CH.airJumpT = now
			local feet = feetOf(root, ME.hum)
			burst(feet, {kind = 'mist', n = 12, color = MIST, ring = 1.2, size = {0.8, 3.4}, life = {0.35, 0.65}, speed = {6, 11}, trans = {0.8, 1}, drag = 6, accel = ZERO, spread = V2(6, 6), lit = 0.5})
			burst(feet, {kind = 'mist', n = 6, color = MIST, cf = aimCF(feet, -UP), size = {0.6, 2.4}, life = {0.3, 0.55}, speed = {3, 7}, trans = {0.82, 1}, drag = 5, accel = ZERO, spread = V2(25, 25), lit = 0.5})
			sfx('puff', 0.45, rnd(0.92, 1.08))
			kickCam(-0.7, 0, 0, 0, 2.5)
		end
		function CS.onSuperJump(vy)
			local root = ME.root
			if not root or not (P.on and P.bigJump) then
				return
			end
			local k = clamp((vy - 72) / 120, 0, 1)
			local g = groundAt(root.Position, V3(0, -9, 0))
			if g and g.water then
				splash(g.pos, 0.5 + 0.5 * k)
			elseif g and g.dust > 0 then
				dustRing(g, 0.4 + 0.6 * k)
			end
			sfx('whoosh', 0.55, 0.75)
			sfx('puff', 0.6, 0.7)
			kickCam(1, 0, 0, -0.35, 2 + 5 * k)
			addTrauma(0.12 + 0.15 * k)
		end
		function CS.onLanded(speed)
			if not (P.on and P.bigJump) or speed < 80 or not ME.alive then
				return
			end
			local k = clamp((speed - 80) / 120, 0, 1)
			local cv = GENV and GENV.JH_CVFX
			local cvOn = type(cv) == 'table' and cv.on
			if not (cvOn and cv.shake) then
				kickCam(-1.6 * (0.4 + k), 0, rnd(-0.6, 0.6), -0.5 * (0.4 + k), 0)
				addTrauma(0.2 + 0.35 * k)
			end
			if not (cvOn and cv.jump) and ME.root then
				local g = groundAt(ME.root.Position, V3(0, -9, 0))
				if g and g.water then
					splash(g.pos, 0.6 + 0.4 * k)
				elseif g and g.dust > 0 then
					dustRing(g, 0.5 + 0.5 * k, 3)
				end
			end
			sfx((k > 0.25) and 'impact' or 'thump', 0.45 + 0.5 * k, 1)
		end
		function CS.hitFx(k)
			addTrauma(0.22 + 0.35 * k)
			kickCam(rnd(-1, 1) * (0.8 + 1.6 * k), rnd(-1, 1) * (0.8 + 1.6 * k), rnd(-1, 1) * 1.2 * k, 0, 0)
			addFx(0.65, function (self, u)
				local fo = (1 - u) ^ 2
				OUT.blur = OUT.blur + 7 * k * fo
				OUT.sat = OUT.sat - 0.4 * k * (1 - u)
				OUT.contrast = OUT.contrast + 0.06 * k * fo
				OUT.bright = OUT.bright - 0.05 * k * fo
				addVig(0.38 * k * (1 - u))
			end)
			if k > 0.4 then
				sfx('thump', 0.25 + 0.3 * k, 1.15)
			end
		end
		function CS.onHealth(was, h)
			if not (P.on and P.hit) or not ME.alive or CS.spec.active then
				return
			end
			local frac = (was - h) / max(ME.maxHp, 1)
			if frac < 0.01 or h <= 0 then
				return
			end
			CS.hitFx(clamp(frac * 3, 0.08, 1))
		end
	end

	local unbind
	do
		local bound = false
		local errs = 0
		local function frame(dt, rawDt, now, c)
			resetOut()
			local alive = meStep(dt, rawDt)
			ME.alive = alive and ME.hum.Health > 0 and not ME.dead
			specStep(dt, now, c)
			namesStep(dt, CS.spec)
			if alive and P.on and not CS.spec.active and not CS.cheatIdle() then
				cheatStep(dt, now, c)
			else
				windLoop(0, 1)
			end
			deathStep(dt)
			fxStep(dt)
			wfxStep(dt)
			rigStep(c, dt, now)
			applyOut(dt)
		end
		local function active()
			return P.on or RIG.ovr ~= nil or fxBusy() or CS.death ~= nil or RIG.trauma > 0.003 or CS.specPreview or os.clock() < (CS.previewUntil or 0)
		end
		local function postFn(rawDt)
			if not y() then
				CS.teardown()
				return
			end
			local c = cam()
			if c then
				local ok, err = pcall(frame, clamp(rawDt, 1 / 240, 0.1), rawDt, os.clock(), c)
				if not ok then
					errs = errs + 1
					if errs <= 3 then
						warn('[JEYHUB] Cutscene FX:', err)
					end
				end
			end
			if not active() then
				unbind()
			end
		end
		function unbind()
			if not bound then
				return
			end
			bound = false
			for _k, n in ipairs({'JH_CamFXPre', 'JH_CamFX', 'JH_CamFXLast'}) do
				pcall(function ()
					G:UnbindFromRenderStep(n)
				end)
			end
			rigRestore()
			setOverride(nil)
			RIG.filter = nil
			for _k, s in ipairs({RIG.kp, RIG.ky, RIG.kr, RIG.kz, RIG.kf}) do
				s.x, s.v = 0, 0
			end
			resetOut()
			CS.ov.lt, CS.ov.vf = 0, 0
			namesRestore()
			pcall(applyOut, 1)
			windLoop(0, 1)
		end
		function CS.wake()
			if bound or CS.tornDown then
				return
			end
			bound = true
			pcall(function ()
				G:BindToRenderStep('JH_CamFXPre', Enum.RenderPriority.First.Value + 1, rigRestore)
				G:BindToRenderStep('JH_CamFX', Enum.RenderPriority.Camera.Value + 2, postFn)
				G:BindToRenderStep('JH_CamFXLast', Enum.RenderPriority.Last.Value + 50, rigLate)
			end)
		end
		function CS.setOn(on)
			P.on = on and true or false
			save()
			if P.on then
				AS.build()
				CS.wake()
			end
			pcall(function ()
				local m = getgenv().JH_MQ
				if type(m) == 'table' and m.use then
					m.use('cutscenefx', P.on)
				end
			end)
		end
		local hooks = {}
		function hooks.beginTeleport()
			if P.on and P.tp and not CS.tornDown then
				CS.tpPending = {t = os.clock(), kind = 'hub'}
				CS.wake()
			end
		end
		function hooks.recall()
			if P.on and P.tp and not CS.tornDown then
				CS.tpPending = {t = os.clock(), kind = 'recall'}
				CS.wake()
			end
		end
		function hooks.save(cf, slot)
			if P.on and not CS.tornDown then
				CS.wake()
				pcall(CS.snapshot, slot)
			end
		end
		CS.hooks = hooks
		pcall(function ()
			getgenv().JH_MVFX = hooks
		end)
		local function previewSpectate()
			local c = cam()
			local mine = ME.char and ME.char:FindFirstChildOfClass('Humanoid')
			if not (c and mine) or c.CameraSubject ~= mine then
				return
			end
			local best, bd = nil, math.huge
			for _k, plr in ipairs(D:GetPlayers()) do
				local ch = plr ~= LP and plr.Character
				local h = ch and ch:FindFirstChildOfClass('Humanoid')
				local r = ch and ch:FindFirstChild('HumanoidRootPart')
				if h and r and h.Health > 0 then
					local d = ME.root and (r.Position - ME.root.Position).Magnitude or 0
					if d < bd then
						best, bd = h, d
					end
				end
			end
			if not best then
				toast('Cutscene FX', 'Nobody else is here to spectate', 2.5, 'off')
				return
			end
			CS.specPreview = true
			c.CameraSubject = best
			task.delay(4.5, function ()
				local c2 = cam()
				local m2 = ME.char and ME.char:FindFirstChildOfClass('Humanoid')
				if c2 and m2 and c2.CameraSubject == best then
					c2.CameraSubject = m2
				end
				task.delay(1.4, function ()
					CS.specPreview = false
				end)
			end)
		end
		function CS.preview(kind)
			if CS.tornDown then
				return
			end
			AS.build()
			CS.previewUntil = os.clock() + 6
			CS.wake()
			local c = cam()
			if not c then
				return
			end
			if kind == 'Teleport' then
				local base = RIG.lastFinal or c.CFrame
				local to = (ME.root and ME.root.Position) or (base.Position + base.LookVector * 12)
				local from = (base * CFrame.new(rnd(-30, 30), 35, 70)).Position
				CS.onTeleport(from, to, 'preview', lookAt(from, to))
			elseif kind == 'Death' then
				CS.onDied(true)
			elseif kind == 'Respawn' then
				CS.onRespawn(ME.char, true)
			elseif kind == 'Spectate' then
				previewSpectate()
			elseif kind == 'Hit' then
				CS.hitFx(0.65)
			elseif kind == 'Snapshot' then
				CS.snapshot(nil, true)
			end
		end
		if P.on then
			task.defer(function ()
				if not CS.tornDown and y() then
					CS.setOn(true)
				end
			end)
		end
	end

	function CS.teardown()
		if CS.tornDown then
			return
		end
		CS.tornDown = true
		pcall(unbind)
		pcall(namesRestore)
		pcall(CS.meDisconnect)
		pcall(CS.windOff)
		pcall(CS.muffle, false)
		pcall(CS.dofClaim, false)
		for _k, k in ipairs({'cc', 'blur', 'dof'}) do
			local o = CS.fxInst[k]
			if o then
				pcall(function ()
					o:Destroy()
				end)
			end
		end
		if UI and UI.gui then
			pcall(function ()
				UI.gui:Destroy()
			end)
		end
		pcall(wfxClear)
		pcall(function ()
			local g = getgenv()
			if g.JH_MVFX == CS.hooks then
				g.JH_MVFX = nil
			end
		end)
	end
	pcall(function ()
		local g = getgenv()
		local old = g.JH_CutsceneTeardown
		if type(old) == 'function' and old ~= CS.teardown then
			pcall(old)
		end
		g.JH_CutsceneTeardown = CS.teardown
	end)
	pcall(l, CS.teardown)

