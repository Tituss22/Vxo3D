							if tgt > 0 then
								s.pk = peak
								local sx, sz = 2 * (r1 + pen), 2 * (r2 + pen)
								if em(sx - s.sx) > 0.02 * s.sx + 0.004 or em(sz - s.sz) > 0.02 * s.sz + 0.004 then
									s.sx, s.sz = sx, sz
									s.plate.Size = ep(ef.max(sx, 0.02), 0.02, ef.max(sz, 0.02))
								end
