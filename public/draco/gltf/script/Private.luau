				if gg.beam then
					SB.prep(gg)
				else
					aoRings(gg)
				end
			end
			return out
		end
		VF.LEAFY = {'tree', 'pohon', 'daun', 'palm', 'pine', 'oak', 'birch', 'willow', 'maple', 'leaf', 'leaves', 'foliage', 'canopy', 'bush', 'shrub', 'semak', 'hedge'}
