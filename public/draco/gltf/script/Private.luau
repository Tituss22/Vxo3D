				local cy = tostring(cx.AssetId or 0)
				if cy ~= '0' then
					local cz = cx.Position
					local cA = cx.Scale
					local cB = cx.Rotation
					local cC = cz and cz.Magnitude > 0.0001
					local cD = cA and (math.abs(cA.X - 1) > 0.0001 or math.abs(cA.Y - 1) > 0.0001 or math.abs(cA.Z - 1) > 0.0001)
					local cE = cB and cB.Magnitude > 0.0001
					if cC or cD or cE then
						local cF = type(cv[cy]) == 'table' and cv[cy] or {}
						if cC then
							cF.Position = cj.vectorForSave(cz)
						end
						if cD then
							cF.Scale = cj.vectorForSave(cA, Vector3.one)
						end
						if cE then
							cF.Rotation = cj.vectorForSave(cB)
						end
						cv[cy] = cF
					end
				end
			end
		end)
		return cv
	end
