									bn = bn + 1
									bp[bn], bc[bn] = s.plate, CFrame.fromMatrix(pos, u, N)
								end
							end
							local a = s.alpha * (s.pk or 0)
							if tgt == 0 and s.alpha < 0.02 then
								WLS.hide(s)
								s.alpha, s.cfp = 0, nil
								sl[i] = nil
								WLS.pool[#WLS.pool + 1] = s
								WLS.n = WLS.n - 1
							else
								WLS.paint(s, a)
								if not s.on then
									s.on = true
									s.sg.Enabled = true
								end
								any = true
								count = count + 1
							end
						end
					end
					if not any then
						o.wlsSlots = nil
					elseif WLS.GEN[o.wlsK] then
						o.shadowLive = now + 0.5
					end
				end
			end
			ev.bn = bn
			WLS.stat = count
		end
		local function fD()
			return fm.on or fx.on or eX.on or (WLS.on and WLS.ext == true)
