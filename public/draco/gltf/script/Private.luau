					local cB = cj.parseAssetId(cA.AssetId)
					local cC = Enum.MakeupType[tostring(cA.MakeupType)]
					if cB and cC then
						local cD = Instance.new('MakeupDescription')
						cD.AssetId = cB
						cD.Order = tonumber(cA.Order) or 1
						cD.MakeupType = cC
						cD.Parent = cu
					end
				end)
			end
		end
		local cz = ct.AccessoryRefinements or {}
		if ct.AllAccessories and type(ct.AllAccessories) == 'table' then
			local cA = {}
			for cB, cC in ipairs(ct.AllAccessories) do
				if type(cC) == 'table' and cC.AssetId and cC.AccessoryType then
					local cD = cj.parseAssetId(cC.AssetId)
					local cE = Enum.AccessoryType[cC.AccessoryType]
					if cD and cE then
						local cF = {AssetId = cD, AccessoryType = cE}
						local cG = cz[tostring(cD)] or cC
						if cG then
							if cG.Position then
								cF.Position = cj.vector3FromSaved(cG.Position, Vector3.zero)
							end
							if cG.Rotation then
								cF.Rotation = cj.vector3FromSaved(cG.Rotation, Vector3.zero)
							end
							if cG.Scale then
								cF.Scale = cj.vector3FromSaved(cG.Scale, Vector3.one)
							end
						end
						if cC.IsLayered then
							cF.IsLayered = true
							cF.Order = tonumber(cC.Order) or 0
							if cC.Puffiness ~= nil then
								cF.Puffiness = tonumber(cC.Puffiness) or 0
							end
						end
						table.insert(cA, cF)
					end
				end
			end
			pcall(function ()
